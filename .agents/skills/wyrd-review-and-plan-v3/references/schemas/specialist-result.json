{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wyrd v3 specialist review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "domain",
    "reviewer_id",
    "target_sha",
    "prompt_sha256",
    "status",
    "candidate_ids",
    "report_markdown",
    "static_limits"
  ],
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "target_sha": {"type": "string", "minLength": 7},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "const": "completed"},
    "candidate_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/C[0-9]{3}$"}
    },
    "report_markdown": {"type": "string", "minLength": 1},
    "static_limits": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
