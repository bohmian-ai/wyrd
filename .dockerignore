target/
**/target/
.git/
node_modules/
**/node_modules/
*.pem
**/*.pem

# Local SDK environments and native builds; no image copies them except the UI's SDK addon.
.venv/
**/.venv/
**/*.so
**/*.node
# The UI BFF installs the staged @wyrd/sdk platform addon (`mise run ui:sdk`).
!sdks/wyrd-sdk-ts/wyrd-linux-x64-gnu/wyrd.linux-x64-gnu.node

# Local secrets and credentials
.env
.env.*
**/.env
**/.env.*
*.key
**/*.key
credentials/
**/credentials/

# Local caches, logs, and review artifacts
.dev/
**/.dev/
.cache/
**/.cache/
*.log
**/*.log
!crates/wyrd/wyrd-enterprise/keys/license-pub.pem
