+ */
+function responsesTurn(body: string): unknown {
+  const answered = (JSON.parse(body) as { input: { type?: string }[] }).input.some(
+    (item) => item.type === "function_call_output",
+  );
+  return answered
+    ? response([
+        {
+          type: "message",
+          id: "msg_1",
+          role: "assistant",
+          status: "completed",
+          content: [{ type: "output_text", text: "echoed", annotations: [] }],
+        },
+      ])
+    : response([
+        {
+          type: "function_call",
+          id: "fc_1",
+          call_id: "c1",
+          name: "echo",
+          arguments: '{"text":"hi"}',
+          status: "completed",
+        },
+      ]);
+}
