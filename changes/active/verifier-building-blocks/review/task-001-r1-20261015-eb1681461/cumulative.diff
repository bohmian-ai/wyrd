@@ -0,0 +1,256 @@
+//! Locked `extract` action output contract.
+//!
+//! Every extractable [`MediaFormat`] produces exactly one format-discriminated
+//! JSON document. Every field is always present: unavailable values are
+//! `null` only where the type allows it, empty collections are `[]`, and
+//! empty text is `""`. Counts come from array lengths. Extraction is text and
+//! structure, never a claim of visual or layout fidelity.
+
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use skald_spec::MediaFormat;
+
+/// The output of one `extract` action, discriminated by `format`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "format", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ExtractOutput {
+    /// PDF text by page.
+    Pdf {
+        /// Pages in document order.
+        pages: Vec<PdfPage>,
+    },
+    /// PowerPoint text and tables by slide.
+    Pptx {
+        /// Slides in presentation order.
+        slides: Vec<PptxSlide>,
+    },
+    /// Word paragraphs and tables in document order.
+    Docx {
+        /// Blocks in document order.
+        blocks: Vec<DocxBlock>,
+    },
+    /// Excel cells by sheet.
+    Xlsx {
+        /// Sheets in workbook order.
+        sheets: Vec<XlsxSheet>,
+    },
+    /// Every CSV row, including the first; no header or type inference.
+    Csv {
+        /// Rows of cell text.
+        rows: Vec<Vec<String>>,
+    },
+    /// The parsed JSON value.
+    Json {
+        /// Parsed document.
+        value: Value,
+    },
+    /// Plain text source.
+    Text {
+        /// Source text.
+        text: String,
+    },
+    /// Markdown source text; structure is not parsed.
+    Markdown {
+        /// Source text.
+        text: String,
+    },
+    /// HTML source text; structure is not parsed.
+    Html {
+        /// Source text.
+        text: String,
+    },
+}
+
+/// One PDF page.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct PdfPage {
+    /// One-based page number.
+    pub number: u32,
+    /// Extracted page text.
+    pub text: String,
+}
+
+/// One PowerPoint slide.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct PptxSlide {
+    /// One-based slide number in presentation order.
+    pub number: u32,
+    /// Title placeholder text, or `null` when the slide has none.
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(required)]
+    pub title: Option<String>,
+    /// Body paragraphs in reading order.
+    pub paragraphs: Vec<String>,
+    /// Tables on the slide.
+    pub tables: Vec<Table>,
+    /// Speaker notes, or `""` when absent.
+    pub notes: String,
+}
+
+/// One extracted table. A merged cell holds its top-left value and every
+/// covered position holds `""`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Table {
+    /// Rows of cell text.
+    pub rows: Vec<Vec<String>>,
+}
+
+/// One Word document block.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum DocxBlock {
+    /// A paragraph.
+    Paragraph {
+        /// Paragraph text.
+        text: String,
+        /// Stored paragraph style ID, or `null` when unstyled.
+        #[serde(deserialize_with = "Option::deserialize")]
+        #[schemars(required)]
+        style: Option<String>,
+    },
+    /// A table. Merged cells follow the [`Table`] rule.
+    Table {
+        /// Rows of cell text.
+        rows: Vec<Vec<String>>,
+    },
+}
+
+/// One Excel worksheet.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct XlsxSheet {
+    /// Sheet name.
+    pub name: String,
+    /// Present cells in row, then column, order. Absent cells are omitted.
+    pub cells: Vec<XlsxCell>,
+}
+
+/// One present Excel cell.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct XlsxCell {
+    /// Worksheet address such as `B2`, not an offset into `cells`.
+    pub address: String,
+    /// Stored value or cached formula result; formulas are never
+    /// recalculated, dates stay Excel serial numbers, and error cells are
+    /// `null`.
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(required)]
+    pub value: Option<CellValue>,
+    /// Formula text, or `null` for a literal cell.
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(required)]
+    pub formula: Option<String>,
+    /// Error text such as `#DIV/0!`, or `null` when the cell holds no error.
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(required)]
+    pub error: Option<String>,
+}
+
+/// A non-null Excel cell value.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(untagged)]
+pub enum CellValue {
+    /// Text value.
+    String(String),
+    /// Numeric value, including serial dates.
+    Number(serde_json::Number),
+    /// Boolean value.
+    Boolean(bool),
+}
+
+impl ExtractOutput {
+    /// Returns the JSON Schema of the outputs `extract` can produce for
+    /// `formats`: the `oneOf` branches whose `format` discriminant is one of
+    /// the given extractable formats. Non-extractable formats contribute no
+    /// branch.
+    #[must_use]
+    pub fn schema_for(formats: &[MediaFormat]) -> Value {
+        let mut schema = serde_json::to_value(schemars::schema_for!(Self)).unwrap_or(Value::Null);
+        if let Some(Value::Array(branches)) = schema.get_mut("oneOf") {
+            branches.retain(|branch| {
+                branch
+                    .pointer("/properties/format/enum/0")
+                    .and_then(Value::as_str)
+                    .is_some_and(|tag| formats.iter().any(|format| format.as_str() == tag))
+            });
+        }
+        schema
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Canonical extraction output examples, schema selection, and refusals.
+
+    use serde_json::json;
+
+    use super::*;
+
+    /// The locked DOCX and XLSX examples deserialize and serialize unchanged.
+    ///
+    /// # Panics
+    /// Panics when a locked example does not round-trip exactly.
+    #[test]
+    fn extract_output_round_trips_locked_examples() {
+        for example in [
+            json!({"format":"pdf","pages":[{"number":1,"text":"Refunds"}]}),
+            json!({"format":"pptx","slides":[{"number":1,"title":null,"paragraphs":["a"],"tables":[{"rows":[["x",""]]}],"notes":""}]}),
+            json!({"format":"docx","blocks":[{"kind":"paragraph","text":"Refund policy","style":"Heading1"},{"kind":"table","rows":[["Window","Days"],["Standard","30"]]}]}),
+            json!({"format":"xlsx","sheets":[{"name":"Refunds","cells":[{"address":"A1","value":"Days","formula":null,"error":null},{"address":"B2","value":30,"formula":null,"error":null},{"address":"C3","value":null,"formula":"=1/0","error":"#DIV/0!"},{"address":"D4","value":true,"formula":null,"error":null}]}]}),
+            json!({"format":"csv","rows":[["a","b"],["1","2"]]}),
+            json!({"format":"json","value":{"nested":[1,null]}}),
+            json!({"format":"text","text":""}),
+            json!({"format":"markdown","text":"# Title"}),
+            json!({"format":"html","text":"<p>x</p>"}),
+        ] {
+            let output: ExtractOutput =
+                serde_json::from_value(example.clone()).expect("locked example");
+            assert_eq!(serde_json::to_value(&output).expect("serialize"), example);
+        }
+    }
+
+    /// Every field is required and no extra count field is accepted.
+    ///
+    /// # Panics
+    /// Panics when an incomplete or extended output is accepted.
+    #[test]
+    fn extract_output_refuses_missing_and_extra_fields() {
+        for invalid in [
+            json!({"format":"pdf","pages":[],"page_count":0}),
+            json!({"format":"pptx","slides":[{"number":1,"paragraphs":[],"tables":[],"notes":""}]}),
+            json!({"format":"docx","blocks":[{"kind":"paragraph","text":"x"}]}),
+            json!({"format":"xlsx","sheets":[{"name":"s","cells":[{"address":"A1","value":1}]}]}),
+            json!({"format":"doc","blocks":[]}),
+        ] {
+            assert!(
+                serde_json::from_value::<ExtractOutput>(invalid.clone()).is_err(),
+                "{invalid}"
+            );
+        }
+    }
+
+    /// The per-format schema keeps only the requested extractable branches.
+    ///
+    /// # Panics
+    /// Panics when the schema keeps the wrong branches.
+    #[test]
+    fn extract_output_schema_selects_formats() {
+        let schema = ExtractOutput::schema_for(&[MediaFormat::Pptx, MediaFormat::Png]);
+        let branches = schema["oneOf"].as_array().expect("oneOf");
+        assert_eq!(branches.len(), 1);
+        assert_eq!(branches[0]["properties"]["format"]["enum"], json!(["pptx"]));
+        assert_eq!(branches[0]["additionalProperties"], json!(false));
+        let slide = &schema["definitions"]["PptxSlide"];
+        assert!(
+            slide["required"]
+                .as_array()
+                .expect("required")
+                .contains(&json!("title"))
+        );
+    }
+}
diff --git a/crates/wyrd-spec/src/card/blocks/mod.rs b/crates/wyrd-spec/src/card/blocks/mod.rs
new file mode 100644
index 000000000..1566a3005
--- /dev/null
+++ b/crates/wyrd-spec/src/card/blocks/mod.rs
@@ -0,0 +1,428 @@
+//! Verifier building blocks: named inputs, optional preparation steps,
+//! requirements, and one decision rule.
+//!
+//! A [`VerifierSpec`] declares the evidence it needs as named input slots,
+//! optionally prepares that evidence with `extract`, `agent`, or `code`
+//! steps, and judges each declared requirement with one check. Step and
+//! requirement IDs share one namespace across the whole Verifier and are
+//! used unchanged in references, results, route overrides, and fitted drift
+//! state. These values are declarative: resolution, execution, and storage
+//! belong to their runtime owners.
+
+use std::collections::BTreeMap;
+
+use schemars::JsonSchema;
+use serde::de::Error as _;
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+use serde_json::Value;
+use skald_spec::MediaFormat;
+
+use crate::card::agent::AgentSpec;
+use crate::card::drift::DriftSpec;
+use crate::card::prompt::ParameterName;
+use crate::ids::FeatureName;
+use crate::reference::{InlineableRef, Ref};
+use crate::vala::eval::result::EvalContextCapture;
+use crate::vala::eval::{ComparisonOperator, JsonPath, TaskId};
+
+pub mod extract;
+pub mod reference;
+mod schema_path;
+mod validate;
+
+pub use reference::{PathSegment, Reference, ReferenceError, ReferenceRoot, VerdictField};
+pub use validate::ResolvedAgent;
+
+/// Most retries one step may declare after its first attempt.
+pub const MAX_STEP_RETRIES: u32 = 5;
+
+/// A subject-less Verifier: inputs, optional steps, requirements, decision.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct VerifierSpec {
+    /// Optional human-readable purpose.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub description: Option<String>,
+    /// Named evidence slots, addressed as `inputs.<slot>`.
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub inputs: BTreeMap<crate::ids::SlotName, InputSlot>,
+    /// Preparation steps; independent steps may run concurrently.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub steps: Vec<Step>,
+    /// Whole-Verifier requirements, judged after every step finishes.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub requirements: Vec<Requirement>,
+    /// How requirement outcomes combine into the verdict.
+    #[serde(default, skip_serializing_if = "Decide::is_all")]
+    pub decide: Decide,
+    /// How permitted `actual` values are stored; absent means full capture.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub context_capture: Option<EvalContextCapture>,
+}
+
+/// One named evidence slot. Slots are required unless `required: false`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum InputSlot {
+    /// A JSON value, optionally constrained by JSON Schema.
+    Json {
+        /// JSON Schema the value must satisfy.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        schema: Option<Value>,
+        /// Whether a caller must supply the slot.
+        #[serde(default = "required_default", skip_serializing_if = "is_true")]
+        required: bool,
+    },
+    /// A pinned file in one of the accepted formats.
+    Media {
+        /// Accepted formats.
+        formats: Vec<MediaFormat>,
+        /// Lower size bound than the deployment limit.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        max_bytes: Option<u64>,
+        /// Whether a caller must supply the slot.
+        #[serde(default = "required_default", skip_serializing_if = "is_true")]
+        required: bool,
+    },
+    /// A trace resolved through tenant-scoped trace reads.
+    Trace {
+        /// Whether a caller must supply the slot.
+        #[serde(default = "required_default", skip_serializing_if = "is_true")]
+        required: bool,
+    },
+    /// Feature measurements or metric samples recorded for a scheduled window.
+    Samples {
+        /// Measurement names, including metric names.
+        features: Vec<FeatureName>,
+        /// Whether the schedule binding must fill the slot.
+        #[serde(default = "required_default", skip_serializing_if = "is_true")]
+        required: bool,
+    },
+}
+
+impl InputSlot {
+    /// Returns whether a value must be supplied for this slot.
+    #[must_use]
+    pub fn required(&self) -> bool {
+        match self {
+            Self::Json { required, .. }
+            | Self::Media { required, .. }
+            | Self::Trace { required }
+            | Self::Samples { required, .. } => *required,
+        }
+    }
+}
+
+/// Serde default making slots required unless declared otherwise.
+fn required_default() -> bool {
+    true
+}
+
+/// Serde skip predicate omitting the default `required: true`.
+#[expect(
+    clippy::trivially_copy_pass_by_ref,
+    reason = "serde skip_serializing_if passes the field by reference"
+)]
+fn is_true(value: &bool) -> bool {
+    *value
+}
+
+/// One preparation step: an action plus the requirements judged on it.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Step {
+    /// Verifier-unique block ID.
+    pub id: TaskId,
+    /// The data-producing action.
+    pub action: Action,
+    /// Ordering-only dependencies beyond those implied by references.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub depends_on: Vec<TaskId>,
+    /// Gate: the step runs only when the condition holds; otherwise its
+    /// requirements are not applicable.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub when: Option<Condition>,
+    /// Requirements judged after the action, before dependents start.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub requirements: Vec<Requirement>,
+    /// Per-attempt timeout in seconds.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub timeout_seconds: Option<u32>,
+    /// Retries after the first failed attempt, at most [`MAX_STEP_RETRIES`].
+    #[serde(default, skip_serializing_if = "is_zero")]
+    pub retries: u32,
+}
+
+/// Serde skip predicate omitting zero retries.
+#[expect(
+    clippy::trivially_copy_pass_by_ref,
+    reason = "serde skip_serializing_if passes the field by reference"
+)]
+fn is_zero(value: &u32) -> bool {
+    *value == 0
+}
+
+/// A data-producing step action. Actions read and compute only.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Action {
+    /// Extract text and structure from one media slot.
+    Extract {
+        /// The media slot, as `inputs.<slot>`.
+        from: Reference,
+    },
+    /// Invoke an Agent; its output follows the Prompt's response schema.
+    Agent(AgentCall),
+    /// Run sandboxed code returning JSON data.
+    Code(CodeCall),
+}
+
+/// One Agent invocation in a step or check position.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct AgentCall {
+    /// The Agent, inline, file-authored, or registered.
+    pub agent: InlineableRef<AgentSpec>,
+    /// Injected values keyed by the Prompt's text and media placeholders.
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub inputs: BTreeMap<ParameterName, Reference>,
+    /// Files under `/inputs/...` for the Agent's tools; step position only.
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub workspace: BTreeMap<String, Reference>,
+}
+
+/// One sandboxed code invocation in a step or check position.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CodeCall {
+    /// Execution runtime.
+    #[serde(default, skip_serializing_if = "CodeRuntime::is_default")]
+    pub runtime: CodeRuntime,
+    /// Immutable source.
+    pub source: CodeSource,
+    /// Function called with the bound inputs as keyword arguments.
+    pub entrypoint: String,
+    /// Values passed to the entrypoint.
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub inputs: BTreeMap<ParameterName, Reference>,
+}
+
+/// A code execution runtime.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum CodeRuntime {
+    /// Sandboxed Python; the only supported runtime.
+    #[default]
+    Python,
+}
+
+impl CodeRuntime {
+    /// Serde skip predicate omitting the default runtime.
+    #[must_use]
+    pub fn is_default(&self) -> bool {
+        *self == Self::default()
+    }
+}
+
+/// Immutable code source.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case", deny_unknown_fields)]
+pub enum CodeSource {
+    /// Source text embedded in the Verifier version.
+    Inline(String),
+    /// A file inside an exact Artifact Card version.
+    Artifact {
+        /// The Artifact Card.
+        card: Ref,
+        /// File path inside the Artifact, when it holds more than one file.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        path: Option<String>,
+    },
+}
+
+/// One declared requirement, producing exactly one verdict.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Requirement {
+    /// Verifier-unique block ID.
+    pub id: TaskId,
+    /// The claim the check judges, readable as `requirement.statement`.
+    pub statement: String,
+    /// The verdict-producing check.
+    pub check: Check,
+}
+
+/// A verdict-producing requirement check.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Check {
+    /// Typed comparison over one value (`path`) or every wildcard match
+    /// (`each`); exactly one is set.
+    Assert {
+        /// One value.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        path: Option<Reference>,
+        /// Every value selected through `[*]`.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        each: Option<Reference>,
+        /// Comparison operator.
+        operator: ComparisonOperator,
+        /// Right-hand side of the comparison.
+        #[serde(default, skip_serializing_if = "Value::is_null")]
+        expected: Value,
+    },
+    /// Trace assertion over a trace slot.
+    Trace(TraceCheck),
+    /// A tool-less Agent returning the Verdict schema.
+    Agent(AgentCall),
+    /// Sandboxed code returning the Verdict schema.
+    Code(CodeCall),
+    /// Statistical drift over a samples slot.
+    Drift(DriftCheck),
+}
+
+/// The evidence mode a check needs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CheckEvidence {
+    /// Evidence supplied with one execution request.
+    Run,
+    /// Samples recorded for a scheduled window.
+    Window,
+}
+
+impl Check {
+    /// Returns the evidence mode this check kind needs.
+    #[must_use]
+    pub fn evidence(&self) -> CheckEvidence {
+        match self {
+            Self::Drift(_) => CheckEvidence::Window,
+            Self::Assert { .. } | Self::Trace(_) | Self::Agent(_) | Self::Code(_) => {
+                CheckEvidence::Run
+            }
+        }
+    }
+}
+
+/// Trace assertion over a declared trace slot.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TraceCheck {
+    /// The trace slot, as `inputs.<slot>`.
+    pub on: Reference,
+    /// JSONPath into the assembled trace document.
+    pub span_selector: JsonPath,
+    /// Comparison operator.
+    pub operator: ComparisonOperator,
+    /// Right-hand side of the comparison.
+    #[serde(default, skip_serializing_if = "Value::is_null")]
+    pub expected: Value,
+}
+
+/// Drift check: an existing [`DriftSpec`] over one samples slot.
+///
+/// The wire form flattens the drift fields beside `on`; the drift fields
+/// keep their own unknown-field refusal.
+#[derive(Debug, Clone, PartialEq, JsonSchema)]
+pub struct DriftCheck {
+    /// The samples slot, as `inputs.<slot>`.
+    pub on: Reference,
+    /// Method, signal, condition, and profile.
+    #[schemars(flatten)]
+    pub spec: DriftSpec,
+}
+
+impl Serialize for DriftCheck {
+    /// Writes the drift spec's fields with `on` beside them as its reference
+    /// text, the flattened wire form authors write.
+    ///
+    /// # Errors
+    /// Returns the serializer's error, or a custom error when the drift spec
+    /// does not serialize to JSON.
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut value = serde_json::to_value(&self.spec).map_err(serde::ser::Error::custom)?;
+        if let Value::Object(fields) = &mut value {
+            fields.insert("on".to_owned(), Value::String(self.on.to_string()));
+        }
+        value.serialize(serializer)
+    }
+}
+
+impl<'de> Deserialize<'de> for DriftCheck {
+    /// Splits the required `on` reference out of the flattened object and
+    /// decodes the remaining fields as a [`DriftSpec`], which keeps its own
+    /// unknown-field refusal.
+    ///
+    /// # Errors
+    /// Returns a missing-field error when `on` is absent, and a custom error
+    /// when `on` is not a valid reference or the remaining fields are not a
+    /// valid drift spec.
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let mut value = Value::deserialize(deserializer)?;
+        let on = value
+            .as_object_mut()
+            .and_then(|fields| fields.remove("on"))
+            .ok_or_else(|| D::Error::missing_field("on"))?;
+        Ok(Self {
+            on: Reference::deserialize(on).map_err(D::Error::custom)?,
+            spec: DriftSpec::deserialize(value).map_err(D::Error::custom)?,
+        })
+    }
+}
+
+/// Step gate comparing one referenced value.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Condition {
+    /// The compared value.
+    pub path: Reference,
+    /// Comparison operator.
+    pub operator: ComparisonOperator,
+    /// Right-hand side of the comparison.
+    #[serde(default, skip_serializing_if = "Value::is_null")]
+    pub expected: Value,
+}
+
+/// How requirement outcomes combine. Not-applicable requirements are
+/// excluded; no applicable requirement is inconclusive.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case", deny_unknown_fields)]
+pub enum Decide {
+    /// Any failure fails; otherwise any inconclusive is inconclusive.
+    #[default]
+    All,
+    /// Passed share of applicable requirements, counting inconclusive ones,
+    /// must reach `threshold` in `(0, 1]`.
+    PassRate {
+        /// Minimum passed share.
+        threshold: f64,
+    },
+}
+
+impl Decide {
+    /// Serde skip predicate omitting the default rule.
+    #[must_use]
+    pub fn is_all(&self) -> bool {
+        matches!(self, Self::All)
+    }
+}
+
+/// One scheduled-evidence source selector in a binding's `inputs` map.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case", deny_unknown_fields)]
+pub enum ScheduledInput {
+    /// Recorded feature measurements.
+    Features(Vec<FeatureName>),
+    /// One recorded metric.
+    Metric(FeatureName),
+}
+
+impl ScheduledInput {
+    /// Returns the measurement names the selector reads.
+    #[must_use]
+    pub fn names(&self) -> &[FeatureName] {
+        match self {
+            Self::Features(names) => names,
+            Self::Metric(name) => std::slice::from_ref(name),
+        }
+    }
+}
diff --git a/crates/wyrd-spec/src/card/blocks/reference.rs b/crates/wyrd-spec/src/card/blocks/reference.rs
new file mode 100644
index 000000000..63cd8090d
--- /dev/null
+++ b/crates/wyrd-spec/src/card/blocks/reference.rs
@@ -0,0 +1,415 @@
+//! Scope references used by Verifier actions, conditions, and checks.
+//!
+//! A reference names one value in the execution scope document:
+//! `inputs.<slot>`, `steps.<id>.output`, `steps.<id>.status`,
+//! `steps.<id>.requirements.<requirement>.outcome|reason`, or
+//! `requirement.id|statement`. Input and step-output roots accept dotted
+//! child fields and `[n]` array indexes; `[*]` wildcards parse here and are
+//! refused by validation everywhere except an assertion's `each`.
+
+use std::fmt;
+use std::str::FromStr;
+
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+use crate::ids::SlotName;
+use crate::vala::eval::TaskId;
+
+/// One parsed scope reference.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Reference {
+    /// The scope value the reference starts from.
+    pub root: ReferenceRoot,
+    /// Child selectors applied below an input or step-output root.
+    pub path: Vec<PathSegment>,
+}
+
+/// The scope value a [`Reference`] starts from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReferenceRoot {
+    /// `inputs.<slot>`: one declared input slot.
+    Input(SlotName),
+    /// `steps.<id>.output`: one step's action output.
+    StepOutput(TaskId),
+    /// `steps.<id>.status`: one step's final status.
+    StepStatus(TaskId),
+    /// `steps.<id>.requirements.<requirement>.<field>`: one step
+    /// requirement's verdict field.
+    StepVerdict {
+        /// Step that owns the requirement.
+        step: TaskId,
+        /// Requirement whose verdict is read.
+        requirement: TaskId,
+        /// Verdict field read.
+        field: VerdictField,
+    },
+    /// `requirement.id`: the current requirement's ID during its check.
+    RequirementId,
+    /// `requirement.statement`: the current requirement's statement during
+    /// its check.
+    RequirementStatement,
+}
+
+/// A readable field of a requirement verdict.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VerdictField {
+    /// The requirement outcome.
+    Outcome,
+    /// The requirement reason.
+    Reason,
+}
+
+/// One child selector below an input or step-output root.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PathSegment {
+    /// `.name`: an object field.
+    Field(String),
+    /// `[n]`: a zero-based array index.
+    Index(usize),
+    /// `[*]`: every array element.
+    Wildcard,
+}
+
+/// Error returned when a string is not a valid [`Reference`].
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+#[error("invalid reference `{reference}`: {reason}")]
+pub struct ReferenceError {
+    /// The rejected reference text.
+    pub reference: String,
+    /// Why the reference was rejected.
+    pub reason: &'static str,
+}
+
+impl Reference {
+    /// Returns the step this reference reads, when it reads any step value.
+    #[must_use]
+    pub fn step(&self) -> Option<&TaskId> {
+        match &self.root {
+            ReferenceRoot::StepOutput(step)
+            | ReferenceRoot::StepStatus(step)
+            | ReferenceRoot::StepVerdict { step, .. } => Some(step),
+            ReferenceRoot::Input(_)
+            | ReferenceRoot::RequirementId
+            | ReferenceRoot::RequirementStatement => None,
+        }
+    }
+
+    /// Returns the input slot this reference reads, when it reads one.
+    #[must_use]
+    pub fn slot(&self) -> Option<&SlotName> {
+        match &self.root {
+            ReferenceRoot::Input(slot) => Some(slot),
+            _ => None,
+        }
+    }
+
+    /// Returns whether any path segment is a `[*]` wildcard.
+    #[must_use]
+    pub fn has_wildcard(&self) -> bool {
+        self.path.contains(&PathSegment::Wildcard)
+    }
+
+    /// Parses a reference.
+    ///
+    /// # Errors
+    /// Returns [`ReferenceError`] for an unknown root, an invalid slot or
+    /// block ID, a malformed selector, or child selectors on a root that is
+    /// not an input or step output.
+    pub fn parse(text: &str) -> Result<Self, ReferenceError> {
+        let fail = |reason| ReferenceError {
+            reference: text.to_owned(),
+            reason,
+        };
+        let mut tokens = Tokens::new(text);
+        let head = tokens.name().ok_or_else(|| fail("expected a root name"))?;
+        let root = match head {
+            "inputs" => {
+                let slot = tokens
+                    .dotted()
+                    .ok_or_else(|| fail("expected inputs.<slot>"))?;
+                ReferenceRoot::Input(SlotName::new(slot).map_err(|_| fail("invalid slot name"))?)
+            }
+            "steps" => {
+                let step = tokens.dotted().ok_or_else(|| fail("expected steps.<id>"))?;
+                let step = TaskId::new(step).map_err(|_| fail("invalid step id"))?;
+                match tokens.dotted() {
+                    Some("output") => ReferenceRoot::StepOutput(step),
+                    Some("status") => ReferenceRoot::StepStatus(step),
+                    Some("requirements") => {
+                        let requirement = tokens
+                            .dotted()
+                            .ok_or_else(|| fail("expected requirements.<id>"))?;
+                        let requirement =
+                            TaskId::new(requirement).map_err(|_| fail("invalid requirement id"))?;
+                        let field = match tokens.dotted() {
+                            Some("outcome") => VerdictField::Outcome,
+                            Some("reason") => VerdictField::Reason,
+                            _ => return Err(fail("expected .outcome or .reason")),
+                        };
+                        ReferenceRoot::StepVerdict {
+                            step,
+                            requirement,
+                            field,
+                        }
+                    }
+                    _ => return Err(fail("expected .output, .status, or .requirements")),
+                }
+            }
+            "requirement" => match tokens.dotted() {
+                Some("id") => ReferenceRoot::RequirementId,
+                Some("statement") => ReferenceRoot::RequirementStatement,
+                _ => return Err(fail("expected requirement.id or requirement.statement")),
+            },
+            _ => return Err(fail("root must be inputs, steps, or requirement")),
+        };
+        let path = tokens
+            .segments()
+            .ok_or_else(|| fail("malformed selector"))?;
+        if !path.is_empty()
+            && !matches!(root, ReferenceRoot::Input(_) | ReferenceRoot::StepOutput(_))
+        {
+            return Err(fail("only inputs and step outputs accept child selectors"));
+        }
+        Ok(Self { root, path })
+    }
+}
+
+/// Cursor over reference text.
+struct Tokens<'a> {
+    /// The text not yet consumed; each method advances it only on success
+    /// of the token it reads.
+    rest: &'a str,
+}
+
+impl<'a> Tokens<'a> {
+    /// Starts a cursor at the beginning of `text`.
+    fn new(text: &'a str) -> Self {
+        Self { rest: text }
+    }
+
+    /// Consumes one name made of ASCII alphanumerics, `_`, and `-`.
+    fn name(&mut self) -> Option<&'a str> {
+        let end = self
+            .rest
+            .find(|ch: char| !(ch.is_ascii_alphanumeric() || ch == '_' || ch == '-'))
+            .unwrap_or(self.rest.len());
+        if end == 0 {
+            return None;
+        }
+        let (name, rest) = self.rest.split_at(end);
+        self.rest = rest;
+        Some(name)
+    }
+
+    /// Consumes `.name`.
+    fn dotted(&mut self) -> Option<&'a str> {
+        self.rest = self.rest.strip_prefix('.')?;
+        self.name()
+    }
+
+    /// Consumes the remaining child selectors, or `None` when malformed.
+    fn segments(&mut self) -> Option<Vec<PathSegment>> {
+        let mut segments = Vec::new();
+        while !self.rest.is_empty() {
+            if self.rest.starts_with('.') {
+                segments.push(PathSegment::Field(self.dotted()?.to_owned()));
+            } else {
+                let (inner, rest) = self.rest.strip_prefix('[')?.split_once(']')?;
+                self.rest = rest;
+                segments.push(if inner == "*" {
+                    PathSegment::Wildcard
+                } else if !inner.is_empty() && inner.bytes().all(|byte| byte.is_ascii_digit()) {
+                    PathSegment::Index(inner.parse().ok()?)
+                } else {
+                    return None;
+                });
+            }
+        }
+        Some(segments)
+    }
+}
+
+impl fmt::Display for Reference {
+    /// Writes the canonical reference text, which [`Reference::parse`]
+    /// reads back to an equal value.
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match &self.root {
+            ReferenceRoot::Input(slot) => write!(f, "inputs.{slot}")?,
+            ReferenceRoot::StepOutput(step) => write!(f, "steps.{}.output", step.as_str())?,
+            ReferenceRoot::StepStatus(step) => write!(f, "steps.{}.status", step.as_str())?,
+            ReferenceRoot::StepVerdict {
+                step,
+                requirement,
+                field,
+            } => {
+                let field = match field {
+                    VerdictField::Outcome => "outcome",
+                    VerdictField::Reason => "reason",
+                };
+                write!(
+                    f,
+                    "steps.{}.requirements.{}.{field}",
+                    step.as_str(),
+                    requirement.as_str()
+                )?;
+            }
+            ReferenceRoot::RequirementId => f.write_str("requirement.id")?,
+            ReferenceRoot::RequirementStatement => f.write_str("requirement.statement")?,
+        }
+        for segment in &self.path {
+            match segment {
+                PathSegment::Field(name) => write!(f, ".{name}")?,
+                PathSegment::Index(index) => write!(f, "[{index}]")?,
+                PathSegment::Wildcard => f.write_str("[*]")?,
+            }
+        }
+        Ok(())
+    }
+}
+
+impl FromStr for Reference {
+    /// Why the text is not a reference.
+    type Err = ReferenceError;
+
+    /// Parses reference text; see [`Reference::parse`].
+    ///
+    /// # Errors
+    /// Returns [`ReferenceError`] for an unknown root, malformed selector, or
+    /// a child selector on a root that has no children.
+    fn from_str(text: &str) -> Result<Self, Self::Err> {
+        Self::parse(text)
+    }
+}
+
+impl Serialize for Reference {
+    /// Writes the reference as its canonical text.
+    ///
+    /// # Errors
+    /// Returns the serializer's error.
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.collect_str(self)
+    }
+}
+
+impl<'de> Deserialize<'de> for Reference {
+    /// Reads reference text and parses it.
+    ///
+    /// # Errors
+    /// Returns a custom error when the value is not a string or the text is
+    /// not a valid reference.
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let text = String::deserialize(deserializer)?;
+        Self::parse(&text).map_err(serde::de::Error::custom)
+    }
+}
+
+impl schemars::JsonSchema for Reference {
+    /// Names the reference schema in generated definitions.
+    fn schema_name() -> String {
+        "Reference".to_owned()
+    }
+
+    /// Describes a reference as a string, documenting the accepted roots
+    /// and selectors.
+    fn json_schema(_generator: &mut schemars::r#gen::SchemaGenerator) -> schemars::schema::Schema {
+        use schemars::schema::{InstanceType, Metadata, SchemaObject};
+
+        SchemaObject {
+            metadata: Some(Box::new(Metadata {
+                description: Some(
+                    "Scope reference: inputs.<slot>, steps.<id>.output, steps.<id>.status, \
+                     steps.<id>.requirements.<id>.outcome|reason, requirement.id, or \
+                     requirement.statement, with .field, [n], and (in assert each) [*] \
+                     selectors below inputs and step outputs."
+                        .to_owned(),
+                ),
+                ..Metadata::default()
+            })),
+            instance_type: Some(InstanceType::String.into()),
+            ..SchemaObject::default()
+        }
+        .into()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Reference text parsing, printing, and serde refusals.
+
+    use super::*;
+
+    /// Every approved root and selector form parses and prints back unchanged.
+    ///
+    /// # Panics
+    /// Panics when a valid reference is refused or does not round-trip.
+    #[test]
+    fn reference_round_trips_every_root() {
+        for text in [
+            "inputs.answer",
+            "inputs.reply.refund_amount",
+            "steps.structure.output.slides[*].title",
+            "steps.workbook.output.sheets[0].cells[1].value",
+            "steps.scope.status",
+            "steps.scope.requirements.reviewable-size.outcome",
+            "steps.scope.requirements.reviewable-size.reason",
+            "requirement.id",
+            "requirement.statement",
+        ] {
+            let reference = Reference::parse(text).expect(text);
+            assert_eq!(reference.to_string(), text);
+        }
+        let reference = Reference::parse("steps.a.output.x[2]").expect("parse");
+        assert_eq!(reference.step().map(TaskId::as_str), Some("a"));
+        assert_eq!(
+            reference.path,
+            vec![PathSegment::Field("x".to_owned()), PathSegment::Index(2)]
+        );
+    }
+
+    /// Malformed roots, IDs, and selectors are refused at parse time.
+    ///
+    /// # Panics
+    /// Panics when an invalid reference parses.
+    #[test]
+    fn reference_refuses_malformed_text() {
+        for text in [
+            "",
+            "$.inputs.a",
+            "output",
+            "inputs",
+            "inputs.a-b",
+            "steps.a",
+            "steps.a.result",
+            "steps.a.requirements.b",
+            "steps.a.requirements.b.verdict",
+            "steps.a.status.x",
+            "steps.a.requirements.b.outcome.x",
+            "requirement.statement.x",
+            "requirement.other",
+            "inputs.a.",
+            "inputs.a[]",
+            "inputs.a[x]",
+            "inputs.a[-1]",
+            "inputs.a[0",
+            "inputs.a..b",
+            "inputs.a b",
+        ] {
+            assert!(Reference::parse(text).is_err(), "{text}");
+        }
+    }
+
+    /// References serialize as their string form.
+    ///
+    /// # Panics
+    /// Panics when serde does not use the string form.
+    #[test]
+    fn reference_serde_uses_string_form() {
+        let reference: Reference =
+            serde_json::from_str("\"inputs.reply.text\"").expect("deserialize");
+        assert_eq!(
+            serde_json::to_value(&reference).expect("serialize"),
+            "inputs.reply.text"
+        );
+        assert!(serde_json::from_str::<Reference>("\"steps.x\"").is_err());
+    }
+}
diff --git a/crates/wyrd-spec/src/card/blocks/schema_path.rs b/crates/wyrd-spec/src/card/blocks/schema_path.rs
new file mode 100644
index 000000000..ed100568e
--- /dev/null
+++ b/crates/wyrd-spec/src/card/blocks/schema_path.rs
@@ -0,0 +1,301 @@
+//! Bounded structural analysis of declared JSON Schemas.
+//!
+//! Registration refuses a reference whose selectors cannot exist under a
+//! known output schema, and a check Agent whose declared response cannot
+//! produce the typed Verdict. Every analysis shares one finite budget across
+//! branch recursion and local `$ref` hops, so a self-referencing authored
+//! schema ends the walk instead of the stack.
+
+use serde_json::Value;
+
+use super::reference::PathSegment;
+
+/// Schema nodes and `$ref` hops one analysis may visit.
+const BUDGET: usize = 1024;
+
+/// Returns `false` only when `path` provably selects nothing under `schema`.
+///
+/// `root` resolves local `#/...` `$ref` pointers. `oneOf`/`anyOf` admit the
+/// path when any branch does. Anything the walk cannot decide — an unknown
+/// keyword, an open object, a missing `type`, an unresolved pointer, or an
+/// exhausted budget — is admitted so unknown shapes stay usable and fall back
+/// to missing-value handling at execution.
+pub(super) fn admits(root: &Value, schema: &Value, path: &[PathSegment]) -> bool {
+    Walk { budget: BUDGET }.admits(root, schema, path)
+}
+
+/// Returns whether every value `authored` admits has the shape `typed`
+/// requires.
+///
+/// Compares types, closed value sets (`enum`, `const`, and combinators of
+/// them), `allOf` parts (every typed part must hold; one authored part
+/// suffices), object properties, required and closed fields, and array items,
+/// following local `$ref` pointers on both sides. String formats, patterns,
+/// and numeric bounds are left to output decoding. An exhausted budget or an
+/// unresolved pointer is not shown to fit.
+pub(super) fn fits(authored: &Value, typed: &Value) -> bool {
+    Walk { budget: BUDGET }.fits(authored, authored, typed, typed)
+}
+
+/// One analysis and the work it may still spend.
+struct Walk {
+    /// Remaining node visits and `$ref` hops.
+    budget: usize,
+}
+
+impl Walk {
+    /// Spends one unit of work; `false` once the budget is exhausted.
+    fn spend(&mut self) -> bool {
+        self.budget = self.budget.saturating_sub(1);
+        self.budget > 0
+    }
+
+    /// Follows local `$ref` pointers; `None` when a pointer cannot be
+    /// resolved or the budget runs out.
+    fn resolve<'a>(&mut self, root: &'a Value, mut schema: &'a Value) -> Option<&'a Value> {
+        while let Some(pointer) = schema.get("$ref").and_then(Value::as_str) {
+            if !self.spend() {
+                return None;
+            }
+            schema = root.pointer(pointer.strip_prefix('#')?)?;
+        }
+        Some(schema)
+    }
+
+    /// [`admits`] within the remaining budget.
+    fn admits(&mut self, root: &Value, schema: &Value, path: &[PathSegment]) -> bool {
+        if !self.spend() {
+            return true;
+        }
+        let Some(schema) = self.resolve(root, schema) else {
+            return true;
+        };
+        let Some((segment, rest)) = path.split_first() else {
+            return true;
+        };
+        for keyword in ["oneOf", "anyOf"] {
+            if let Some(branches) = schema.get(keyword).and_then(Value::as_array) {
+                return branches
+                    .iter()
+                    .any(|branch| self.admits(root, branch, path));
+            }
+        }
+        match segment {
+            PathSegment::Field(name) => {
+                if let Some(property) = schema.get("properties").and_then(|props| props.get(name)) {
+                    return self.admits(root, property, rest);
+                }
+                if excludes_type(schema, "object") {
+                    return false;
+                }
+                match schema.get("additionalProperties") {
+                    Some(Value::Bool(false)) => false,
+                    Some(additional @ Value::Object(_)) => self.admits(root, additional, rest),
+                    _ => true,
+                }
+            }
+            PathSegment::Index(_) | PathSegment::Wildcard => match schema.get("items") {
+                Some(items @ Value::Object(_)) => self.admits(root, items, rest),
+                Some(_) => true,
+                None => !excludes_type(schema, "array"),
+            },
+        }
+    }
+
+    /// [`fits`] within the remaining budget, with each side's root for its
+    /// own `$ref` pointers.
+    fn fits(&mut self, a_root: &Value, authored: &Value, t_root: &Value, typed: &Value) -> bool {
+        if !self.spend() {
+            return false;
+        }
+        let (Some(authored), Some(typed)) =
+            (self.resolve(a_root, authored), self.resolve(t_root, typed))
+        else {
+            return false;
+        };
+        for keyword in ["oneOf", "anyOf"] {
+            if let Some(branches) = authored.get(keyword).and_then(Value::as_array) {
+                return branches
+                    .iter()
+                    .all(|branch| self.fits(a_root, branch, t_root, typed));
+            }
+        }
+        if let Some(parts) = typed.get("allOf").and_then(Value::as_array) {
+            return parts
+                .iter()
+                .all(|part| self.fits(a_root, authored, t_root, part));
+        }
+        if let Some(parts) = authored.get("allOf").and_then(Value::as_array) {
+            return parts
+                .iter()
+                .any(|part| self.fits(a_root, part, t_root, typed));
+        }
+        if let Some(allowed) = self.values(t_root, typed) {
+            return self
+                .values(a_root, authored)
+                .is_some_and(|values| values.iter().all(|value| allowed.contains(value)));
+        }
+        for keyword in ["oneOf", "anyOf"] {
+            if let Some(branches) = typed.get(keyword).and_then(Value::as_array) {
+                return branches
+                    .iter()
+                    .any(|branch| self.fits(a_root, authored, t_root, branch));
+            }
+        }
+        let wanted = types(typed);
+        if wanted.is_empty() {
+            return true;
+        }
+        let declared = types(authored);
+        let allowed =
+            |ty: &&str| wanted.contains(ty) || (*ty == "integer" && wanted.contains(&"number"));
+        if declared.is_empty() || !declared.iter().all(allowed) {
+            return false;
+        }
+        self.fits_object(a_root, authored, t_root, typed)
+            && match typed.get("items") {
+                Some(items) => authored
+                    .get("items")
+                    .is_some_and(|own| self.fits(a_root, own, t_root, items)),
+                None => true,
+            }
+    }
+
+    /// Requires an authored object to declare every typed required field as
+    /// a required property that fits, to add no field a closed typed object
+    /// refuses, and to stay closed when the typed object is.
+    fn fits_object(
+        &mut self,
+        a_root: &Value,
+        authored: &Value,
+        t_root: &Value,
+        typed: &Value,
+    ) -> bool {
+        let Some(properties) = typed.get("properties").and_then(Value::as_object) else {
+            return true;
+        };
+        let closed =
+            |schema: &Value| schema.get("additionalProperties") == Some(&Value::Bool(false));
+        let own = authored.get("properties").and_then(Value::as_object);
+        let own_required = required(authored);
+        if closed(typed) && !closed(authored) {
+            return false;
+        }
+        let complete = required(typed).iter().all(|field| {
+            own_required.contains(field) && own.is_some_and(|own| own.contains_key(*field))
+        });
+        let known = own_required
+            .iter()
+            .all(|field| properties.contains_key(*field));
+        complete
+            && known
+            && own
+                .into_iter()
+                .flatten()
+                .all(|(name, schema)| match properties.get(name) {
+                    Some(expected) => self.fits(a_root, schema, t_root, expected),
+                    None => !closed(typed),
+                })
+    }
+
+    /// The closed set of values a schema admits — its `const`, its `enum`,
+    /// or the union over `oneOf`/`anyOf` branches that all have one — or
+    /// `None` when the schema admits an open set.
+    fn values<'a>(&mut self, root: &'a Value, schema: &'a Value) -> Option<Vec<&'a Value>> {
+        if !self.spend() {
+            return None;
+        }
+        let schema = self.resolve(root, schema)?;
+        if let Some(value) = schema.get("const") {
+            return Some(vec![value]);
+        }
+        if let Some(values) = schema.get("enum").and_then(Value::as_array) {
+            return Some(values.iter().collect());
+        }
+        let branches = ["oneOf", "anyOf"]
+            .into_iter()
+            .find_map(|keyword| schema.get(keyword).and_then(Value::as_array))?;
+        let mut all = Vec::new();
+        for branch in branches {
+            all.extend(self.values(root, branch)?);
+        }
+        Some(all)
+    }
+}
+
+/// The JSON types a schema's `type` declares; empty when it declares none.
+fn types(schema: &Value) -> Vec<&str> {
+    match schema.get("type") {
+        Some(Value::String(ty)) => vec![ty.as_str()],
+        Some(Value::Array(declared)) => declared.iter().filter_map(Value::as_str).collect(),
+        _ => Vec::new(),
+    }
+}
+
+/// The field names a schema's `required` lists.
+fn required(schema: &Value) -> Vec<&str> {
+    schema
+        .get("required")
+        .and_then(Value::as_array)
+        .map(|fields| fields.iter().filter_map(Value::as_str).collect())
+        .unwrap_or_default()
+}
+
+/// Returns whether the schema's declared `type` rules out `wanted`.
+fn excludes_type(schema: &Value, wanted: &str) -> bool {
+    !types(schema).is_empty() && !types(schema).contains(&wanted)
+}
+
+#[cfg(test)]
+mod tests {
+    //! Known-missing selector detection over local schemas.
+
+    use serde_json::json;
+
+    use super::*;
+
+    /// Field, index, and wildcard selectors are refused only when the schema
+    /// proves them absent.
+    ///
+    /// # Panics
+    /// Panics when a selector is admitted or refused incorrectly.
+    #[test]
+    fn schema_path_refuses_only_known_missing_selectors() {
+        let schema = json!({
+            "definitions": {"Item": {"type": "object", "properties": {"name": {"type": "string"}}, "additionalProperties": false}},
+            "type": "object",
+            "properties": {
+                "items": {"type": "array", "items": {"$ref": "#/definitions/Item"}},
+                "open": {"type": "object"},
+                "maybe": {"anyOf": [{"$ref": "#/definitions/Item"}, {"type": "null"}]},
+                "text": {"type": "string"}
+            },
+            "additionalProperties": false
+        });
+        let field = |name: &str| PathSegment::Field(name.to_owned());
+        assert!(admits(
+            &schema,
+            &schema,
+            &[field("items"), PathSegment::Wildcard, field("name")]
+        ));
+        assert!(admits(
+            &schema,
+            &schema,
+            &[field("open"), field("anything")]
+        ));
+        assert!(admits(&schema, &schema, &[field("maybe"), field("name")]));
+        assert!(!admits(&schema, &schema, &[field("missing")]));
+        assert!(!admits(
+            &schema,
+            &schema,
+            &[field("items"), PathSegment::Index(0), field("nope")]
+        ));
+        assert!(!admits(&schema, &schema, &[field("text"), field("x")]));
+        assert!(!admits(
+            &schema,
+            &schema,
+            &[field("text"), PathSegment::Index(0)]
+        ));
+        assert!(admits(&json!({}), &json!({}), &[field("x")]));
+    }
+}
