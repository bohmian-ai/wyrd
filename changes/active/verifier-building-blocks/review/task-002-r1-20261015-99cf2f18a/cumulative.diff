+/// Agent and code passes need a citation of evidence the call could reach;
+/// unreachable citations are dropped, a citation-less pass is inconclusive,
+/// a check error is inconclusive with its reason, and a failed verdict is
+/// kept as data.
+///
+/// # Panics
+/// Panics when a citation outcome differs.
+#[tokio::test(start_paused = true)]
+async fn hosted_check_passes_need_reachable_citations() {
+    let check = |id: &str| json!({"id": id, "statement": id, "check": code_check(json!({"answer": "inputs.answer", "claim": "requirement.statement"}))});
+    let spec = verifier(json!({
+        "inputs": {"answer": {"type": "json"}, "policy": {"type": "json"}},
+        "requirements": [check("cited"), check("uncited"), check("elsewhere"), check("errored"), check("rejected")]
+    }));
+    let answer = json!([{"slot": "answer", "locator": {"json_pointer": "/text"}}]);
+    let policy = json!([{"slot": "policy", "locator": {"page": 1}}]);
+    let script = Arc::new(Script {
+        checks: HashMap::from([
+            (
+                "cited",
+                Ok(verdict(VerificationVerdict::Passed, answer.clone())),
+            ),
+            (
+                "uncited",
+                Ok(verdict(VerificationVerdict::Passed, json!([]))),
+            ),
+            (
+                "elsewhere",
+                Ok(verdict(VerificationVerdict::Passed, policy)),
+            ),
+            (
+                "errored",
+                Err(BlockError::Terminal {
+                    reason: "invalid verdict".to_owned(),
+                }),
+            ),
+            (
+                "rejected",
+                Ok(verdict(VerificationVerdict::Failed, json!([]))),
+            ),
+        ]),
+        ..Script::default()
+    });
+    let outcome = run(
+        &engine(&script, InMemoryTraceSource::new(), 4),
+        &spec,
+        json!({"answer": {"text": "hi"}, "policy": {}}),
+    )
+    .await
+    .expect("outcome");
+    assert_eq!(
+        outcomes(&outcome),
+        BTreeMap::from([
+            ("cited", RequirementOutcome::Passed),
+            ("uncited", RequirementOutcome::Inconclusive),
+            ("elsewhere", RequirementOutcome::Inconclusive),
+            ("errored", RequirementOutcome::Inconclusive),
+            ("rejected", RequirementOutcome::Failed),
+        ])
+    );
+    assert_eq!(requirement(&outcome, "cited").citations.len(), 1);
+    assert!(requirement(&outcome, "elsewhere").citations.is_empty());
+    assert_eq!(requirement(&outcome, "errored").reason, "invalid verdict");
+}
+
+/// A one-column numeric sample batch.
+fn samples(
+    column: &str,
+    values: impl IntoIterator<Item = f64>,
+) -> arrow::record_batch::RecordBatch {
+    use arrow::array::Float64Array;
+    use arrow::datatypes::{DataType, Field, Schema};
+    let schema = Schema::new(vec![Field::new(column, DataType::Float64, true)]);
+    let values: Float64Array = values.into_iter().collect::<Vec<_>>().into();
+    arrow::record_batch::RecordBatch::try_new(Arc::new(schema), vec![Arc::new(values)])
+        .expect("sample batch")
+}
+
+/// A drift requirement over `inputs.<slot>` with the given method fields.
+///
+/// # Panics
+/// Panics when `method` is not a JSON object.
+fn drift_requirement(id: &str, slot: &str, method: Value) -> Value {
+    let mut check = json!({"kind": "drift", "on": format!("inputs.{slot}"), "condition": {"kind": "Statistical"}});
+    check
+        .as_object_mut()
+        .expect("object")
+        .extend(method.as_object().expect("object").clone());
+    json!({"id": id, "statement": id, "check": check})
+}
+
+/// Drift requirements score through `vala-drift`: Custom compares the
+/// window mean, PSI scores against fitted state and keeps the report as
+/// detail, and missing samples, unready baselines, and too few rows are
+/// inconclusive with the scorer's reason, all with drift provenance.
+///
+/// # Panics
+/// Panics when a drift outcome, detail, or provenance differs.
+#[tokio::test(start_paused = true)]
+async fn drift_requirements_score_through_vala_drift() {
+    let custom = |id: &str, baseline: f64| {
+        drift_requirement(
+            id,
+            "latency",
+            json!({"method": "Custom", "signal": {"kind": "Metric", "name": "ms"},
+            "profile": {"kind": "Custom", "metric_name": "ms", "baseline_value": baseline, "alert_threshold": 5.0}}),
+        )
+    };
+    let psi = |id: &str, slot: &str| {
+        drift_requirement(
+            id,
+            slot,
+            json!({"method": "Psi",
+            "signal": {"kind": "Distribution", "baseline_ref": {"kind": "Data", "space": "risk", "name": "train", "version": "1.0.0"}, "features": ["x"]},
+            "profile": {"kind": "Psi", "binning_strategy": {"kind": "EqualWidth", "n_bins": 4}, "threshold": {"kind": "Fixed", "value": 0.2}}}),
+        )
+    };
+    let spec = verifier(json!({
+        "inputs": {
+            "latency": {"type": "samples", "features": ["ms"]},
+            "shifted": {"type": "samples", "features": ["x"]},
+            "few": {"type": "samples", "features": ["x"]},
+            "unrecorded": {"type": "samples", "features": ["x"]}
+        },
+        "requirements": [
+            custom("steady", 100.0), custom("slow", 50.0),
+            psi("psi-shift", "shifted"), psi("psi-unready", "shifted"), psi("psi-few", "few"), psi("psi-none", "unrecorded")
+        ]
+    }));
+    let check = |id: &str| match &spec
+        .requirements
+        .iter()
+        .find(|r| r.id.as_str() == id)
+        .expect("requirement")
+        .check
+    {
+        Check::Drift(check) => check.spec.clone(),
+        other => panic!("not a drift check: {other:?}"),
+    };
+    let baseline = vala_drift::fit_baseline(
+        &samples("x", (0..200).map(|i| f64::from(i % 100))),
+        &check("psi-shift"),
+    )
+    .expect("fitted baseline");
+    let drift = DriftChecks::new(
+        None,
+        BTreeMap::from([
+            (TaskId::new("psi-shift").expect("id"), baseline.clone()),
+            (TaskId::new("psi-few").expect("id"), baseline),
+        ]),
+        BTreeMap::from([
+            (
+                SlotName::new("latency").expect("slot"),
+                samples("ms", [99.0, 101.0, 100.0]),
+            ),
+            (
+                SlotName::new("shifted").expect("slot"),
+                samples("x", (0..200).map(|i| f64::from(75 + i % 25))),
+            ),
+            (
+                SlotName::new("few").expect("slot"),
+                samples("x", (0..10).map(f64::from)),
+            ),
+        ]),
+    );
+    let script = Arc::new(Script::default());
+    let outcome = engine(&script, InMemoryTraceSource::new(), 4)
+        .with_drift(drift)
+        .run(
+            Arc::clone(&spec),
+            BTreeMap::new(),
+            Instant::now() + Duration::from_secs(60),
+        )
+        .await
+        .expect("outcome");
+    assert_eq!(
+        outcomes(&outcome),
+        BTreeMap::from([
+            ("steady", RequirementOutcome::Passed),
+            ("slow", RequirementOutcome::Failed),
+            ("psi-shift", RequirementOutcome::Failed),
+            ("psi-unready", RequirementOutcome::Inconclusive),
+            ("psi-few", RequirementOutcome::Inconclusive),
+            ("psi-none", RequirementOutcome::Inconclusive),
+        ])
+    );
+    let shifted = requirement(&outcome, "psi-shift");
+    assert!(
+        matches!(shifted.detail, Some(RequirementDetail::Drift(_))),
+        "{shifted:?}"
+    );
+    assert!(
+        requirement(&outcome, "psi-unready")
+            .reason
+            .contains("not ready")
+    );
+    assert!(
+        requirement(&outcome, "psi-none")
+            .reason
+            .contains("no samples")
+    );
+    assert!(
+        outcome
+            .requirements
+            .iter()
+            .all(|r| r.provenance == Some(CallProvenance::Drift { window: None })),
+        "every drift result names its window"
+    );
+    assert!(script.calls().is_empty());
+}
+
+/// A Custom drift window with a null measurement of its configured metric
+/// is unscored and inconclusive, keeping its window and empty report, rather
+/// than passing on the non-null mean; nulls in unrelated columns do not
+/// matter, complete windows still pass or fail, and a missing metric column
+/// is still the scorer's refusal.
+///
+/// # Panics
+/// Panics when a Custom outcome, detail, or provenance differs.
+#[tokio::test(start_paused = true)]
+async fn custom_drift_needs_complete_measurements() {
+    use arrow::array::{Float64Array, StringArray};
+    use arrow::datatypes::{DataType, Field, Schema};
+    use chrono::{TimeZone, Utc};
+    let custom = |id: &str, slot: &str, baseline: f64| {
+        drift_requirement(
+            id,
+            slot,
+            json!({"method": "Custom", "signal": {"kind": "Metric", "name": "ms"},
+            "profile": {"kind": "Custom", "metric_name": "ms", "baseline_value": baseline, "alert_threshold": 5.0}}),
+        )
+    };
+    let spec = verifier(json!({
+        "inputs": {
+            "holes": {"type": "samples", "features": ["ms"]},
+            "noted": {"type": "samples", "features": ["ms"]},
+            "renamed": {"type": "samples", "features": ["ms"]}
+        },
+        "requirements": [
+            custom("holes", "holes", 100.0), custom("noted", "noted", 100.0),
+            custom("noted-slow", "noted", 50.0), custom("renamed", "renamed", 100.0)
+        ]
+    }));
+    let schema = Schema::new(vec![
+        Field::new("ms", DataType::Float64, true),
+        Field::new("note", DataType::Utf8, true),
+    ]);
+    let noted = arrow::record_batch::RecordBatch::try_new(
+        Arc::new(schema),
+        vec![
+            Arc::new(Float64Array::from(vec![99.0, 101.0])),
+            Arc::new(StringArray::from(vec![None::<&str>, None])),
+        ],
+    )
+    .expect("noted batch");
+    let holes = arrow::record_batch::RecordBatch::try_new(
+        Arc::new(Schema::new(vec![Field::new("ms", DataType::Float64, true)])),
+        vec![Arc::new(Float64Array::from(vec![Some(100.0), None]))],
+    )
+    .expect("holes batch");
+    let window = DriftWindow {
+        start: Utc
+            .with_ymd_and_hms(2026, 10, 1, 0, 0, 0)
+            .single()
+            .expect("start"),
+        end: Utc
+            .with_ymd_and_hms(2026, 10, 2, 0, 0, 0)
+            .single()
+            .expect("end"),
+    };
+    let drift = DriftChecks::new(
+        Some(window),
+        BTreeMap::new(),
+        BTreeMap::from([
+            (SlotName::new("holes").expect("slot"), holes),
+            (SlotName::new("noted").expect("slot"), noted),
+            (
+                SlotName::new("renamed").expect("slot"),
+                samples("latency", [100.0]),
+            ),
+        ]),
+    );
+    let script = Arc::new(Script::default());
+    let outcome = engine(&script, InMemoryTraceSource::new(), 4)
+        .with_drift(drift)
+        .run(
+            Arc::clone(&spec),
+            BTreeMap::new(),
+            Instant::now() + Duration::from_secs(60),
+        )
+        .await
+        .expect("outcome");
+    assert_eq!(
+        outcomes(&outcome),
+        BTreeMap::from([
+            ("holes", RequirementOutcome::Inconclusive),
+            ("noted", RequirementOutcome::Passed),
+            ("noted-slow", RequirementOutcome::Failed),
+            ("renamed", RequirementOutcome::Inconclusive),
+        ])
+    );
+    assert_eq!(outcome.verdict, VerificationVerdict::Failed);
+    let holes = requirement(&outcome, "holes");
+    assert!(
+        matches!(&holes.detail, Some(RequirementDetail::Drift(report)) if report.features.is_empty()),
+        "{holes:?}"
+    );
+    assert!(
+        requirement(&outcome, "renamed").reason.contains("ms"),
+        "the scorer's missing-feature refusal is kept"
+    );
+    assert!(
+        outcome.requirements.iter().all(|r| r.provenance
+            == Some(CallProvenance::Drift {
+                window: Some(window)
+            })),
+        "every drift result names its window"
+    );
+}
diff --git a/crates/vala/vala-eval/src/blocks/scope.rs b/crates/vala/vala-eval/src/blocks/scope.rs
new file mode 100644
index 000000000..0d7421d9b
--- /dev/null
+++ b/crates/vala/vala-eval/src/blocks/scope.rs
@@ -0,0 +1,360 @@
+//! The execution scope Verifier references resolve against.
+//!
+//! The scope reads the original evidence declarations and the shared
+//! [`RunLedger`] of the stage walk, which holds each settled step's status
+//! and output and each settled step requirement's verdict. The driver
+//! resolves every binding a block declares here before handing the block to
+//! an executor, so executors only ever see values. A value that cannot be
+//! supplied resolves to [`Missing`], which keeps the cause of the gap so an
+//! intentional skip is never confused with a failure.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde_json::Value;
+
+use wyrd_spec::card::blocks::VerifierSpec;
+use wyrd_spec::card::blocks::{PathSegment, Reference, ReferenceRoot, Requirement, VerdictField};
+use wyrd_spec::ids::SlotName;
+use wyrd_spec::vala::eval::TaskId;
+use wyrd_spec::verification::execution::{
+    InputDeclaration, RequirementOutcome, RequirementResult, StepResult, StepStatus,
+};
+
+use super::{CallInput, CallValue};
+use crate::executor::RunLedger;
+
+/// Why a value is missing. Ordered so the stronger cause is the greater:
+/// when causes mix, failure wins.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(super) enum Cause {
+    /// An intentional skip: a false `when`, or blocked only by one.
+    Skipped,
+    /// A failure, timeout, or otherwise missing required value.
+    Failed,
+}
+
+impl Cause {
+    /// The outcome of a requirement whose evidence is missing for this cause.
+    pub(super) const fn outcome(self) -> RequirementOutcome {
+        match self {
+            Self::Skipped => RequirementOutcome::NotApplicable,
+            Self::Failed => RequirementOutcome::Inconclusive,
+        }
+    }
+}
+
+/// A value that could not be supplied, with its cause and a bounded reason.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Missing {
+    /// Why the value is missing.
+    pub cause: Cause,
+    /// Human-readable explanation recorded on the dependent block.
+    pub reason: String,
+}
+
+impl Missing {
+    /// A missing value caused by a failure or absent required evidence.
+    pub(super) fn failed(reason: impl Into<String>) -> Self {
+        Self {
+            cause: Cause::Failed,
+            reason: reason.into(),
+        }
+    }
+
+    /// Fold several gaps into one: the strongest cause wins, keeping the
+    /// first reason recorded for that cause.
+    pub(super) fn strongest(gaps: impl IntoIterator<Item = Self>) -> Option<Self> {
+        gaps.into_iter()
+            .fold(None, |best: Option<Self>, gap| match best {
+                Some(best) if best.cause >= gap.cause => Some(best),
+                _ => Some(gap),
+            })
+    }
+}
+
+/// The final state of one step as later blocks read it.
+#[derive(Debug, Clone, PartialEq)]
+pub(super) enum Settled {
+    /// The action produced `output`, derived from the `sources` slots.
+    Succeeded {
+        /// The action output.
+        output: Value,
+        /// Original slots the action read.
+        sources: BTreeSet<SlotName>,
+    },
+    /// The step failed or was skipped, so it has no output.
+    NoOutput {
+        /// `failed` or `skipped`, as `steps.<id>.status` reads it.
+        status: StepStatus,
+        /// Why there is no output; a skip blocked by a failure carries the
+        /// failure cause.
+        gap: Missing,
+    },
+}
+
+impl Settled {
+    /// The status `steps.<id>.status` reads.
+    pub(super) const fn status(&self) -> StepStatus {
+        match self {
+            Self::Succeeded { .. } => StepStatus::Succeeded,
+            Self::NoOutput { status, .. } => *status,
+        }
+    }
+}
+
+/// One settled Verifier block in the shared [`RunLedger`].
+///
+/// Results are boxed because they are an order of magnitude larger than the
+/// settled state, and the ledger holds every block.
+#[derive(Debug)]
+pub(super) enum Done {
+    /// A step: its reported result and the state later blocks read.
+    Step {
+        /// The reported step result.
+        result: Box<StepResult>,
+        /// The state `steps.<id>` references read.
+        state: Settled,
+    },
+    /// A judged requirement, as reported.
+    Requirement(Box<RequirementResult>),
+}
+
+/// The scope document of one stage: the original evidence plus every block
+/// earlier stages settled. Read-only; the stage walk owns the ledger.
+pub(super) struct Scope<'a> {
+    /// The executing Verifier, for slot declarations.
+    spec: &'a VerifierSpec,
+    /// The pinned original evidence by slot.
+    evidence: &'a BTreeMap<SlotName, InputDeclaration>,
+    /// Blocks settled by earlier stages.
+    ledger: &'a RunLedger<Done>,
+}
+
+impl<'a> Scope<'a> {
+    /// The scope over the original evidence and the blocks in `ledger`.
+    pub(super) fn new(
+        spec: &'a VerifierSpec,
+        evidence: &'a BTreeMap<SlotName, InputDeclaration>,
+        ledger: &'a RunLedger<Done>,
+    ) -> Self {
+        Self {
+            spec,
+            evidence,
+            ledger,
+        }
+    }
+
+    /// Returns a settled step's state.
+    pub(super) fn step(&self, step: &TaskId) -> Option<&Settled> {
+        match self.ledger.get(step) {
+            Some(Done::Step { state, .. }) => Some(state),
+            _ => None,
+        }
+    }
+
+    /// Returns a settled step requirement's verdict.
+    fn verdict(&self, requirement: &TaskId) -> Option<&RequirementResult> {
+        match self.ledger.get(requirement) {
+            Some(Done::Requirement(result)) => Some(result),
+            _ => None,
+        }
+    }
+
+    /// Resolve every named binding, returning the values or the strongest
+    /// gap among them.
+    ///
+    /// # Errors
+    /// Returns the strongest [`Missing`] when any binding cannot be supplied.
+    pub(super) fn resolve_all<'r, K: ToString + 'r>(
+        &self,
+        bindings: impl IntoIterator<Item = (K, &'r Reference)>,
+        requirement: Option<&Requirement>,
+    ) -> Result<BTreeMap<String, CallInput>, Missing> {
+        let mut resolved = BTreeMap::new();
+        let mut gaps = Vec::new();
+        for (name, reference) in bindings {
+            match self.resolve(reference, requirement) {
+                Ok(input) => {
+                    resolved.insert(name.to_string(), input);
+                }
+                Err(gap) => gaps.push(gap),
+            }
+        }
+        Missing::strongest(gaps).map_or(Ok(resolved), Err)
+    }
+
+    /// Resolve one reference, with `requirement` as the current requirement
+    /// during its check.
+    ///
+    /// A JSON input or step output is navigated by the reference's child
+    /// selectors; a whole media or trace slot resolves to its pinned
+    /// declaration. An omitted optional slot is `null`. Step statuses and
+    /// verdict fields resolve to their wire strings.
+    ///
+    /// # Errors
+    /// Returns [`Missing`] carrying the upstream cause for the output of a
+    /// step that produced none, and a failure for an omitted required slot,
+    /// an unsettled step or verdict, or a selector that matches nothing.
+    pub(super) fn resolve(
+        &self,
+        reference: &Reference,
+        requirement: Option<&Requirement>,
+    ) -> Result<CallInput, Missing> {
+        let unresolved = || Missing::failed(format!("`{reference}` has no value"));
+        let constant = |text: &str| Ok(json_input(Value::String(text.to_owned()), BTreeSet::new()));
+        match &reference.root {
+            ReferenceRoot::Input(slot) => {
+                let sources = BTreeSet::from([slot.clone()]);
+                match self.evidence.get(slot) {
+                    Some(InputDeclaration::Json { value }) => select(value, &reference.path)
+                        .map(|value| json_input(value, sources))
+                        .ok_or_else(unresolved),
+                    Some(declaration) if reference.path.is_empty() => Ok(CallInput {
+                        value: CallValue::Evidence(declaration.clone()),
+                        sources,
+                    }),
+                    Some(_) => Err(unresolved()),
+                    None if self
+                        .spec
+                        .inputs
+                        .get(slot)
+                        .is_some_and(|slot| !slot.required()) =>
+                    {
+                        select(&Value::Null, &reference.path)
+                            .map(|value| json_input(value, sources))
+                            .ok_or_else(unresolved)
+                    }
+                    None => Err(Missing::failed(format!(
+                        "required input `{slot}` was not supplied"
+                    ))),
+                }
+            }
+            ReferenceRoot::StepOutput(step) => match self.step(step) {
+                Some(Settled::Succeeded { output, sources }) => select(output, &reference.path)
+                    .map(|value| json_input(value, sources.clone()))
+                    .ok_or_else(unresolved),
+                Some(Settled::NoOutput { gap, .. }) => Err(Missing {
+                    cause: gap.cause,
+                    reason: format!(
+                        "step `{}` produced no output: {}",
+                        step.as_str(),
+                        gap.reason
+                    ),
+                }),
+                None => Err(unresolved()),
+            },
+            ReferenceRoot::StepStatus(step) => {
+                let settled = self.step(step).ok_or_else(unresolved)?;
+                Ok(json_input(wire(&settled.status()), BTreeSet::new()))
+            }
+            ReferenceRoot::StepVerdict {
+                requirement: id,
+                field,
+                ..
+            } => {
+                let verdict = self.verdict(id).ok_or_else(unresolved)?;
+                let value = match field {
+                    VerdictField::Outcome => wire(&verdict.outcome),
+                    VerdictField::Reason => Value::String(verdict.reason.clone()),
+                };
+                Ok(json_input(value, BTreeSet::new()))
+            }
+            ReferenceRoot::RequirementId => {
+                requirement.map_or_else(|| Err(unresolved()), |req| constant(req.id.as_str()))
+            }
+            ReferenceRoot::RequirementStatement => {
+                requirement.map_or_else(|| Err(unresolved()), |req| constant(&req.statement))
+            }
+        }
+    }
+}
+
+/// A JSON binding value.
+fn json_input(value: Value, sources: BTreeSet<SlotName>) -> CallInput {
+    CallInput {
+        value: CallValue::Json(value),
+        sources,
+    }
+}
+
+/// The serde wire form of a status or outcome enum, such as `"succeeded"`.
+fn wire<T: serde::Serialize>(value: &T) -> Value {
+    serde_json::to_value(value).unwrap_or(Value::Null)
+}
+
+/// Apply child selectors to `value`.
+///
+/// Fields and indexes select one child; a `[*]` wildcard maps the remaining
+/// selectors over every array element and yields the array of results.
+/// Returns `None` when any selected field, index, or wildcard target is
+/// absent, so a missing value is never mistaken for `null`.
+fn select(value: &Value, path: &[PathSegment]) -> Option<Value> {
+    let Some((segment, rest)) = path.split_first() else {
+        return Some(value.clone());
+    };
+    match segment {
+        PathSegment::Field(name) => select(value.get(name)?, rest),
+        PathSegment::Index(index) => select(value.get(index)?, rest),
+        PathSegment::Wildcard => {
+            // A later wildcard already yields an array of matches; flatten
+            // it so `a[*].b[*]` is one array.
+            let nested = rest.contains(&PathSegment::Wildcard);
+            let mut matches = Vec::new();
+            for item in value.as_array()? {
+                match select(item, rest)? {
+                    Value::Array(inner) if nested => matches.extend(inner),
+                    other => matches.push(other),
+                }
+            }
+            Some(Value::Array(matches))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Reference selection over the scope document.
+
+    use serde_json::json;
+
+    use super::*;
+
+    /// Parse a reference's child selectors.
+    ///
+    /// # Panics
+    /// Panics when `inputs.x<text>` is not a valid reference.
+    fn path(text: &str) -> Vec<PathSegment> {
+        Reference::parse(&format!("inputs.x{text}"))
+            .expect("reference")
+            .path
+    }
+
+    /// Fields, indexes, and nested wildcards select values; absent targets
+    /// are missing while an explicit null is a value.
+    ///
+    /// # Panics
+    /// Panics when a selection result differs from the expected value.
+    #[test]
+    fn select_distinguishes_absent_from_null() {
+        let doc = json!({"sheets": [
+            {"cells": [{"error": null}, {"error": "#DIV/0!"}]},
+            {"cells": [{"error": null}]}
+        ], "none": null});
+        assert_eq!(
+            select(&doc, &path(".sheets[0].cells[1].error")),
+            Some(json!("#DIV/0!"))
+        );
+        assert_eq!(
+            select(&doc, &path(".sheets[*].cells[*].error")),
+            Some(json!([null, "#DIV/0!", null]))
+        );
+        assert_eq!(select(&doc, &path(".none")), Some(Value::Null));
+        assert_eq!(select(&doc, &path(".absent")), None);
+        assert_eq!(select(&doc, &path(".sheets[5]")), None);
+        assert_eq!(select(&doc, &path(".none.child")), None);
+        assert_eq!(
+            select(&json!({"rows": []}), &path(".rows[*]")),
+            Some(json!([]))
+        );
+    }
+}
