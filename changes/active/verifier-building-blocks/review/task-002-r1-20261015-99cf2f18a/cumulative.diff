+    assert!(
+        !script.calls().iter().any(|call| call.starts_with("check:")),
+        "no check runs on missing evidence: {:?}",
+        script.calls()
+    );
+    assert_eq!(outcome.verdict, VerificationVerdict::Inconclusive);
