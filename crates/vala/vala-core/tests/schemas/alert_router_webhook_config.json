{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebhookConfig",
  "description": "Configuration for a signed HTTP webhook destination.",
  "type": "object",
  "properties": {
    "headers": {
      "description": "Non-sensitive static HTTP headers.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "method": {
      "description": "HTTP method for delivery.",
      "default": "POST",
      "allOf": [
        {
          "$ref": "#/definitions/WebhookMethod"
        }
      ]
    },
    "secret_headers": {
      "description": "Sensitive HTTP headers whose values resolve from the runtime secret store.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SecretRef"
      }
    },
    "secret_ref": {
      "description": "HMAC-SHA256 signing key. `None` disables signing.",
      "anyOf": [
        {
          "$ref": "#/definitions/SecretRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature_header": {
      "description": "Header name that carries the hex-encoded HMAC-SHA256 signature.",
      "default": "X-Wyrd-Signature",
      "type": "string"
    },
    "timeout_ms": {
      "description": "Request timeout in milliseconds.",
      "default": 10000,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "timestamp_header": {
      "description": "Header name that carries the Unix timestamp used by the signing string.",
      "default": "X-Wyrd-Timestamp",
      "type": "string"
    },
    "tls": {
      "description": "Optional TLS configuration.",
      "anyOf": [
        {
          "$ref": "#/definitions/TlsConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "description": "Destination URL. Must be non-empty.",
      "default": "",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SecretRef": {
      "description": "Pointer into the Wyrd runtime secret store.\n\nThe `Inline` variant is compiled only for `cfg(test)` inside `wyrd-spec` or when the `test-utils` feature is enabled. Public schema goldens are generated without `test-utils`, so `inline` is absent from production schemas.",
      "oneOf": [
        {
          "description": "Environment variable name.",
          "type": "object",
          "required": [
            "name",
            "source"
          ],
          "properties": {
            "name": {
              "description": "Environment variable name. Must be non-empty when resolved.",
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "env"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Local filesystem path to a file containing the secret value.",
          "type": "object",
          "required": [
            "path",
            "source"
          ],
          "properties": {
            "path": {
              "description": "File path. Must be non-empty when resolved.",
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "file"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Backend-agnostic key in an external secret manager.",
          "type": "object",
          "required": [
            "key",
            "source"
          ],
          "properties": {
            "key": {
              "description": "Secret-manager key path. Interpretation is backend-specific.",
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "vault"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TlsConfig": {
      "description": "TLS configuration for a transport connection.",
      "type": "object",
      "properties": {
        "ca_cert": {
          "description": "PEM-encoded CA certificate bundle.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_cert": {
          "description": "PEM-encoded client certificate for mTLS.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_key": {
          "description": "PEM-encoded client private key for mTLS.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "insecure_skip_verify": {
          "description": "Disable peer certificate verification. Defaults to `false`.",
          "default": false,
          "type": "boolean"
        },
        "server_name_override": {
          "description": "Override the server name used in SNI and certificate verification.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "WebhookMethod": {
      "description": "HTTP method for webhook delivery.",
      "oneOf": [
        {
          "description": "HTTP POST.",
          "type": "string",
          "enum": [
            "POST"
          ]
        },
        {
          "description": "HTTP PUT.",
          "type": "string",
          "enum": [
            "PUT"
          ]
        }
      ]
    }
  }
}
