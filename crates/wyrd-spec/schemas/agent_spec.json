{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentSpec",
  "description": "Protocol-neutral agent metadata and composition.",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Agent capabilities.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_input_modes": {
      "description": "Default input modes.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_output_modes": {
      "description": "Default output modes.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Agent description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": true
    },
    "documentation_url": {
      "description": "Documentation URL.",
      "type": [
        "string",
        "null"
      ]
    },
    "icon_url": {
      "description": "Icon URL.",
      "type": [
        "string",
        "null"
      ]
    },
    "interfaces": {
      "description": "Supported interfaces.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/AgentInterface"
      }
    },
    "max_iterations": {
      "description": "Maximum loop iterations.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "memory_ref": {
      "description": "Memory profile reference.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_ref": {
      "description": "Primary prompt reference.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_refs": {
      "description": "Additional prompt references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "protocol_profiles": {
      "description": "Protocol profiles.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProtocolProfile"
      }
    },
    "provider": {
      "description": "Provider metadata.",
      "type": "object",
      "additionalProperties": true
    },
    "security_requirements": {
      "description": "Security requirements.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_schemes": {
      "description": "Security scheme names or inline descriptors.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signatures": {
      "description": "Signature metadata.",
      "type": "object",
      "additionalProperties": true
    },
    "skill_refs": {
      "description": "Skill references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "subagent_refs": {
      "description": "Sub-agent references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "tool_refs": {
      "description": "Tool references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "AgentInterface": {
      "description": "Agent-facing interface declaration.",
      "type": "object",
      "required": [
        "mode",
        "name"
      ],
      "properties": {
        "metadata": {
          "description": "Interface metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "mode": {
          "description": "Interface mode, such as `text`, `json`, `audio`, or `tool`.",
          "type": "string"
        },
        "name": {
          "description": "Interface name.",
          "type": "string"
        },
        "schema_ref": {
          "description": "Optional schema Card reference.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CardKind": {
      "description": "Native Wyrd Card kind plus forward-compatible external catch-all.",
      "oneOf": [
        {
          "description": "Data Card.",
          "type": "string",
          "enum": [
            "Data"
          ]
        },
        {
          "description": "Model Card.",
          "type": "string",
          "enum": [
            "Model"
          ]
        },
        {
          "description": "Experiment Card.",
          "type": "string",
          "enum": [
            "Experiment"
          ]
        },
        {
          "description": "Prompt Card.",
          "type": "string",
          "enum": [
            "Prompt"
          ]
        },
        {
          "description": "Tool Card.",
          "type": "string",
          "enum": [
            "Tool"
          ]
        },
        {
          "description": "Agent Card.",
          "type": "string",
          "enum": [
            "Agent"
          ]
        },
        {
          "description": "Workflow Card.",
          "type": "string",
          "enum": [
            "Workflow"
          ]
        },
        {
          "description": "Evaluation Card.",
          "type": "string",
          "enum": [
            "Eval"
          ]
        },
        {
          "description": "Drift Card.",
          "type": "string",
          "enum": [
            "Drift"
          ]
        },
        {
          "description": "Service Card.",
          "type": "string",
          "enum": [
            "Service"
          ]
        },
        {
          "description": "Policy Card.",
          "type": "string",
          "enum": [
            "Policy"
          ]
        },
        {
          "description": "MCP Card.",
          "type": "string",
          "enum": [
            "Mcp"
          ]
        },
        {
          "description": "Skill Card.",
          "type": "string",
          "enum": [
            "Skill"
          ]
        },
        {
          "description": "Sub-agent Card.",
          "type": "string",
          "enum": [
            "SubAgent"
          ]
        },
        {
          "description": "Audit Card.",
          "type": "string",
          "enum": [
            "Audit"
          ]
        },
        {
          "description": "Artifact Card.",
          "type": "string",
          "enum": [
            "Artifact"
          ]
        },
        {
          "description": "Unknown Card kind with schema hash.",
          "type": "object",
          "required": [
            "External"
          ],
          "properties": {
            "External": {
              "type": "object",
              "required": [
                "name",
                "schema_hash"
              ],
              "properties": {
                "name": {
                  "description": "External kind name.",
                  "type": "string"
                },
                "schema_hash": {
                  "description": "32-byte schema hash.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  },
                  "maxItems": 32,
                  "minItems": 32
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space; omitted means current/default space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "ProtocolProfile": {
      "description": "Protocol-specific public metadata for an agent or service interface.",
      "type": "object",
      "required": [
        "protocol"
      ],
      "properties": {
        "metadata": {
          "description": "Protocol-specific declarative metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "protocol": {
          "description": "Protocol name, such as `a2a`, `ag_ui`, `a2ui`, `mcp`, or `http`.",
          "type": "string"
        },
        "version": {
          "description": "Protocol version.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
