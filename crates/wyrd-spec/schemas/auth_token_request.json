{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenRequest",
  "description": "Body of `POST /auth/token`.",
  "oneOf": [
    {
      "description": "Wyrd-native API key exchange.",
      "type": "object",
      "required": [
        "api_key",
        "grant_type"
      ],
      "properties": {
        "api_key": {
          "description": "API key from the deployment secret store.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "wyrd_api_key"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "RFC 8693 token exchange for agent/service delegation.",
      "type": "object",
      "required": [
        "grant_type",
        "requested_subject",
        "subject_token",
        "subject_token_type"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:token-exchange"
          ]
        },
        "requested_subject": {
          "description": "Requested non-human target principal.",
          "allOf": [
            {
              "$ref": "#/definitions/RequestedSubject"
            }
          ]
        },
        "subject_token": {
          "description": "Existing access token to delegate from.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "subject_token_type": {
          "description": "Type of `subject_token`.",
          "allOf": [
            {
              "$ref": "#/definitions/SubjectTokenType"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Human OIDC login completion.\n\nThe public completion carries only callback material. The server loads `code_verifier`, `nonce`, `redirect_uri`, issuer, and tenant from the login state keyed by `state`.",
      "type": "object",
      "required": [
        "code",
        "grant_type",
        "state"
      ],
      "properties": {
        "code": {
          "description": "Authorization code from the identity provider callback.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "authorization_code"
          ]
        },
        "state": {
          "description": "Single-use login state key generated by Wyrd.",
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Workload identity: platform-attested OIDC assertion.",
      "type": "object",
      "required": [
        "assertion",
        "grant_type"
      ],
      "properties": {
        "assertion": {
          "description": "Kubernetes service-account token, SPIFFE JWT-SVID, or cloud token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:jwt-bearer"
          ]
        },
        "tenant": {
          "description": "Tenant selector fallback when the request host does not carry tenant.",
          "anyOf": [
            {
              "$ref": "#/definitions/TenantSlug"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Wyrd refresh-token rotation.",
      "type": "object",
      "required": [
        "grant_type",
        "refresh_token"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "enum": [
            "refresh_token"
          ]
        },
        "refresh_token": {
          "description": "Signed Wyrd refresh token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "RequestedSubject": {
      "description": "Token-exchange target.",
      "oneOf": [
        {
          "description": "Target by principal id.",
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "description": "Stable principal id.",
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "enum": [
                "principal_id"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Target by card reference.",
          "type": "object",
          "required": [
            "card_ref",
            "kind"
          ],
          "properties": {
            "card_ref": {
              "description": "Service or Agent card reference.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "card_ref"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "SubjectTokenType": {
      "description": "Supported token type for RFC 8693 subject token.",
      "oneOf": [
        {
          "description": "OAuth access token.",
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:token-type:access_token"
          ]
        }
      ]
    },
    "TenantSlug": {
      "description": "Human-visible tenant slug resolved to a DataTenantId at the auth boundary.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
