{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenRequest",
  "description": "Body of `POST /auth/token`.",
  "oneOf": [
    {
      "description": "Wyrd-native API key exchange.",
      "type": "object",
      "required": [
        "api_key",
        "grant_type"
      ],
      "properties": {
        "api_key": {
          "description": "API key from the deployment secret store.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "wyrd_api_key"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "RFC 8693 token exchange: the actor acts on behalf of the subject.\n\nThe issued token names the subject as its top-level principal, the actor as the outermost `act` layer, and `audience` as its `aud`. Its authority is the intersection of both parties' permissions.",
      "type": "object",
      "required": [
        "actor_token",
        "actor_token_type",
        "audience",
        "grant_type",
        "subject_token",
        "subject_token_type"
      ],
      "properties": {
        "actor_token": {
          "description": "Wyrd access token of the party doing the work (the actor).",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "actor_token_type": {
          "description": "Type of `actor_token`.",
          "allOf": [
            {
              "$ref": "#/definitions/ExchangeTokenType"
            }
          ]
        },
        "audience": {
          "description": "Wyrd resource the delegated token is issued for.",
          "allOf": [
            {
              "$ref": "#/definitions/TokenAudience"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:token-exchange"
          ]
        },
        "subject_token": {
          "description": "Wyrd access token of the party being acted for (the subject).",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "subject_token_type": {
          "description": "Type of `subject_token`.",
          "allOf": [
            {
              "$ref": "#/definitions/ExchangeTokenType"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Human OIDC login completion.\n\nThe public completion carries only callback material. The server loads `code_verifier`, `nonce`, `redirect_uri`, issuer, and tenant from the login state keyed by `state`.",
      "type": "object",
      "required": [
        "code",
        "grant_type",
        "state"
      ],
      "properties": {
        "code": {
          "description": "Authorization code from the identity provider callback.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "authorization_code"
          ]
        },
        "state": {
          "description": "Single-use login state key generated by Wyrd.",
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Workload identity: platform-attested OIDC assertion.",
      "type": "object",
      "required": [
        "assertion",
        "grant_type"
      ],
      "properties": {
        "assertion": {
          "description": "Kubernetes service-account token, SPIFFE JWT-SVID, or cloud token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:jwt-bearer"
          ]
        },
        "tenant": {
          "description": "Tenant selector fallback when the request host does not carry tenant.",
          "anyOf": [
            {
              "$ref": "#/definitions/TenantSlug"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Wyrd refresh-token rotation.",
      "type": "object",
      "required": [
        "grant_type",
        "refresh_token"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "enum": [
            "refresh_token"
          ]
        },
        "refresh_token": {
          "description": "Signed Wyrd refresh token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ExchangeTokenType": {
      "description": "Supported RFC 8693 token type for a subject or actor token.",
      "oneOf": [
        {
          "description": "OAuth access token.",
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:token-type:access_token"
          ]
        }
      ]
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    },
    "TenantSlug": {
      "description": "Human-visible tenant slug resolved to a DataTenantId at the auth boundary.",
      "type": "string"
    },
    "TokenAudience": {
      "description": "Audience (`aud`) of a Wyrd tenant access token.\n\nEvery directly issued token is [`Self::Wyrd`] and is accepted on every tenant surface. A [`Self::Bifrost`] token is accepted only on the Bifrost surfaces, so a token delegated for Bifrost cannot be replayed elsewhere.",
      "oneOf": [
        {
          "description": "Every Wyrd tenant surface.",
          "type": "string",
          "enum": [
            "wyrd"
          ]
        },
        {
          "description": "Only the Bifrost ingest and query surfaces.",
          "type": "string",
          "enum": [
            "bifrost"
          ]
        }
      ]
    }
  }
}
