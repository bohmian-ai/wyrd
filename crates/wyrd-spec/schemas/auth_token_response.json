{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenResponse",
  "description": "RFC 6749 §5.1 successful token response.",
  "type": "object",
  "required": [
    "access_token",
    "expires_in",
    "token_type"
  ],
  "properties": {
    "access_token": {
      "description": "Signed Wyrd access token.",
      "allOf": [
        {
          "$ref": "#/definitions/SecretBearer"
        }
      ]
    },
    "expires_in": {
      "description": "Seconds until the access token expires.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "issued_token_type": {
      "description": "RFC 8693 §2.2.1 type of the issued token; present on token-exchange responses.",
      "anyOf": [
        {
          "$ref": "#/definitions/ExchangeTokenType"
        },
        {
          "type": "null"
        }
      ]
    },
    "refresh_token": {
      "description": "Refresh token. Issued only for a human session: at authorization-code and device-code redemption, and when `wyrd-cli` rotates its refresh token. `wyrd-ui` keeps presenting its original refresh token, and no machine grant issues one: those clients re-present their durable credential instead.",
      "anyOf": [
        {
          "$ref": "#/definitions/SecretBearer"
        },
        {
          "type": "null"
        }
      ]
    },
    "token_type": {
      "description": "Token type.",
      "allOf": [
        {
          "$ref": "#/definitions/TokenType"
        }
      ]
    }
  },
  "definitions": {
    "ExchangeTokenType": {
      "description": "RFC 8693 §3 token type of a subject, actor, or issued token.",
      "oneOf": [
        {
          "description": "OAuth access token.",
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:token-type:access_token"
          ]
        },
        {
          "description": "A Wyrd API key (`wyrd_sk_…`) or platform credential.",
          "type": "string",
          "enum": [
            "urn:wyrd:oauth:token-type:api_key"
          ]
        }
      ]
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    },
    "TokenType": {
      "description": "Bearer token marker.",
      "oneOf": [
        {
          "description": "Bearer token.",
          "type": "string",
          "enum": [
            "Bearer"
          ]
        }
      ]
    }
  }
}
