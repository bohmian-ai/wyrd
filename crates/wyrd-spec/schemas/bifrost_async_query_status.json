{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AsyncQueryStatus",
  "description": "Status of a previously-submitted async query job.",
  "type": "object",
  "required": [
    "executor_availability",
    "job_uid",
    "state"
  ],
  "properties": {
    "error_code": {
      "description": "Stable Wyrd error code on failure (review M-15).",
      "type": [
        "string",
        "null"
      ]
    },
    "error_detail": {
      "description": "Sanitized error detail on failure.",
      "type": [
        "string",
        "null"
      ]
    },
    "executor_availability": {
      "description": "Executor-availability signal — `PendingStage5` in Stage 3 (review M-06).",
      "allOf": [
        {
          "$ref": "#/definitions/ExecutorAvailability"
        }
      ]
    },
    "job_uid": {
      "description": "Job id.",
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "description": "Current job state.",
      "allOf": [
        {
          "$ref": "#/definitions/AsyncJobState"
        }
      ]
    }
  },
  "definitions": {
    "AsyncJobState": {
      "description": "Terminal/in-flight state of an async query job.",
      "oneOf": [
        {
          "description": "Accepted, not yet claimed by an executor.",
          "type": "string",
          "enum": [
            "Queued"
          ]
        },
        {
          "description": "Claimed by an executor.",
          "type": "string",
          "enum": [
            "Claimed"
          ]
        },
        {
          "description": "Executing.",
          "type": "string",
          "enum": [
            "Running"
          ]
        },
        {
          "description": "Completed successfully.",
          "type": "string",
          "enum": [
            "Succeeded"
          ]
        },
        {
          "description": "Failed.",
          "type": "string",
          "enum": [
            "Failed"
          ]
        },
        {
          "description": "Canceled.",
          "type": "string",
          "enum": [
            "Canceled"
          ]
        }
      ]
    },
    "ExecutorAvailability": {
      "description": "Machine-readable executor-availability signal (review M-06). In Stage 3 a queued job is accepted but its executor does not exist yet, so status carries [`ExecutorAvailability::PendingStage5`] rather than a false \"running\" claim.",
      "oneOf": [
        {
          "description": "An executor is available (Stage 5+).",
          "type": "string",
          "enum": [
            "Available"
          ]
        },
        {
          "description": "No executor exists yet — the job is accepted but will not run until Stage 5.",
          "type": "string",
          "enum": [
            "PendingStage5"
          ]
        }
      ]
    }
  }
}
