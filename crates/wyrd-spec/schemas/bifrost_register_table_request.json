{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterTableRequest",
  "description": "Register (create) a Bifrost table.",
  "type": "object",
  "required": [
    "fields",
    "name",
    "namespace"
  ],
  "properties": {
    "fields": {
      "description": "User fields only; `wyrd_*`/`card_ref`/`run_id` reserved names are rejected.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/FieldSpec"
      }
    },
    "name": {
      "description": "Table name.",
      "type": "string"
    },
    "namespace": {
      "description": "Target namespace.",
      "type": "string"
    },
    "physical_layout": {
      "description": "Optional physical layout declaration.\n\nOmitting the field entirely resolves to `hour(wyrd_event_time)`, the default sort, and the managed Bloom floor. Supplying the object requires `partition`; within it, an explicit empty `sort_keys` means \"tenant prefix only\" and an explicit empty `bloom_columns` means \"managed floor only\".",
      "anyOf": [
        {
          "$ref": "#/definitions/PhysicalLayoutWire"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "DataTypeSpec": {
      "description": "Arrow-free logical column type. The exhaustive set Bifrost accepts on the register path; the `DataTypeSpec ↔ arrow::DataType` conversion lives in the server/engine, never in `wyrd-spec`.",
      "oneOf": [
        {
          "description": "Boolean.",
          "type": "string",
          "enum": [
            "Bool"
          ]
        },
        {
          "description": "Signed 8-bit integer.",
          "type": "string",
          "enum": [
            "Int8"
          ]
        },
        {
          "description": "Signed 16-bit integer.",
          "type": "string",
          "enum": [
            "Int16"
          ]
        },
        {
          "description": "Signed 32-bit integer.",
          "type": "string",
          "enum": [
            "Int32"
          ]
        },
        {
          "description": "Signed 64-bit integer.",
          "type": "string",
          "enum": [
            "Int64"
          ]
        },
        {
          "description": "Unsigned 8-bit integer.",
          "type": "string",
          "enum": [
            "UInt8"
          ]
        },
        {
          "description": "Unsigned 16-bit integer.",
          "type": "string",
          "enum": [
            "UInt16"
          ]
        },
        {
          "description": "Unsigned 32-bit integer.",
          "type": "string",
          "enum": [
            "UInt32"
          ]
        },
        {
          "description": "Unsigned 64-bit integer.",
          "type": "string",
          "enum": [
            "UInt64"
          ]
        },
        {
          "description": "32-bit float.",
          "type": "string",
          "enum": [
            "Float32"
          ]
        },
        {
          "description": "64-bit float.",
          "type": "string",
          "enum": [
            "Float64"
          ]
        },
        {
          "description": "UTF-8 string.",
          "type": "string",
          "enum": [
            "Utf8"
          ]
        },
        {
          "description": "Large UTF-8 string.",
          "type": "string",
          "enum": [
            "LargeUtf8"
          ]
        },
        {
          "description": "Variable-length binary.",
          "type": "string",
          "enum": [
            "Binary"
          ]
        },
        {
          "description": "Large variable-length binary.",
          "type": "string",
          "enum": [
            "LargeBinary"
          ]
        },
        {
          "description": "Fixed-width binary.",
          "type": "object",
          "required": [
            "FixedSizeBinary"
          ],
          "properties": {
            "FixedSizeBinary": {
              "type": "object",
              "required": [
                "len"
              ],
              "properties": {
                "len": {
                  "description": "Byte width.",
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "32-bit date (days since epoch).",
          "type": "string",
          "enum": [
            "Date32"
          ]
        },
        {
          "description": "64-bit date (milliseconds since epoch).",
          "type": "string",
          "enum": [
            "Date64"
          ]
        },
        {
          "description": "Timestamp with explicit precision and optional timezone.",
          "type": "object",
          "required": [
            "Timestamp"
          ],
          "properties": {
            "Timestamp": {
              "type": "object",
              "required": [
                "unit"
              ],
              "properties": {
                "tz": {
                  "description": "IANA timezone string, or `None` for timezone-naive.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "description": "Precision.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/TimeUnit"
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Time-of-day at second/millisecond precision.",
          "type": "object",
          "required": [
            "Time32"
          ],
          "properties": {
            "Time32": {
              "type": "object",
              "required": [
                "unit"
              ],
              "properties": {
                "unit": {
                  "description": "Precision.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/TimeUnit"
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Time-of-day at microsecond/nanosecond precision.",
          "type": "object",
          "required": [
            "Time64"
          ],
          "properties": {
            "Time64": {
              "type": "object",
              "required": [
                "unit"
              ],
              "properties": {
                "unit": {
                  "description": "Precision.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/TimeUnit"
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "128-bit fixed-point decimal.",
          "type": "object",
          "required": [
            "Decimal128"
          ],
          "properties": {
            "Decimal128": {
              "type": "object",
              "required": [
                "precision",
                "scale"
              ],
              "properties": {
                "precision": {
                  "description": "Total number of digits.",
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                "scale": {
                  "description": "Number of fractional digits.",
                  "type": "integer",
                  "format": "int8"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Variable-length list of a single element type.",
          "type": "object",
          "required": [
            "List"
          ],
          "properties": {
            "List": {
              "$ref": "#/definitions/DataTypeSpec"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Nested struct of named fields.",
          "type": "object",
          "required": [
            "Struct"
          ],
          "properties": {
            "Struct": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldSpec"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FieldSpec": {
      "description": "Arrow-free field declaration. Follows the `card::field::FieldSpec` precedent but carries a typed [`DataTypeSpec`] instead of a loose dtype string.",
      "type": "object",
      "required": [
        "data_type",
        "name"
      ],
      "properties": {
        "data_type": {
          "description": "Logical column type.",
          "allOf": [
            {
              "$ref": "#/definitions/DataTypeSpec"
            }
          ]
        },
        "metadata": {
          "description": "String metadata. Bifrost describe uses the `wyrd:column_class` key to flag `correlation` columns distinctly from user columns.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "nullable": {
          "description": "Whether the column is nullable. Defaults to `true`.",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "NullOrderWire": {
      "description": "Null placement of one declared physical sort key.",
      "oneOf": [
        {
          "description": "Nulls sort before non-null values.",
          "type": "string",
          "enum": [
            "first"
          ]
        },
        {
          "description": "Nulls sort after non-null values.",
          "type": "string",
          "enum": [
            "last"
          ]
        }
      ]
    },
    "PhysicalLayoutWire": {
      "description": "The authoritative physical layout of one Bifrost table.\n\nThe same shape is used three ways: as the optional declaration on [`RegisterTableRequest`], as the canonical server-resolved layout returned by [`BifrostTableDescription`], and as the exact JSON persisted in the control row. In the latter two it is always fully populated: the canonical sort order begins with the injected `data_tenant_id` prefix and the Bloom list begins with the schema-present managed floor.\n\nOn the request path, an omitted `sort_keys` and an explicit empty `sort_keys` mean different things — see [`RegisterTableRequest`].",
      "type": "object",
      "required": [
        "partition"
      ],
      "properties": {
        "bloom_columns": {
          "description": "Ordered Bloom-filtered columns.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partition": {
          "description": "Required time partition.",
          "allOf": [
            {
              "$ref": "#/definitions/TimePartitionSpecWire"
            }
          ]
        },
        "sort_keys": {
          "description": "Ordered sort keys.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/SortKeyWire"
          }
        }
      }
    },
    "SortDirectionWire": {
      "description": "Sort direction of one declared physical sort key.",
      "oneOf": [
        {
          "description": "Ascending.",
          "type": "string",
          "enum": [
            "asc"
          ]
        },
        {
          "description": "Descending.",
          "type": "string",
          "enum": [
            "desc"
          ]
        }
      ]
    },
    "SortKeyWire": {
      "description": "One declared physical sort key.",
      "type": "object",
      "required": [
        "column",
        "direction",
        "null_order"
      ],
      "properties": {
        "column": {
          "description": "Sorted column; must exist in the complete physical schema.",
          "type": "string"
        },
        "direction": {
          "description": "Sort direction.",
          "allOf": [
            {
              "$ref": "#/definitions/SortDirectionWire"
            }
          ]
        },
        "null_order": {
          "description": "Null placement.",
          "allOf": [
            {
              "$ref": "#/definitions/NullOrderWire"
            }
          ]
        }
      }
    },
    "TimeGranularityWire": {
      "description": "Time-partition granularity on the wire.\n\nBifrost v1 partitions every table on `wyrd_event_time` and admits exactly these two Iceberg-native transforms; nothing else is representable.",
      "oneOf": [
        {
          "description": "One partition per UTC hour.",
          "type": "string",
          "enum": [
            "hour"
          ]
        },
        {
          "description": "One partition per UTC day.",
          "type": "string",
          "enum": [
            "day"
          ]
        }
      ]
    },
    "TimePartitionSpecWire": {
      "description": "The single time-partition declaration of a Bifrost table.\n\n`column` must be `wyrd_event_time`; it is carried explicitly so the wire contract stays self-describing and generated SDKs do not have to assume the invariant.",
      "type": "object",
      "required": [
        "column",
        "granularity"
      ],
      "properties": {
        "column": {
          "description": "Partitioned column; only `wyrd_event_time` is accepted.",
          "type": "string"
        },
        "granularity": {
          "description": "Partition granularity.",
          "allOf": [
            {
              "$ref": "#/definitions/TimeGranularityWire"
            }
          ]
        }
      }
    },
    "TimeUnit": {
      "description": "Timestamp / time precision. Arrow-free mirror of `arrow::datatypes::TimeUnit`.",
      "oneOf": [
        {
          "description": "Seconds.",
          "type": "string",
          "enum": [
            "Second"
          ]
        },
        {
          "description": "Milliseconds.",
          "type": "string",
          "enum": [
            "Millisecond"
          ]
        },
        {
          "description": "Microseconds — the canonical Bifrost physical timestamp precision.",
          "type": "string",
          "enum": [
            "Microsecond"
          ]
        },
        {
          "description": "Nanoseconds — a caller may name it, but Bifrost coerces to microseconds.",
          "type": "string",
          "enum": [
            "Nanosecond"
          ]
        }
      ]
    }
  }
}
