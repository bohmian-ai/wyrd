{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card",
  "description": "Universal registered Card envelope.",
  "type": "object",
  "required": [
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "description": "API version. Must be `wyrd/v1` for v1 Cards.",
      "default": "wyrd/v1",
      "allOf": [
        {
          "$ref": "#/definitions/ApiVersion"
        }
      ]
    },
    "kind": {
      "description": "Card kind discriminator.",
      "allOf": [
        {
          "$ref": "#/definitions/CardKind"
        }
      ]
    },
    "metadata": {
      "description": "Card metadata.",
      "allOf": [
        {
          "$ref": "#/definitions/Metadata"
        }
      ]
    },
    "relationships": {
      "description": "Server-derived relationship summary.",
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/Relationships"
        }
      ]
    },
    "spec": {
      "description": "Kind-specific spec payload."
    },
    "status": {
      "description": "Optional server-derived status.",
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "AnnotationValue": {
      "description": "Validated value for free-form Card annotations.",
      "type": "string"
    },
    "ApiVersion": {
      "description": "Canonical Wyrd API version.",
      "type": "string"
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source",
        "External"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "LabelValue": {
      "description": "Validated value for queryable Card and Run labels.",
      "type": "string"
    },
    "Metadata": {
      "description": "Card metadata common to every kind.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "annotations": {
          "description": "Free-form annotations for automation, UI, and integration metadata.\n\nAs of 2026-05-18, keys under `wyrd.io/*` MUST remain reserved for Wyrd-owned runtime and registry metadata. User and vendor annotations MUST use another DNS-style prefix, such as `acme.com/cost-center`, to avoid collisions.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AnnotationValue"
          }
        },
        "artifact_hash": {
          "description": "Artifact content hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "description": "Display labels.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/LabelValue"
          }
        },
        "name": {
          "description": "Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_hash": {
          "description": "Spec content hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "Relationships": {
      "description": "Server-derived relationship summary for graph, UI, policy, imports, and diff.",
      "type": "object",
      "properties": {
        "inbound": {
          "description": "Inbound references as normalized display strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outbound": {
          "description": "Outbound references as normalized display strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "Status": {
      "description": "Server-derived Card status.",
      "type": "object",
      "required": [
        "phase"
      ],
      "properties": {
        "message": {
          "description": "Human-readable status message.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "description": "Lifecycle phase such as `draft`, `active`, or `deprecated`.",
          "type": "string"
        },
        "updated_at": {
          "description": "Last status update timestamp.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
