{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardKind",
  "description": "Native Wyrd Card kind string or external kind object.",
  "oneOf": [
    {
      "title": "NativeCardKind",
      "description": "Native Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Tool",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Skill",
        "SubAgent",
        "Audit",
        "Artifact"
      ]
    },
    {
      "title": "ExternalCardKind",
      "description": "External Card kind with schema hash.",
      "type": "object",
      "required": [
        "kind",
        "schema_hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "schema_hash": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  ]
}
