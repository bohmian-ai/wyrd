{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardUploadPlan",
  "description": "Upload plan group keyed by the resolved card reference.",
  "type": "object",
  "required": [
    "card_ref",
    "entries"
  ],
  "properties": {
    "card_ref": {
      "description": "Card whose submission declared the artifact manifest.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "entries": {
      "description": "One presigned upload per manifest entry.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PresignedUpload"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "HttpMethod": {
      "description": "HTTP method permitted for a presigned upload.",
      "oneOf": [
        {
          "description": "Upload bytes with a single PUT request.",
          "type": "string",
          "enum": [
            "PUT"
          ]
        }
      ]
    },
    "PresignedUpload": {
      "description": "One tenant-scoped, single-artifact presigned upload.",
      "type": "object",
      "required": [
        "expires_at",
        "method",
        "relative_path",
        "url"
      ],
      "properties": {
        "expires_at": {
          "description": "URL expiration instant.",
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "description": "Only `PUT` is legal for v1 artifact uploads.",
          "allOf": [
            {
              "$ref": "#/definitions/HttpMethod"
            }
          ]
        },
        "relative_path": {
          "description": "Manifest path this URL accepts.",
          "type": "string"
        },
        "required_headers": {
          "description": "Headers required by the storage provider.",
          "default": [],
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "url": {
          "description": "Presigned PUT URL.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
