{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateCardResponse",
  "description": "Server response to card creation.",
  "type": "object",
  "required": [
    "card_uid",
    "created_at",
    "kind",
    "name",
    "outcome",
    "space",
    "spec_hash",
    "status",
    "version"
  ],
  "properties": {
    "artifact_hash": {
      "description": "BLAKE3-hex hash of the JCS canonical manifest.",
      "type": [
        "string",
        "null"
      ]
    },
    "card_uid": {
      "description": "Resolved card UID.",
      "allOf": [
        {
          "$ref": "#/definitions/CardUid"
        }
      ]
    },
    "created_at": {
      "description": "Creation timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "description": "Resolved kind.",
      "allOf": [
        {
          "$ref": "#/definitions/CardKind"
        }
      ]
    },
    "name": {
      "description": "Resolved name.",
      "allOf": [
        {
          "$ref": "#/definitions/CardName"
        }
      ]
    },
    "operation_id": {
      "description": "Pending operation id.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "outcome": {
      "description": "Registration result.",
      "allOf": [
        {
          "$ref": "#/definitions/RegisterOutcome"
        }
      ]
    },
    "principal_id": {
      "description": "Principal attributed to the operation.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "space": {
      "description": "Resolved workspace.",
      "allOf": [
        {
          "$ref": "#/definitions/SpaceName"
        }
      ]
    },
    "spec_hash": {
      "description": "BLAKE3-hex hash of JCS canonical spec bytes.",
      "type": "string"
    },
    "status": {
      "description": "Server-managed lifecycle status.",
      "allOf": [
        {
          "$ref": "#/definitions/CardLifecycleStatus"
        }
      ]
    },
    "uploads": {
      "description": "Upload plans for artifacts that still need bytes.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/UploadInitResponse"
      }
    },
    "version": {
      "description": "Resolved version.",
      "allOf": [
        {
          "$ref": "#/definitions/VersionBlock"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardLifecycleStatus": {
      "description": "Server-managed lifecycle state for a Card.",
      "oneOf": [
        {
          "description": "Registration is waiting for artifact upload and verification.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Card is available for use.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Card has been superseded by a newer version.",
          "type": "string",
          "enum": [
            "deprecated"
          ]
        },
        {
          "description": "Registration failed and awaits cleanup or retry.",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "Registration expired before completion.",
          "type": "string",
          "enum": [
            "expired"
          ]
        },
        {
          "description": "Card was soft-deleted.",
          "type": "string",
          "enum": [
            "deleted"
          ]
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "HeaderPair": {
      "description": "Required HTTP header for a client upload request.",
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "description": "Header name.",
          "type": "string"
        },
        "value": {
          "description": "Header value.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RegisterOutcome": {
      "description": "Result of a registration write.",
      "oneOf": [
        {
          "description": "A new registration row was created.",
          "type": "string",
          "enum": [
            "created"
          ]
        },
        {
          "description": "The same idempotent request was replayed.",
          "type": "string",
          "enum": [
            "idempotent_noop"
          ]
        },
        {
          "description": "An active card with identical content already exists.",
          "type": "string",
          "enum": [
            "deduplicated"
          ]
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "StorageBackendKind": {
      "description": "Object-storage backend configured for artifact bytes.",
      "oneOf": [
        {
          "description": "Local filesystem storage.",
          "type": "string",
          "enum": [
            "local"
          ]
        },
        {
          "description": "AWS S3 or compatible object storage.",
          "type": "string",
          "enum": [
            "s3"
          ]
        },
        {
          "description": "Google Cloud Storage.",
          "type": "string",
          "enum": [
            "gcs"
          ]
        },
        {
          "description": "Azure Blob Storage.",
          "type": "string",
          "enum": [
            "azure"
          ]
        }
      ]
    },
    "UploadInitResponse": {
      "description": "Server response to an upload-init request.",
      "type": "object",
      "required": [
        "backend",
        "plan",
        "storage_path",
        "upload_id"
      ],
      "properties": {
        "backend": {
          "description": "Configured storage backend.",
          "allOf": [
            {
              "$ref": "#/definitions/StorageBackendKind"
            }
          ]
        },
        "plan": {
          "description": "Backend-specific upload plan.",
          "allOf": [
            {
              "$ref": "#/definitions/UploadPlan"
            }
          ]
        },
        "storage_path": {
          "description": "Full tenant-scoped storage path.",
          "type": "string"
        },
        "upload_id": {
          "description": "Durable upload identifier.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "UploadPlan": {
      "description": "Tagged union describing how the client uploads bytes.",
      "oneOf": [
        {
          "description": "Single PUT to a presigned URL.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "put_url",
                "ttl_secs"
              ],
              "properties": {
                "put_url": {
                  "description": "Presigned PUT URL.",
                  "type": "string"
                },
                "required_headers": {
                  "description": "Headers the client must include on the PUT.",
                  "default": [],
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HeaderPair"
                  }
                },
                "ttl_secs": {
                  "description": "URL time-to-live in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "single_put"
              ]
            }
          }
        },
        {
          "description": "Local filesystem auth-gated upload.\n\nSignals that the upload URL is an auth-gated server route, not a presigned PUT. SDK clients must include `Authorization: Bearer` and `x-wyrd-data-tenant-id` on the PUT request.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "put_url",
                "ttl_secs"
              ],
              "properties": {
                "put_url": {
                  "description": "Server route PUT URL.",
                  "type": "string"
                },
                "ttl_secs": {
                  "description": "URL time-to-live in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "local_fs"
              ]
            }
          }
        },
        {
          "description": "AWS S3 multipart upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "part_count",
                "part_size_bytes",
                "part_url_ttl_secs"
              ],
              "properties": {
                "part_count": {
                  "description": "Number of parts planned.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "part_size_bytes": {
                  "description": "Size of each non-final part.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "part_url_ttl_secs": {
                  "description": "Time-to-live for per-part URLs in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "required_headers": {
                  "description": "Headers the client must include on each part PUT.",
                  "default": [],
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HeaderPair"
                  }
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "s3_multipart"
              ]
            }
          }
        },
        {
          "description": "Google Cloud Storage resumable upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "chunk_size_bytes",
                "session_uri"
              ],
              "properties": {
                "chunk_size_bytes": {
                  "description": "Recommended chunk size in bytes.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "session_uri": {
                  "description": "Resumable session URI returned once to the client.",
                  "type": "string"
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "gcs_resumable"
              ]
            }
          }
        },
        {
          "description": "Azure block blob upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "block_count_planned",
                "block_size_bytes",
                "sas_url"
              ],
              "properties": {
                "block_count_planned": {
                  "description": "Number of blocks the server expects to commit.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "block_size_bytes": {
                  "description": "Recommended block size in bytes.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "sas_url": {
                  "description": "SAS URL returned once to the client.",
                  "type": "string"
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "azure_block_blob"
              ]
            }
          }
        }
      ]
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
