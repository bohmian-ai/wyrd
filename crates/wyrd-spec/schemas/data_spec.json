{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataSpec",
  "description": "Pure-data contract for a Data Card.",
  "type": "object",
  "required": [
    "interface",
    "schema",
    "stats"
  ],
  "properties": {
    "card_refs": {
      "description": "Durable Artifact card references linked to this data card.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Ref"
      }
    },
    "interface": {
      "description": "Declared interface family and interface-specific metadata.",
      "allOf": [
        {
          "$ref": "#/definitions/DataInterface"
        }
      ]
    },
    "schema": {
      "description": "Ordered schema fields for tabular interfaces.",
      "allOf": [
        {
          "$ref": "#/definitions/DataSchema"
        }
      ]
    },
    "splits": {
      "description": "Declared split strategies by stable split label.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/DataSplit"
      }
    },
    "sql": {
      "description": "Optional SQL query bundle for SQL-backed data.",
      "anyOf": [
        {
          "$ref": "#/definitions/SqlLogic"
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "description": "Local or durable byte statistics captured for this data source.",
      "allOf": [
        {
          "$ref": "#/definitions/DataStats"
        }
      ]
    },
    "target_columns": {
      "description": "Target columns for supervised workflows.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ColumnName"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ArrowFormat": {
      "description": "Arrow serialization formats accepted by DataCard.",
      "oneOf": [
        {
          "description": "Arrow IPC file or stream.",
          "type": "string",
          "enum": [
            "Ipc"
          ]
        },
        {
          "description": "Parquet output through Arrow.",
          "type": "string",
          "enum": [
            "Parquet"
          ]
        }
      ]
    },
    "ArrowMeta": {
      "description": "Arrow interface metadata.",
      "type": "object",
      "required": [
        "format",
        "framework_version"
      ],
      "properties": {
        "format": {
          "description": "Arrow serialization format.",
          "allOf": [
            {
              "$ref": "#/definitions/ArrowFormat"
            }
          ]
        },
        "framework_version": {
          "description": "Installed pyarrow version inferred by the Python boundary.",
          "type": "string"
        }
      }
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "ColValue": {
      "description": "Literal value used by a column split predicate.",
      "anyOf": [
        {
          "description": "Signed integer predicate value.",
          "type": "integer",
          "format": "int64"
        },
        {
          "description": "Floating-point predicate value.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "String predicate value.",
          "type": "string"
        },
        {
          "description": "Boolean predicate value.",
          "type": "boolean"
        },
        {
          "description": "UTC timestamp predicate value.",
          "type": "string",
          "format": "date-time"
        },
        {
          "description": "List predicate value used by membership checks.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ColValue"
          }
        }
      ]
    },
    "ColorMode": {
      "description": "Image color mode accepted by DataCard image manifests.",
      "oneOf": [
        {
          "description": "RGB color.",
          "type": "string",
          "enum": [
            "Rgb"
          ]
        },
        {
          "description": "RGBA color with alpha.",
          "type": "string",
          "enum": [
            "Rgba"
          ]
        },
        {
          "description": "Single-channel grayscale.",
          "type": "string",
          "enum": [
            "Grayscale"
          ]
        }
      ]
    },
    "ColumnName": {
      "description": "DataCard column name.",
      "type": "string"
    },
    "CustomDataMeta": {
      "description": "Custom Python loader metadata.",
      "type": "object",
      "required": [
        "loader_class",
        "loader_module"
      ],
      "properties": {
        "extra": {
          "description": "Loader-specific string options.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "loader_class": {
          "description": "Python loader class name.",
          "type": "string"
        },
        "loader_module": {
          "description": "Importable Python module containing the loader class.",
          "type": "string"
        }
      }
    },
    "DataInterface": {
      "description": "Data source interface metadata.",
      "oneOf": [
        {
          "description": "Pandas dataframe saved as parquet by default.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Pandas"
              ]
            },
            "meta": {
              "$ref": "#/definitions/PandasMeta"
            }
          }
        },
        {
          "description": "Polars dataframe saved as parquet by default.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Polars"
              ]
            },
            "meta": {
              "$ref": "#/definitions/PolarsMeta"
            }
          }
        },
        {
          "description": "PyArrow table saved as IPC or parquet.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Arrow"
              ]
            },
            "meta": {
              "$ref": "#/definitions/ArrowMeta"
            }
          }
        },
        {
          "description": "Existing parquet dataset or file.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Parquet"
              ]
            },
            "meta": {
              "$ref": "#/definitions/ParquetMeta"
            }
          }
        },
        {
          "description": "NumPy array saved as NPY or NPZ.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Numpy"
              ]
            },
            "meta": {
              "$ref": "#/definitions/NumpyMeta"
            }
          }
        },
        {
          "description": "Torch tensor saved as safetensors or explicit pickle.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Torch"
              ]
            },
            "meta": {
              "$ref": "#/definitions/TorchMeta"
            }
          }
        },
        {
          "description": "SQL query bundle.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Sql"
              ]
            },
            "meta": {
              "$ref": "#/definitions/SqlMeta"
            }
          }
        },
        {
          "description": "JSON Lines data.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Jsonl"
              ]
            },
            "meta": {
              "$ref": "#/definitions/JsonlMeta"
            }
          }
        },
        {
          "description": "Image manifest data.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Image"
              ]
            },
            "meta": {
              "$ref": "#/definitions/ImageMeta"
            }
          }
        },
        {
          "description": "Text manifest data.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Text"
              ]
            },
            "meta": {
              "$ref": "#/definitions/TextMeta"
            }
          }
        },
        {
          "description": "Hugging Face dataset pointer or local dataset.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Huggingface"
              ]
            },
            "meta": {
              "$ref": "#/definitions/HuggingfaceMeta"
            }
          }
        },
        {
          "description": "Custom Python data loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Custom"
              ]
            },
            "meta": {
              "$ref": "#/definitions/CustomDataMeta"
            }
          }
        }
      ]
    },
    "DataSchema": {
      "description": "Ordered data schema for DataCard interfaces.",
      "type": "object",
      "properties": {
        "columns": {
          "description": "Ordered columns; column order is part of the Wyrd contract.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldSpec"
          }
        }
      }
    },
    "DataSplit": {
      "description": "Named DataCard split declaration.",
      "type": "object",
      "required": [
        "label",
        "strategy"
      ],
      "properties": {
        "label": {
          "description": "Stable split label, repeated to protect hand-authored map entries from drift.",
          "allOf": [
            {
              "$ref": "#/definitions/SplitName"
            }
          ]
        },
        "strategy": {
          "description": "Split strategy declaration.",
          "allOf": [
            {
              "$ref": "#/definitions/SplitStrategy"
            }
          ]
        }
      }
    },
    "DataStats": {
      "description": "Storage and byte-level statistics for a DataCard source.",
      "type": "object",
      "required": [
        "byte_count",
        "sha256"
      ],
      "properties": {
        "byte_count": {
          "description": "Number of bytes represented by this data artifact or source.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "col_count": {
          "description": "Optional column count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "row_count": {
          "description": "Optional row count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "sha256": {
          "description": "Lowercase SHA-256 hex digest for the represented bytes.",
          "type": "string"
        }
      }
    },
    "Dim": {
      "description": "One dimension in a field shape.",
      "oneOf": [
        {
          "description": "A fixed, known dimension length.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Fixed"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "description": "A dynamic dimension, optionally named for documentation and signatures.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Dynamic"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "FieldSpec": {
      "description": "Ordered field declaration used by Wyrd data schemas and model signatures.",
      "type": "object",
      "required": [
        "dtype",
        "name"
      ],
      "properties": {
        "dtype": {
          "description": "Canonical Arrow logical dtype string.",
          "type": "string"
        },
        "extra": {
          "description": "Additional string metadata that does not change the Wyrd field contract.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "description": "Canonical column or feature name.",
          "allOf": [
            {
              "$ref": "#/definitions/ColumnName"
            }
          ]
        },
        "nullable": {
          "description": "Whether this field may contain null values.",
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "description": "Optional tensor or nested value shape; empty means scalar/tabular.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Dim"
          }
        }
      }
    },
    "HuggingfaceMeta": {
      "description": "Hugging Face dataset interface metadata.",
      "type": "object",
      "required": [
        "dataset_id"
      ],
      "properties": {
        "config": {
          "description": "Optional dataset config.",
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_id": {
          "description": "Dataset identifier.",
          "type": "string"
        },
        "revision": {
          "description": "Optional pinned git revision, represented as a 7- to 40-char lowercase hex SHA.",
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "description": "Optional dataset split.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ImageFormat": {
      "description": "Image format family accepted by DataCard image manifests.",
      "oneOf": [
        {
          "description": "PNG images.",
          "type": "string",
          "enum": [
            "Png"
          ]
        },
        {
          "description": "JPEG images.",
          "type": "string",
          "enum": [
            "Jpeg"
          ]
        },
        {
          "description": "WebP images.",
          "type": "string",
          "enum": [
            "Webp"
          ]
        },
        {
          "description": "Mixed image formats.",
          "type": "string",
          "enum": [
            "Mixed"
          ]
        }
      ]
    },
    "ImageMeta": {
      "description": "Image manifest interface metadata.",
      "type": "object",
      "required": [
        "color_mode",
        "format"
      ],
      "properties": {
        "color_mode": {
          "description": "Image color mode.",
          "allOf": [
            {
              "$ref": "#/definitions/ColorMode"
            }
          ]
        },
        "format": {
          "description": "Image file format family.",
          "allOf": [
            {
              "$ref": "#/definitions/ImageFormat"
            }
          ]
        },
        "manifest_ref": {
          "description": "Optional manifest Artifact card reference.",
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Inequality": {
      "description": "Predicate operator for a column split.",
      "oneOf": [
        {
          "description": "Equality comparison.",
          "type": "string",
          "enum": [
            "Eq"
          ]
        },
        {
          "description": "Inequality comparison.",
          "type": "string",
          "enum": [
            "Ne"
          ]
        },
        {
          "description": "Greater-than comparison.",
          "type": "string",
          "enum": [
            "Gt"
          ]
        },
        {
          "description": "Greater-than-or-equal comparison.",
          "type": "string",
          "enum": [
            "Ge"
          ]
        },
        {
          "description": "Less-than comparison.",
          "type": "string",
          "enum": [
            "Lt"
          ]
        },
        {
          "description": "Less-than-or-equal comparison.",
          "type": "string",
          "enum": [
            "Le"
          ]
        },
        {
          "description": "Membership comparison.",
          "type": "string",
          "enum": [
            "In"
          ]
        }
      ]
    },
    "JsonlCompression": {
      "description": "JSONL compression choices accepted by DataCard.",
      "oneOf": [
        {
          "description": "No compression.",
          "type": "string",
          "enum": [
            "None"
          ]
        },
        {
          "description": "Gzip compression.",
          "type": "string",
          "enum": [
            "Gzip"
          ]
        },
        {
          "description": "Zstandard compression.",
          "type": "string",
          "enum": [
            "Zstd"
          ]
        }
      ]
    },
    "JsonlMeta": {
      "description": "JSON Lines interface metadata.",
      "type": "object",
      "required": [
        "compression"
      ],
      "properties": {
        "compression": {
          "description": "JSONL compression.",
          "allOf": [
            {
              "$ref": "#/definitions/JsonlCompression"
            }
          ]
        },
        "lines_per_file": {
          "description": "Optional number of lines written per local file.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "NumpyFormat": {
      "description": "NumPy serialization formats accepted by DataCard.",
      "oneOf": [
        {
          "description": "Single-array NPY format.",
          "type": "string",
          "enum": [
            "Npy"
          ]
        },
        {
          "description": "Multi-array NPZ format.",
          "type": "string",
          "enum": [
            "Npz"
          ]
        }
      ]
    },
    "NumpyMeta": {
      "description": "NumPy interface metadata.",
      "type": "object",
      "required": [
        "dtype",
        "format"
      ],
      "properties": {
        "dtype": {
          "description": "Canonical dtype string.",
          "type": "string"
        },
        "format": {
          "description": "NumPy serialization format.",
          "allOf": [
            {
              "$ref": "#/definitions/NumpyFormat"
            }
          ]
        },
        "shape": {
          "description": "Array shape inferred by the Python boundary.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "PandasMeta": {
      "description": "Pandas interface metadata.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "compression": {
          "description": "Parquet compression used by local materialization.",
          "default": "Snappy",
          "allOf": [
            {
              "$ref": "#/definitions/ParquetCompression"
            }
          ]
        },
        "framework_version": {
          "description": "Installed pandas version inferred by the Python boundary.",
          "type": "string"
        }
      }
    },
    "ParquetCompression": {
      "description": "Parquet compression choices accepted by the DataCard contract.",
      "oneOf": [
        {
          "description": "No compression.",
          "type": "string",
          "enum": [
            "None"
          ]
        },
        {
          "description": "Snappy compression.",
          "type": "string",
          "enum": [
            "Snappy"
          ]
        },
        {
          "description": "Gzip compression.",
          "type": "string",
          "enum": [
            "Gzip"
          ]
        },
        {
          "description": "Zstandard compression.",
          "type": "string",
          "enum": [
            "Zstd"
          ]
        },
        {
          "description": "LZ4 compression.",
          "type": "string",
          "enum": [
            "Lz4"
          ]
        }
      ]
    },
    "ParquetMeta": {
      "description": "Parquet interface metadata.",
      "type": "object",
      "properties": {
        "compression": {
          "description": "Parquet compression used by local materialization.",
          "default": "Snappy",
          "allOf": [
            {
              "$ref": "#/definitions/ParquetCompression"
            }
          ]
        },
        "row_group_size": {
          "description": "Optional parquet row group size.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "PolarsMeta": {
      "description": "Polars interface metadata.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "compression": {
          "description": "Parquet compression used by local materialization.",
          "default": "Snappy",
          "allOf": [
            {
              "$ref": "#/definitions/ParquetCompression"
            }
          ]
        },
        "framework_version": {
          "description": "Installed polars version inferred by the Python boundary.",
          "type": "string"
        }
      }
    },
    "QueryName": {
      "description": "DataCard SQL query key.",
      "type": "string"
    },
    "Ref": {
      "description": "A reference position that requires durable identity.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. Authored `Ref` values remain external references even when they identify a submitted card.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
