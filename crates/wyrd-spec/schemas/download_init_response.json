{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DownloadInitResponse",
  "description": "Server response to a download-init request.",
  "type": "object",
  "required": [
    "plan",
    "sha256",
    "size_bytes"
  ],
  "properties": {
    "plan": {
      "description": "Backend-specific download plan.",
      "allOf": [
        {
          "$ref": "#/definitions/DownloadPlan"
        }
      ]
    },
    "sha256": {
      "description": "Expected base64-encoded SHA-256 digest.",
      "type": "string"
    },
    "size_bytes": {
      "description": "Expected object size in bytes.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DownloadPlan": {
      "description": "Presigned GET plan for any backend.",
      "type": "object",
      "required": [
        "get_url",
        "ttl_secs"
      ],
      "properties": {
        "get_url": {
          "description": "Presigned GET URL or local server route URL.",
          "type": "string"
        },
        "ttl_secs": {
          "description": "URL time-to-live in seconds.\n\nFor presigned URL backends (S3, GCS, Azure) this is the URL expiry in seconds. For the local filesystem backend this field is `0` (the server route does not expire).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
