{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriftSpec",
  "description": "DriftCard spec body.",
  "type": "object",
  "required": [
    "condition",
    "method",
    "signal"
  ],
  "properties": {
    "condition": {
      "description": "When a sample becomes an emittable observation.",
      "allOf": [
        {
          "$ref": "#/definitions/DriftCondition"
        }
      ]
    },
    "description": {
      "description": "Free-text description authored on the card.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form non-secret authoring metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "method": {
      "description": "Drift detection method. Drives which `DriftProfile` variant is allowed.",
      "allOf": [
        {
          "$ref": "#/definitions/DriftMethod"
        }
      ]
    },
    "profile": {
      "description": "Method-specific math configuration. Required for `Psi | Spc | Custom`, forbidden for `External`.",
      "anyOf": [
        {
          "$ref": "#/definitions/DriftProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "description": "How the measurement enters the monitor.",
      "allOf": [
        {
          "$ref": "#/definitions/DriftSignal"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "DriftCondition": {
      "description": "Fire condition for a drift observation.",
      "oneOf": [
        {
          "description": "The method's profile decides, such as PSI threshold or SPC zone.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Statistical"
              ]
            }
          }
        },
        {
          "description": "Fires when sample > limit.",
          "type": "object",
          "required": [
            "kind",
            "limit"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Above"
              ]
            },
            "limit": {
              "description": "Upper exclusive limit.",
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Fires when sample < limit.",
          "type": "object",
          "required": [
            "kind",
            "limit"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Below"
              ]
            },
            "limit": {
              "description": "Lower exclusive limit.",
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Fires when sample < lower or sample > upper.",
          "type": "object",
          "required": [
            "kind",
            "lower",
            "upper"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Outside"
              ]
            },
            "lower": {
              "description": "Lower exclusive bound.",
              "type": "number",
              "format": "double"
            },
            "upper": {
              "description": "Upper exclusive bound.",
              "type": "number",
              "format": "double"
            }
          }
        }
      ]
    },
    "DriftMethod": {
      "description": "Drift detection method.\n\n`Agent` is intentionally absent in v1. It can return only after the signal vocabulary, profile, and scoring algorithm are locked in `wyrd-design.md`.",
      "oneOf": [
        {
          "description": "Population Stability Index over a baseline distribution.",
          "type": "string",
          "enum": [
            "Psi"
          ]
        },
        {
          "description": "Statistical Process Control over a baseline distribution or scalar stream.",
          "type": "string",
          "enum": [
            "Spc"
          ]
        },
        {
          "description": "User-defined metric with an author-supplied baseline value.",
          "type": "string",
          "enum": [
            "Custom"
          ]
        },
        {
          "description": "Drift method defined externally, with no Vala-side fit or score.",
          "type": "string",
          "enum": [
            "External"
          ]
        }
      ]
    },
    "DriftProfile": {
      "description": "Method-specific math configuration. Config only; fitted state lives in `vala-drift::baseline`, never here.",
      "oneOf": [
        {
          "description": "PSI profile configuration.",
          "type": "object",
          "required": [
            "binning_strategy",
            "kind",
            "threshold"
          ],
          "properties": {
            "binning_strategy": {
              "description": "Binning strategy applied to numeric features.",
              "allOf": [
                {
                  "$ref": "#/definitions/PsiBinningStrategy"
                }
              ]
            },
            "categorical_features": {
              "description": "Features treated as categorical regardless of dtype.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/FeatureName"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "Psi"
              ]
            },
            "threshold": {
              "description": "PSI threshold strategy.",
              "allOf": [
                {
                  "$ref": "#/definitions/PsiThreshold"
                }
              ]
            }
          }
        },
        {
          "description": "SPC profile configuration.",
          "type": "object",
          "required": [
            "alert_threshold",
            "kind",
            "sample_size",
            "weco_rule"
          ],
          "properties": {
            "alert_threshold": {
              "description": "Lowest zone that should produce a Drift verdict.",
              "allOf": [
                {
                  "$ref": "#/definitions/SpcAlertThreshold"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "Spc"
              ]
            },
            "sample_size": {
              "description": "Sample chunk size for baseline computation. `0` means adaptive default.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "weco_rule": {
              "description": "WECO rule configuration.",
              "allOf": [
                {
                  "$ref": "#/definitions/SpcWecoRule"
                }
              ]
            }
          }
        },
        {
          "description": "Custom profile configuration.",
          "type": "object",
          "required": [
            "alert_threshold",
            "baseline_value",
            "kind",
            "metric_name"
          ],
          "properties": {
            "alert_threshold": {
              "description": "Threshold on `|mean(target) - baseline_value|` that triggers drift.",
              "type": "number",
              "format": "double"
            },
            "baseline_value": {
              "description": "Author-supplied baseline value.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Custom"
              ]
            },
            "metric_name": {
              "description": "Column or metric name read from the target record batch.",
              "type": "string"
            }
          }
        }
      ]
    },
    "DriftSignal": {
      "description": "How measurements enter the drift monitor.",
      "oneOf": [
        {
          "description": "PSI or SPC over a baseline dataset.",
          "type": "object",
          "required": [
            "baseline_ref",
            "features",
            "kind"
          ],
          "properties": {
            "baseline_ref": {
              "description": "Data card carrying the baseline artifact.",
              "allOf": [
                {
                  "$ref": "#/definitions/Ref"
                }
              ]
            },
            "features": {
              "description": "Columns of the baseline DataCard that participate in the monitor.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/FeatureName"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "Distribution"
              ]
            }
          }
        },
        {
          "description": "Named scalar emitted by the subject's runtime.",
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Metric"
              ]
            },
            "name": {
              "description": "Metric name, such as `p99_latency_ms`, `mae`, or `tokens_per_call`.",
              "type": "string"
            }
          }
        },
        {
          "description": "Score stream produced by an Eval card.",
          "type": "object",
          "required": [
            "eval_ref",
            "kind"
          ],
          "properties": {
            "eval_ref": {
              "description": "Eval card whose score stream this drift consumes.",
              "allOf": [
                {
                  "$ref": "#/definitions/Ref"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "EvalScore"
              ]
            }
          }
        },
        {
          "description": "Measurement from an external system, such as Prometheus or OTel.",
          "type": "object",
          "required": [
            "kind",
            "source_ref"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "External"
              ]
            },
            "source_ref": {
              "description": "Source card describing where to read the external measurement.",
              "allOf": [
                {
                  "$ref": "#/definitions/Ref"
                }
              ]
            }
          }
        }
      ]
    },
    "FeatureName": {
      "description": "Feature column name referenced by a DriftCard signal.",
      "type": "string"
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "PsiBinningStrategy": {
      "description": "PSI numeric binning strategy.",
      "oneOf": [
        {
          "description": "Equal-width bins across the baseline column range.",
          "type": "object",
          "required": [
            "kind",
            "n_bins"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "EqualWidth"
              ]
            },
            "n_bins": {
              "description": "Number of bins.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "Quantile bins from sorted baseline values.",
          "type": "object",
          "required": [
            "kind",
            "n_bins"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Quantile"
              ]
            },
            "n_bins": {
              "description": "Number of bins.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        }
      ]
    },
    "PsiThreshold": {
      "description": "PSI alert threshold strategy.",
      "oneOf": [
        {
          "description": "Chi-square approximation threshold.",
          "type": "object",
          "required": [
            "alpha",
            "kind"
          ],
          "properties": {
            "alpha": {
              "description": "Significance level.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "ChiSquare"
              ]
            }
          }
        },
        {
          "description": "Normal approximation threshold.",
          "type": "object",
          "required": [
            "alpha",
            "kind"
          ],
          "properties": {
            "alpha": {
              "description": "Significance level.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Normal"
              ]
            }
          }
        },
        {
          "description": "Static threshold value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Fixed"
              ]
            },
            "value": {
              "description": "Fixed PSI threshold.",
              "type": "number",
              "format": "double"
            }
          }
        }
      ]
    },
    "Ref": {
      "description": "A reference position that requires durable identity.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. Authored `Ref` values remain external references even when they identify a submitted card.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "SpcAlertThreshold": {
      "description": "SPC alert threshold: the lowest zone that produces a Drift verdict.",
      "oneOf": [
        {
          "description": "Zone 1.",
          "type": "string",
          "enum": [
            "Zone1"
          ]
        },
        {
          "description": "Zone 2.",
          "type": "string",
          "enum": [
            "Zone2"
          ]
        },
        {
          "description": "Zone 3.",
          "type": "string",
          "enum": [
            "Zone3"
          ]
        },
        {
          "description": "Zone 4.",
          "type": "string",
          "enum": [
            "Zone4"
          ]
        }
      ]
    },
    "SpcWecoRule": {
      "description": "WECO rule string config.",
      "type": "object",
      "required": [
        "rule_string"
      ],
      "properties": {
        "rule_string": {
          "description": "Eight whitespace-separated positive `u32`s. Default: `\"8 16 4 8 2 4 1 1\"`.",
          "type": "string"
        }
      }
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
