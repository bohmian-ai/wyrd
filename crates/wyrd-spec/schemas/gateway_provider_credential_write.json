{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCredentialWrite",
  "description": "`PUT /v1/admin/gateway/provider-credentials/{name}` body.",
  "type": "object",
  "required": [
    "name",
    "provider",
    "source"
  ],
  "properties": {
    "name": {
      "description": "Tenant-unique credential name; must match the path name.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCredentialName"
        }
      ]
    },
    "provider": {
      "description": "Provider the credential authenticates to.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderId"
        }
      ]
    },
    "source": {
      "description": "Credential source.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCredentialWriteSource"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CredentialBindingName": {
      "description": "Operator-configured gateway credential binding name.",
      "type": "string"
    },
    "ProviderCredentialName": {
      "description": "Tenant-unique gateway provider credential name.",
      "type": "string"
    },
    "ProviderCredentialWriteSource": {
      "description": "Where a provider credential's value comes from, as written by an admin.\n\n`Environment` and `ExternalSecret` name operator-owned authority the server resolves at runtime. `ManagedSecret` is the one source carrying a value: it is write-only, crosses the bounded administration ingress once, and is protected under the tenant's keyring before persistence.",
      "oneOf": [
        {
          "description": "Operator-configured environment variable or mounted-file binding.",
          "type": "object",
          "required": [
            "environment"
          ],
          "properties": {
            "environment": {
              "type": "object",
              "required": [
                "binding"
              ],
              "properties": {
                "binding": {
                  "description": "Binding name the operator configured on the server.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/CredentialBindingName"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Reference resolved from an operator-configured secret backend.",
          "type": "object",
          "required": [
            "external_secret"
          ],
          "properties": {
            "external_secret": {
              "type": "object",
              "required": [
                "backend",
                "reference"
              ],
              "properties": {
                "backend": {
                  "description": "Configured backend identity.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/SecretBackendName"
                    }
                  ]
                },
                "reference": {
                  "description": "Opaque backend reference.",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Provider key the tenant administrator submits for Wyrd to protect.\n\nWrite-only: the redacted view is the unit [`ProviderCredentialSourceView::ManagedSecret`], so no read, listing, error, log, or audit record can disclose the value.",
          "type": "object",
          "required": [
            "managed_secret"
          ],
          "properties": {
            "managed_secret": {
              "type": "object",
              "required": [
                "secret"
              ],
              "properties": {
                "secret": {
                  "description": "Submitted provider key, redacted in `Debug` and write-only in every generated schema.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/SecretBearer"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ProviderId": {
      "description": "Tenant-visible gateway provider identifier using the canonical Wyrd name grammar.",
      "type": "string"
    },
    "SecretBackendName": {
      "description": "Operator-configured external secret backend identity.",
      "type": "string"
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    }
  }
}
