{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HttpAuth",
  "description": "Credential authority of an HTTP action, bound to a tenant `http` connection.\n\nThe scheme and custom header name must equal the named connection's stored authority at registration and before every attempt.",
  "oneOf": [
    {
      "description": "`Authorization: Bearer` from the connection's token.",
      "type": "object",
      "required": [
        "connection",
        "scheme"
      ],
      "properties": {
        "connection": {
          "description": "Name of the tenant's `http` connection.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "scheme": {
          "type": "string",
          "enum": [
            "bearer"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "`Authorization: Basic` from the connection's username and password.",
      "type": "object",
      "required": [
        "connection",
        "scheme"
      ],
      "properties": {
        "connection": {
          "description": "Name of the tenant's `http` connection.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "scheme": {
          "type": "string",
          "enum": [
            "basic"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A custom header carrying the connection's value.",
      "type": "object",
      "required": [
        "connection",
        "name",
        "scheme"
      ],
      "properties": {
        "connection": {
          "description": "Name of the tenant's `http` connection.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "name": {
          "description": "Header name, compared case-insensitively with the connection's.",
          "type": "string"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "header"
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ConnectionName": {
      "description": "Immutable tenant-scoped Operator connection name, unique per provider.",
      "type": "string"
    }
  }
}
