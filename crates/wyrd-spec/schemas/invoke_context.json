{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvokeContext",
  "description": "Invocation context passed to runtime Policy Cards.",
  "type": "object",
  "required": [
    "actor",
    "card",
    "request_id",
    "run_kind",
    "trace"
  ],
  "properties": {
    "actor": {
      "description": "Principal that initiated the invocation.",
      "allOf": [
        {
          "$ref": "#/definitions/Actor"
        }
      ]
    },
    "card": {
      "description": "Invoked Card reference.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "inputs": {
      "description": "Runtime invocation inputs; runtime phases validate schemas and redact before audit."
    },
    "request_id": {
      "description": "Request correlation ID.",
      "allOf": [
        {
          "$ref": "#/definitions/RequestId"
        }
      ]
    },
    "run_kind": {
      "description": "Kind of Run being produced.",
      "allOf": [
        {
          "$ref": "#/definitions/RunKind"
        }
      ]
    },
    "trace": {
      "description": "Trace context for the invocation.",
      "allOf": [
        {
          "$ref": "#/definitions/TraceContext"
        }
      ]
    }
  },
  "definitions": {
    "Actor": {
      "description": "Principal making a Wyrd request.",
      "oneOf": [
        {
          "description": "Human user identity.",
          "type": "object",
          "required": [
            "email",
            "id",
            "type"
          ],
          "properties": {
            "email": {
              "description": "Email address from identity provider.",
              "type": "string"
            },
            "id": {
              "description": "User record UID.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardUid"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "description": "Service-account identity.",
          "type": "object",
          "required": [
            "client_id",
            "name",
            "type"
          ],
          "properties": {
            "client_id": {
              "description": "Stable opaque client identifier from verified claims — never a credential. Populated from the JWT `sub` or equivalent verified identity claim.",
              "type": "string"
            },
            "name": {
              "description": "Service account name (human-readable label).",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "service"
              ]
            }
          }
        },
        {
          "description": "Agent identity.",
          "type": "object",
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "description": "Agent card UID.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardUid"
                }
              ]
            },
            "parent_actor": {
              "description": "Principal that initiated this agent.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Actor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          }
        }
      ]
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "RequestId": {
      "description": "Request correlation ID; required to be a UUID v7.",
      "type": "string"
    },
    "RunKind": {
      "description": "Execution kind recorded as a Run.",
      "oneOf": [
        {
          "description": "Training execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "training"
              ]
            }
          }
        },
        {
          "description": "Inference execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inference"
              ]
            }
          }
        },
        {
          "description": "Offline or batch evaluation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "offline_eval"
              ]
            }
          }
        },
        {
          "description": "Drift check execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "drift_check"
              ]
            }
          }
        },
        {
          "description": "Import execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "import"
              ]
            }
          }
        },
        {
          "description": "Workflow execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "workflow"
              ]
            }
          }
        },
        {
          "description": "Autonomous remediation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "remediation"
              ]
            }
          }
        },
        {
          "description": "Externally defined execution kind.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "external"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "TraceContext": {
      "description": "Raw W3C trace context without SDK dependencies.",
      "type": "object",
      "required": [
        "span_id",
        "trace_flags",
        "trace_id",
        "trace_state"
      ],
      "properties": {
        "span_id": {
          "description": "8-byte span ID encoded as 16 lowercase hex characters.",
          "type": "string"
        },
        "trace_flags": {
          "description": "W3C trace flags.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "trace_id": {
          "description": "16-byte trace ID encoded as 32 lowercase hex characters.",
          "type": "string"
        },
        "trace_state": {
          "description": "Raw `tracestate` header.",
          "type": "string"
        }
      }
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
