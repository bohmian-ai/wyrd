{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListCardsRequest",
  "description": "Query parameters for card listing.",
  "type": "object",
  "properties": {
    "cursor": {
      "description": "Opaque continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    },
    "filter": {
      "description": "Optional metadata query encoded as its canonical query-language string.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "include_prerelease": {
      "description": "Include prerelease versions.",
      "default": false,
      "type": "boolean"
    },
    "kind": {
      "description": "Optional kind filter.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "description": "Maximum result count.",
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "name": {
      "description": "Optional name filter.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardName"
        },
        {
          "type": "null"
        }
      ]
    },
    "space": {
      "description": "Optional workspace filter.",
      "anyOf": [
        {
          "$ref": "#/definitions/SpaceName"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "description": "Optional lifecycle filter.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardLifecycleStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_range": {
      "description": "Optional semver range filter.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Verifier",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardLifecycleStatus": {
      "description": "Server-managed lifecycle state for a Card.",
      "oneOf": [
        {
          "description": "Registration is waiting for artifact upload and verification.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Card is available for use.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Card has been superseded by a newer version.",
          "type": "string",
          "enum": [
            "deprecated"
          ]
        },
        {
          "description": "Registration failed and awaits cleanup or retry.",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "Registration expired before completion.",
          "type": "string",
          "enum": [
            "expired"
          ]
        },
        {
          "description": "Card was soft-deleted.",
          "type": "string",
          "enum": [
            "deleted"
          ]
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    }
  }
}
