{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelSpec",
  "description": "Body of a Model card.\n\nThis pure contract describes which framework loads the model, which task it performs, which fields it consumes and produces, and which Artifact cards hold model-related bytes.",
  "type": "object",
  "required": [
    "interface",
    "signature",
    "task_type"
  ],
  "properties": {
    "card_refs": {
      "description": "Durable Artifact card references linked to this model card.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "interface": {
      "description": "Framework interface tag and per-interface config metadata.",
      "allOf": [
        {
          "$ref": "#/definitions/ModelInterface"
        }
      ]
    },
    "sample_input": {
      "description": "Optional canonical sample input description.",
      "anyOf": [
        {
          "$ref": "#/definitions/SampleInput"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "description": "Typed input and output schema.",
      "allOf": [
        {
          "$ref": "#/definitions/ModelSignature"
        }
      ]
    },
    "task_type": {
      "description": "Closed Wyrd ML task taxonomy.",
      "allOf": [
        {
          "$ref": "#/definitions/TaskType"
        }
      ]
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "CatboostMeta": {
      "description": "Config for the Catboost model interface.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed catboost version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete model subtype, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ColumnName": {
      "description": "DataCard column name.",
      "type": "string"
    },
    "CustomMeta": {
      "description": "Config for the Custom model interface.",
      "type": "object",
      "required": [
        "framework_version",
        "loader_class",
        "loader_module"
      ],
      "properties": {
        "extra": {
          "description": "Free-form string metadata that does not change the Wyrd contract.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "framework_version": {
          "description": "Reported framework version of the user-supplied loader environment.",
          "type": "string"
        },
        "loader_class": {
          "description": "Loader class or callable name.",
          "type": "string"
        },
        "loader_module": {
          "description": "Python module path containing the user-supplied loader.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Optional informational subtype string.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Dim": {
      "description": "One dimension in a field shape.",
      "oneOf": [
        {
          "description": "A fixed, known dimension length.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Fixed"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "description": "A dynamic dimension, optionally named for documentation and signatures.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Dynamic"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "FieldSpec": {
      "description": "Ordered field declaration used by Wyrd data schemas and model signatures.",
      "type": "object",
      "required": [
        "dtype",
        "name"
      ],
      "properties": {
        "dtype": {
          "description": "Canonical Arrow logical dtype string.",
          "type": "string"
        },
        "extra": {
          "description": "Additional string metadata that does not change the Wyrd field contract.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "description": "Canonical column or feature name.",
          "allOf": [
            {
              "$ref": "#/definitions/ColumnName"
            }
          ]
        },
        "nullable": {
          "description": "Whether this field may contain null values.",
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "description": "Optional tensor or nested value shape; empty means scalar/tabular.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Dim"
          }
        }
      }
    },
    "HuggingFaceTask": {
      "description": "Hugging Face task identifier.",
      "oneOf": [
        {
          "description": "text-classification",
          "type": "string",
          "enum": [
            "TextClassification"
          ]
        },
        {
          "description": "token-classification",
          "type": "string",
          "enum": [
            "TokenClassification"
          ]
        },
        {
          "description": "question-answering",
          "type": "string",
          "enum": [
            "QuestionAnswering"
          ]
        },
        {
          "description": "summarization",
          "type": "string",
          "enum": [
            "Summarization"
          ]
        },
        {
          "description": "translation",
          "type": "string",
          "enum": [
            "Translation"
          ]
        },
        {
          "description": "text-generation",
          "type": "string",
          "enum": [
            "TextGeneration"
          ]
        },
        {
          "description": "fill-mask",
          "type": "string",
          "enum": [
            "FillMask"
          ]
        },
        {
          "description": "zero-shot-classification",
          "type": "string",
          "enum": [
            "ZeroShotClassification"
          ]
        },
        {
          "description": "image-classification",
          "type": "string",
          "enum": [
            "ImageClassification"
          ]
        },
        {
          "description": "object-detection",
          "type": "string",
          "enum": [
            "ObjectDetection"
          ]
        },
        {
          "description": "image-segmentation",
          "type": "string",
          "enum": [
            "ImageSegmentation"
          ]
        },
        {
          "description": "image-to-text",
          "type": "string",
          "enum": [
            "ImageToText"
          ]
        },
        {
          "description": "image-to-image",
          "type": "string",
          "enum": [
            "ImageToImage"
          ]
        },
        {
          "description": "text-to-image",
          "type": "string",
          "enum": [
            "TextToImage"
          ]
        },
        {
          "description": "depth-estimation",
          "type": "string",
          "enum": [
            "DepthEstimation"
          ]
        },
        {
          "description": "audio-classification",
          "type": "string",
          "enum": [
            "AudioClassification"
          ]
        },
        {
          "description": "automatic-speech-recognition",
          "type": "string",
          "enum": [
            "AutomaticSpeechRecognition"
          ]
        },
        {
          "description": "audio-to-audio",
          "type": "string",
          "enum": [
            "AudioToAudio"
          ]
        },
        {
          "description": "text-to-speech",
          "type": "string",
          "enum": [
            "TextToSpeech"
          ]
        },
        {
          "description": "tabular-classification",
          "type": "string",
          "enum": [
            "TabularClassification"
          ]
        },
        {
          "description": "tabular-regression",
          "type": "string",
          "enum": [
            "TabularRegression"
          ]
        },
        {
          "description": "feature-extraction",
          "type": "string",
          "enum": [
            "FeatureExtraction"
          ]
        },
        {
          "description": "sentence-similarity",
          "type": "string",
          "enum": [
            "SentenceSimilarity"
          ]
        },
        {
          "description": "conversational",
          "type": "string",
          "enum": [
            "Conversational"
          ]
        },
        {
          "description": "document-question-answering",
          "type": "string",
          "enum": [
            "DocumentQuestionAnswering"
          ]
        },
        {
          "description": "visual-question-answering",
          "type": "string",
          "enum": [
            "VisualQuestionAnswering"
          ]
        },
        {
          "description": "table-question-answering",
          "type": "string",
          "enum": [
            "TableQuestionAnswering"
          ]
        },
        {
          "description": "embedding",
          "type": "string",
          "enum": [
            "Embedding"
          ]
        },
        {
          "description": "multiple-choice",
          "type": "string",
          "enum": [
            "MultipleChoice"
          ]
        },
        {
          "description": "Long-tail task identifier not yet first-class.",
          "type": "string",
          "enum": [
            "Other"
          ]
        }
      ]
    },
    "HuggingfaceMeta": {
      "description": "Config for the Huggingface model interface.",
      "type": "object",
      "required": [
        "framework_version",
        "hf_task"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed transformers or diffusers version captured for reproducibility.",
          "type": "string"
        },
        "hf_task": {
          "description": "Hugging Face task identifier required for rehydration.",
          "allOf": [
            {
              "$ref": "#/definitions/HuggingFaceTask"
            }
          ]
        },
        "model_subtype": {
          "description": "Concrete model class name, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo_id": {
          "description": "Optional Hugging Face Hub repo id.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Optional pinned revision.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LightgbmMeta": {
      "description": "Config for the Lightgbm model interface.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed lightgbm version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete model subtype, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LightningMeta": {
      "description": "Config for the Lightning model interface.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed pytorch-lightning version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete LightningModule class name, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelInterface": {
      "description": "Framework interface tag for a Model spec.",
      "oneOf": [
        {
          "description": "scikit-learn estimator persisted through the sklearn loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Sklearn"
              ]
            },
            "meta": {
              "$ref": "#/definitions/SklearnMeta"
            }
          }
        },
        {
          "description": "XGBoost model persisted through the xgboost loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Xgboost"
              ]
            },
            "meta": {
              "$ref": "#/definitions/XgboostMeta"
            }
          }
        },
        {
          "description": "LightGBM model persisted through the lightgbm loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Lightgbm"
              ]
            },
            "meta": {
              "$ref": "#/definitions/LightgbmMeta"
            }
          }
        },
        {
          "description": "CatBoost model persisted through the catboost loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Catboost"
              ]
            },
            "meta": {
              "$ref": "#/definitions/CatboostMeta"
            }
          }
        },
        {
          "description": "PyTorch module persisted through the torch loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Torch"
              ]
            },
            "meta": {
              "$ref": "#/definitions/TorchMeta"
            }
          }
        },
        {
          "description": "PyTorch Lightning module persisted as a trainer checkpoint.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Lightning"
              ]
            },
            "meta": {
              "$ref": "#/definitions/LightningMeta"
            }
          }
        },
        {
          "description": "TensorFlow or Keras model persisted through the tensorflow loader.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Tensorflow"
              ]
            },
            "meta": {
              "$ref": "#/definitions/TensorflowMeta"
            }
          }
        },
        {
          "description": "Hugging Face model persisted through a local snapshot or pinned repo.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Huggingface"
              ]
            },
            "meta": {
              "$ref": "#/definitions/HuggingfaceMeta"
            }
          }
        },
        {
          "description": "User-supplied loader metadata.",
          "type": "object",
          "required": [
            "kind",
            "meta"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Custom"
              ]
            },
            "meta": {
              "$ref": "#/definitions/CustomMeta"
            }
          }
        }
      ]
    },
    "ModelSignature": {
      "description": "Typed input and output schema for a Model spec.",
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "description": "Ordered input field schema.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldSpec"
          }
        },
        "outputs": {
          "description": "Ordered output field schema.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldSpec"
          }
        }
      }
    },
    "SampleInput": {
      "description": "Sample input description for loader-side rehydration.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "description": "Closed kind tag selecting the loader-side deserializer.",
          "allOf": [
            {
              "$ref": "#/definitions/SampleInputKind"
            }
          ]
        }
      }
    },
    "SampleInputKind": {
      "description": "Closed set of sample input shapes supported by Wyrd at the contract layer.",
      "oneOf": [
        {
          "description": "pandas dataframe serialized as parquet.",
          "type": "string",
          "enum": [
            "Pandas"
          ]
        },
        {
          "description": "polars dataframe serialized as parquet.",
          "type": "string",
          "enum": [
            "Polars"
          ]
        },
        {
          "description": "pyarrow table or record batch serialized as IPC.",
          "type": "string",
          "enum": [
            "Arrow"
          ]
        },
        {
          "description": "numpy array serialized as npz.",
          "type": "string",
          "enum": [
            "Numpy"
          ]
        },
        {
          "description": "torch tensor dict serialized as safetensors.",
          "type": "string",
          "enum": [
            "Torch"
          ]
        },
        {
          "description": "TensorFlow tensor dict serialized as npz.",
          "type": "string",
          "enum": [
            "Tf"
          ]
        },
        {
          "description": "JSON-safe Python dict serialized as json.",
          "type": "string",
          "enum": [
            "Dict"
          ]
        },
        {
          "description": "JSON-safe Python list serialized as json.",
          "type": "string",
          "enum": [
            "List"
          ]
        },
        {
          "description": "JSON-safe Python tuple serialized as json.",
          "type": "string",
          "enum": [
            "Tuple"
          ]
        },
        {
          "description": "Plain UTF-8 string serialized as text.",
          "type": "string",
          "enum": [
            "Str"
          ]
        },
        {
          "description": "No sample input declared.",
          "type": "string",
          "enum": [
            "None"
          ]
        }
      ]
    },
    "SklearnMeta": {
      "description": "Config for the Sklearn model interface.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed sklearn version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete estimator class name, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "TaskType": {
      "description": "Closed Wyrd ML task taxonomy.",
      "oneOf": [
        {
          "description": "Two-class classification.",
          "type": "string",
          "enum": [
            "BinaryClassification"
          ]
        },
        {
          "description": "Classification with more than two classes.",
          "type": "string",
          "enum": [
            "MultiClassClassification"
          ]
        },
        {
          "description": "Continuous-valued regression.",
          "type": "string",
          "enum": [
            "Regression"
          ]
        },
        {
          "description": "Unsupervised clustering.",
          "type": "string",
          "enum": [
            "Clustering"
          ]
        },
        {
          "description": "Anomaly or outlier detection.",
          "type": "string",
          "enum": [
            "AnomalyDetection"
          ]
        },
        {
          "description": "Time-series forecasting.",
          "type": "string",
          "enum": [
            "Forecasting"
          ]
        },
        {
          "description": "Generative model task.",
          "type": "string",
          "enum": [
            "Generation"
          ]
        },
        {
          "description": "Long-tail task described by interface metadata.",
          "type": "string",
          "enum": [
            "Other"
          ]
        }
      ]
    },
    "TensorflowMeta": {
      "description": "Config for the Tensorflow model interface.",
      "type": "object",
      "required": [
        "framework_version",
        "save_format"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed tensorflow or keras version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete model class name, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "save_format": {
          "description": "Save format for the tensorflow artifact.",
          "allOf": [
            {
              "$ref": "#/definitions/TfSaveFormat"
            }
          ]
        }
      }
    },
    "TfSaveFormat": {
      "description": "Save format for the Tensorflow model interface.",
      "oneOf": [
        {
          "description": "Keras v3 single-file archive.",
          "type": "string",
          "enum": [
            "Keras"
          ]
        },
        {
          "description": "SavedModel directory layout.",
          "type": "string",
          "enum": [
            "SavedModel"
          ]
        }
      ]
    },
    "TorchMeta": {
      "description": "Config for the Torch model interface.",
      "type": "object",
      "required": [
        "framework_version",
        "save_format"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed torch version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete module class name, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "save_format": {
          "description": "Save format for the torch artifact.",
          "allOf": [
            {
              "$ref": "#/definitions/TorchSaveFormat"
            }
          ]
        }
      }
    },
    "TorchSaveFormat": {
      "description": "Save format for the Torch model interface.",
      "oneOf": [
        {
          "description": "Tensors-only safetensors state dict.",
          "type": "string",
          "enum": [
            "Safetensors"
          ]
        },
        {
          "description": "Pickle-backed torch save format.",
          "type": "string",
          "enum": [
            "Pickle"
          ]
        }
      ]
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    },
    "XgboostMeta": {
      "description": "Config for the Xgboost model interface.",
      "type": "object",
      "required": [
        "framework_version"
      ],
      "properties": {
        "framework_version": {
          "description": "Installed xgboost version captured for reproducibility.",
          "type": "string"
        },
        "model_subtype": {
          "description": "Concrete model subtype, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
