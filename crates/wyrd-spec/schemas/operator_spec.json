{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatorSpec",
  "description": "Server-side, policy-gated Operator declaration.",
  "type": "object",
  "required": [
    "adapter"
  ],
  "properties": {
    "adapter": {
      "description": "Framework adapter used to execute this Operator.",
      "allOf": [
        {
          "$ref": "#/definitions/FrameworkAdapterRef"
        }
      ]
    },
    "budget": {
      "description": "Optional runtime budget.",
      "anyOf": [
        {
          "$ref": "#/definitions/OperatorBudget"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "description": "Declared runtime inputs.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/OperatorInput"
      }
    },
    "post_invoke": {
      "description": "Policy Cards evaluated after invocation.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "pre_invoke": {
      "description": "Policy Cards evaluated before invocation.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "FrameworkAdapterRef": {
      "description": "Framework adapter reference for loading or invoking artifacts.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "config": {
          "description": "Non-secret adapter configuration.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "name": {
          "description": "Adapter name.",
          "type": "string"
        },
        "version": {
          "description": "Adapter version or version range.",
          "type": "string"
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "OperatorBudget": {
      "description": "Operator execution budget.",
      "type": "object",
      "properties": {
        "max_memory_mb": {
          "description": "Maximum memory in MiB.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_tool_calls": {
          "description": "Maximum tool calls allowed during invocation.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_wall_seconds": {
          "description": "Maximum wall-clock runtime in seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "OperatorInput": {
      "description": "Operator input declaration.",
      "type": "object",
      "required": [
        "name",
        "schema_ref"
      ],
      "properties": {
        "name": {
          "description": "Input name.",
          "type": "string"
        },
        "schema_ref": {
          "description": "Schema reference URI or symbolic schema identifier.",
          "type": "string"
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
