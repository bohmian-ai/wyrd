{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicySpec",
  "description": "Declarative policy rule set.",
  "type": "object",
  "properties": {
    "description": {
      "description": "Policy description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "enforcement": {
      "description": "Enforcement mode.",
      "type": [
        "string",
        "null"
      ]
    },
    "rules": {
      "description": "Policy rules.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PolicyRule"
      }
    }
  },
  "definitions": {
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "PolicyRule": {
      "description": "One policy rule.",
      "type": "object",
      "required": [
        "action",
        "expression",
        "name"
      ],
      "properties": {
        "action": {
          "description": "Action such as `allow`, `warn`, `block`, or `approval_required`.",
          "type": "string"
        },
        "expression": {
          "description": "Rule expression.",
          "type": "string"
        },
        "metadata": {
          "description": "Rule metadata.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "name": {
          "description": "Rule name.",
          "type": "string"
        }
      }
    }
  }
}
