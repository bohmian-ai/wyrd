{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubAgentSpec",
  "description": "Declarative sub-agent definition for harnesses.",
  "type": "object",
  "properties": {
    "background": {
      "description": "Whether background execution is allowed by the harness.",
      "default": false,
      "type": "boolean"
    },
    "compatible_clis": {
      "description": "Compatible CLI names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Sub-agent description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": true
    },
    "disallowed_tools": {
      "description": "Disallowed tool names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effort": {
      "description": "Effort setting.",
      "type": [
        "string",
        "null"
      ]
    },
    "isolation": {
      "description": "Isolation descriptor.",
      "type": [
        "string",
        "null"
      ]
    },
    "max_turns": {
      "description": "Maximum turns.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "mcp_servers": {
      "description": "MCP server references or names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "description": "Memory descriptor.",
      "type": "object",
      "additionalProperties": true
    },
    "model": {
      "description": "Model selector.",
      "type": [
        "string",
        "null"
      ]
    },
    "permission_mode": {
      "description": "Permission mode.",
      "type": [
        "string",
        "null"
      ]
    },
    "sandbox_mode": {
      "description": "Sandbox mode.",
      "type": [
        "string",
        "null"
      ]
    },
    "skill_refs": {
      "description": "Skill references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "system_prompt": {
      "description": "System prompt or prompt reference text.",
      "type": [
        "string",
        "null"
      ]
    },
    "temperature": {
      "description": "Model temperature.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "tool_refs": {
      "description": "Tool references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "CardKind": {
      "description": "Native Wyrd Card kind plus forward-compatible external catch-all.",
      "oneOf": [
        {
          "description": "Data Card.",
          "type": "string",
          "enum": [
            "Data"
          ]
        },
        {
          "description": "Model Card.",
          "type": "string",
          "enum": [
            "Model"
          ]
        },
        {
          "description": "Experiment Card.",
          "type": "string",
          "enum": [
            "Experiment"
          ]
        },
        {
          "description": "Prompt Card.",
          "type": "string",
          "enum": [
            "Prompt"
          ]
        },
        {
          "description": "Tool Card.",
          "type": "string",
          "enum": [
            "Tool"
          ]
        },
        {
          "description": "Agent Card.",
          "type": "string",
          "enum": [
            "Agent"
          ]
        },
        {
          "description": "Workflow Card.",
          "type": "string",
          "enum": [
            "Workflow"
          ]
        },
        {
          "description": "Evaluation Card.",
          "type": "string",
          "enum": [
            "Eval"
          ]
        },
        {
          "description": "Drift Card.",
          "type": "string",
          "enum": [
            "Drift"
          ]
        },
        {
          "description": "Service Card.",
          "type": "string",
          "enum": [
            "Service"
          ]
        },
        {
          "description": "Policy Card.",
          "type": "string",
          "enum": [
            "Policy"
          ]
        },
        {
          "description": "MCP Card.",
          "type": "string",
          "enum": [
            "Mcp"
          ]
        },
        {
          "description": "Skill Card.",
          "type": "string",
          "enum": [
            "Skill"
          ]
        },
        {
          "description": "Sub-agent Card.",
          "type": "string",
          "enum": [
            "SubAgent"
          ]
        },
        {
          "description": "Audit Card.",
          "type": "string",
          "enum": [
            "Audit"
          ]
        },
        {
          "description": "Artifact Card.",
          "type": "string",
          "enum": [
            "Artifact"
          ]
        },
        {
          "description": "Unknown Card kind with schema hash.",
          "type": "object",
          "required": [
            "External"
          ],
          "properties": {
            "External": {
              "type": "object",
              "required": [
                "name",
                "schema_hash"
              ],
              "properties": {
                "name": {
                  "description": "External kind name.",
                  "type": "string"
                },
                "schema_hash": {
                  "description": "32-byte schema hash.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  },
                  "maxItems": 32,
                  "minItems": 32
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space; omitted means current/default space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
