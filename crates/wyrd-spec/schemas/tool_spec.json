{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolSpec",
  "description": "Declarative tool definition for agent harnesses.",
  "type": "object",
  "required": [
    "args_schema",
    "description",
    "name",
    "tool_type"
  ],
  "properties": {
    "allowed_tools": {
      "description": "Allowed downstream tool names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "api_config": {
      "description": "API tool config.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "args_schema": {
      "description": "Input argument schema."
    },
    "credential_refs": {
      "description": "Credential references required by this tool.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialRef"
      }
    },
    "description": {
      "description": "Tool description.",
      "type": "string"
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "hook_events": {
      "description": "Hook event names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hook_matcher": {
      "description": "Hook matcher metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "mcp_server_name": {
      "description": "MCP server name.",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "description": "LLM-visible tool name.",
      "type": "string"
    },
    "output_schema": {
      "description": "Output schema."
    },
    "requires_approval": {
      "description": "Whether approval is required before use.",
      "default": false,
      "type": "boolean"
    },
    "script_config": {
      "description": "Script tool config.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "tool_type": {
      "description": "Tool type, such as `script`, `api`, `mcp`, or `builtin`.",
      "type": "string"
    }
  },
  "definitions": {
    "CredentialRef": {
      "description": "Reference to a credential or secret managed outside public Card specs.",
      "type": "object",
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "description": "Key or logical name in that provider.",
          "type": "string"
        },
        "provider": {
          "description": "Credential provider or secret store name.",
          "type": "string"
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    }
  }
}
