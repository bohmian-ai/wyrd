{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriggerSchedule",
  "description": "Cron schedule for Trigger evaluation.",
  "type": "object",
  "required": [
    "cron"
  ],
  "properties": {
    "cron": {
      "description": "Cron expression.",
      "type": "string"
    },
    "tz": {
      "description": "Optional IANA timezone; absent means UTC.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
