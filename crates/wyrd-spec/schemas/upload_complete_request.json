{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UploadCompleteRequest",
  "description": "Client request to complete an upload.",
  "oneOf": [
    {
      "description": "Single PUT completion.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/SinglePutComplete"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "single_put"
          ]
        }
      }
    },
    {
      "description": "multipart completion.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/MultipartComplete"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "multipart"
          ]
        }
      }
    },
    {
      "description": "Azure block blob completion.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/AzureBlockBlobComplete"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "azure_block_blob"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AzureBlockBlobComplete": {
      "description": "Azure block blob completion payload.",
      "type": "object",
      "required": [
        "block_count"
      ],
      "properties": {
        "block_count": {
          "description": "Number of blocks the client uploaded.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "CompletedPart": {
      "description": "Completed part descriptor.",
      "type": "object",
      "required": [
        "e_tag",
        "part_number"
      ],
      "properties": {
        "e_tag": {
          "description": "ETag the backend returned for the part upload.",
          "type": "string"
        },
        "part_number": {
          "description": "One-based part number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "MultipartComplete": {
      "description": "multipart completion payload.",
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "description": "Parts uploaded by the client.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompletedPart"
          }
        }
      },
      "additionalProperties": false
    },
    "SinglePutComplete": {
      "description": "Single PUT completion payload.",
      "type": "object",
      "additionalProperties": false
    }
  }
}
