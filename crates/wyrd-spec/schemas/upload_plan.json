{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UploadPlan",
  "description": "Tagged union describing how the client uploads bytes.",
  "oneOf": [
    {
      "description": "Single PUT to a presigned URL.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "put_url",
            "ttl_secs"
          ],
          "properties": {
            "put_url": {
              "description": "Presigned PUT URL.",
              "type": "string"
            },
            "required_headers": {
              "description": "Headers the client must include on the PUT.",
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/HeaderPair"
              }
            },
            "ttl_secs": {
              "description": "URL time-to-live in seconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": [
            "single_put"
          ]
        }
      }
    },
    {
      "description": "Local filesystem auth-gated upload.\n\nSignals that the upload URL is an auth-gated server route for one server-minted upload capability, not a caller-selected storage path.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "put_url",
            "ttl_secs"
          ],
          "properties": {
            "put_url": {
              "description": "Server route PUT URL.",
              "type": "string"
            },
            "ttl_secs": {
              "description": "URL time-to-live in seconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": [
            "local_fs"
          ]
        }
      }
    },
    {
      "description": "AWS S3 multipart upload.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "part_count",
            "part_size_bytes",
            "part_url_ttl_secs"
          ],
          "properties": {
            "part_count": {
              "description": "Number of parts planned.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "part_size_bytes": {
              "description": "Size of each non-final part.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "part_url_ttl_secs": {
              "description": "Time-to-live for per-part URLs in seconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "required_headers": {
              "description": "Headers the client must include on each part PUT.",
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/HeaderPair"
              }
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": [
            "s3_multipart"
          ]
        }
      }
    },
    {
      "description": "Google Cloud Storage resumable upload.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "chunk_size_bytes",
            "session_uri"
          ],
          "properties": {
            "chunk_size_bytes": {
              "description": "Recommended chunk size in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "session_uri": {
              "description": "Resumable session URI returned once to the client.",
              "type": "string"
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": [
            "gcs_resumable"
          ]
        }
      }
    },
    {
      "description": "Azure block blob upload.",
      "type": "object",
      "required": [
        "data",
        "protocol"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "block_count_planned",
            "block_size_bytes",
            "sas_url"
          ],
          "properties": {
            "block_count_planned": {
              "description": "Number of blocks the server expects to commit.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "block_size_bytes": {
              "description": "Recommended block size in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "sas_url": {
              "description": "SAS URL returned once to the client.",
              "type": "string"
            }
          }
        },
        "protocol": {
          "type": "string",
          "enum": [
            "azure_block_blob"
          ]
        }
      }
    }
  ],
  "definitions": {
    "HeaderPair": {
      "description": "Required HTTP header for a client upload request.",
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "description": "Header name.",
          "type": "string"
        },
        "value": {
          "description": "Header value.",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
