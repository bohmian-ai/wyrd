{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalRunOpenRequest",
  "description": "Client request to open and lease a new eval run against `eval_ref`.",
  "type": "object",
  "required": [
    "eval_ref",
    "simulated_user"
  ],
  "properties": {
    "eval_ref": {
      "description": "Reference to the Eval card under evaluation.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "simulated_user": {
      "description": "Who generates non-scripted user turns.",
      "allOf": [
        {
          "$ref": "#/definitions/SimulatedUserMode"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "SimulatedUserMode": {
      "description": "Selects who supplies the next user message when the next turn is not already scripted via `EvalScenario.predefined_turns`.\n\nScripted turns always come from `predefined_turns` server-side.",
      "oneOf": [
        {
          "description": "Server-simulated persona drives non-scripted user turns.",
          "type": "string",
          "enum": [
            "server"
          ]
        },
        {
          "description": "Client supplies non-scripted user turns.",
          "type": "string",
          "enum": [
            "client"
          ]
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
