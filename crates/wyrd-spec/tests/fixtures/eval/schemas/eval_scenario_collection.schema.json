          "type": "object",
          "required": [
            "operator"
          ],
          "properties": {
            "operator": {
              "type": "string",
              "enum": [
                "less_than_or_equals"
              ]
            }
          }
        },
        {
          "description": "Requires the observed value to fall within the given range.\n\nRuntime rejects `min > max`.",
          "type": "object",
          "required": [
            "operator",
            "params"
          ],
          "properties": {
            "operator": {
