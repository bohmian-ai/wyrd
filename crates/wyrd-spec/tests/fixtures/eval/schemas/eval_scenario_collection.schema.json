                  "type": "boolean"
                },
                "max": {
                  "description": "Upper bound of the excluded range.",
                  "type": "number",
                  "format": "double"
                },
                "min": {
                  "description": "Lower bound of the excluded range.",
                  "type": "number",
                  "format": "double"
                }
              }
            }
          }
        },
        {
