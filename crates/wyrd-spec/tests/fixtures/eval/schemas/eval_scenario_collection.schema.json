                  "description": "Whether the range endpoints are inclusive.",
                  "type": "boolean"
                },
                "max": {
                  "description": "Upper bound of the accepted range.",
                  "type": "number",
                  "format": "double"
                },
                "min": {
                  "description": "Lower bound of the accepted range.",
                  "type": "number",
                  "format": "double"
                }
              }
            }
          }
        },
        {
          "description": "Requires the observed value to fall outside the given range.\n\nRuntime rejects `min > max`.",
