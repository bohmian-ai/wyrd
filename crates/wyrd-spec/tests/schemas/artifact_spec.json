{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactSpec",
  "description": "Versioned artifact descriptor.",
  "type": "object",
  "required": [
    "artifact_kind"
  ],
  "properties": {
    "artifact_kind": {
      "description": "Artifact kind.",
      "type": "string"
    },
    "artifact_uris": {
      "description": "Artifact URIs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_type": {
      "description": "MIME content type.",
      "type": [
        "string",
        "null"
      ]
    },
    "external_uri": {
      "description": "External URI.",
      "type": [
        "string",
        "null"
      ]
    },
    "framework_adapter": {
      "description": "Framework adapter metadata for runtime loaders.",
      "anyOf": [
        {
          "$ref": "#/definitions/FrameworkAdapterRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "integrity": {
      "description": "Integrity digest.",
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "description": "Artifact metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "schema_ref": {
      "description": "Schema Card reference.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "description": "Size in bytes.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "FrameworkAdapterRef": {
      "description": "Framework adapter reference for loading or invoking artifacts.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "config": {
          "description": "Non-secret adapter configuration.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "name": {
          "description": "Adapter name.",
          "type": "string"
        },
        "version": {
          "description": "Adapter version or version range.",
          "type": "string"
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
