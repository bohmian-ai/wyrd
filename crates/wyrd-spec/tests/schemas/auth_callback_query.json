{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CallbackQuery",
  "description": "`GET /auth/callback` query.",
  "type": "object",
  "required": [
    "code",
    "state"
  ],
  "properties": {
    "code": {
      "description": "Authorization code from the identity provider callback.",
      "allOf": [
        {
          "$ref": "#/definitions/SecretBearer"
        }
      ]
    },
    "state": {
      "description": "Opaque login state generated by Wyrd.",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    }
  }
}
