{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrincipalKind",
  "description": "Principal-kind discriminator for auth administration requests.",
  "oneOf": [
    {
      "description": "Human user principal.",
      "type": "string",
      "enum": [
        "user"
      ]
    },
    {
      "description": "Service principal.",
      "type": "string",
      "enum": [
        "service"
      ]
    },
    {
      "description": "Agent principal.",
      "type": "string",
      "enum": [
        "agent"
      ]
    }
  ]
}
