{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenRequest",
  "description": "Parameters of `POST /auth/token`, discriminated by `grant_type`.",
  "oneOf": [
    {
      "description": "RFC 6749 §4.1.3: redeem a Wyrd authorization code with its PKCE verifier (RFC 7636 §4.5).",
      "type": "object",
      "required": [
        "code",
        "code_verifier",
        "grant_type",
        "redirect_uri"
      ],
      "properties": {
        "code": {
          "description": "The code `GET /auth/authorize` returned to the redirect URI.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "code_verifier": {
          "description": "The PKCE code verifier whose S256 challenge the request carried.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "authorization_code"
          ]
        },
        "redirect_uri": {
          "description": "The exact redirect URI the authorization request carried.",
          "type": "string"
        }
      }
    },
    {
      "description": "RFC 6749 §6: renew a human session.",
      "type": "object",
      "required": [
        "grant_type",
        "refresh_token"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "enum": [
            "refresh_token"
          ]
        },
        "refresh_token": {
          "description": "The Wyrd refresh token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        }
      }
    },
    {
      "description": "RFC 8628 §3.4: poll with the device code from `POST /auth/device_authorization`.",
      "type": "object",
      "required": [
        "device_code",
        "grant_type"
      ],
      "properties": {
        "device_code": {
          "description": "The device code.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:device_code"
          ]
        }
      }
    },
    {
      "description": "RFC 8693 §2.1 token exchange.\n\nWith an [`ExchangeTokenType::ApiKey`] subject and no actor, the Wyrd API key is exchanged for an access token of its own principal. With an [`ExchangeTokenType::AccessToken`] subject and actor, the actor acts on behalf of the subject: the issued token names the subject as its principal, the actor as its outermost `act`, and `audience` as its `aud`, with the intersection of both parties' permissions.",
      "type": "object",
      "required": [
        "grant_type",
        "subject_token",
        "subject_token_type"
      ],
      "properties": {
        "actor_token": {
          "description": "Access token of the party doing the work; delegation only.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_token_type": {
          "description": "Type of `actor_token`.",
          "anyOf": [
            {
              "$ref": "#/definitions/ExchangeTokenType"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience": {
          "description": "Wyrd resource a delegated token is issued for; delegation only.",
          "anyOf": [
            {
              "$ref": "#/definitions/TokenAudience"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:token-exchange"
          ]
        },
        "subject_token": {
          "description": "The API key, or the access token of the party acted for.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "subject_token_type": {
          "description": "Type of `subject_token`.",
          "allOf": [
            {
              "$ref": "#/definitions/ExchangeTokenType"
            }
          ]
        }
      }
    },
    {
      "description": "RFC 7523 §2.1: a platform-attested workload assertion.",
      "type": "object",
      "required": [
        "assertion",
        "grant_type"
      ],
      "properties": {
        "assertion": {
          "description": "Kubernetes service-account token, SPIFFE JWT-SVID, or cloud token.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:jwt-bearer"
          ]
        },
        "tenant": {
          "description": "Tenant selector fallback when the request host does not carry tenant.",
          "anyOf": [
            {
              "$ref": "#/definitions/TenantSlug"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "ExchangeTokenType": {
      "description": "RFC 8693 §3 token type of a subject, actor, or issued token.",
      "oneOf": [
        {
          "description": "OAuth access token.",
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:token-type:access_token"
          ]
        },
        {
          "description": "A Wyrd API key (`wyrd_sk_…`) or platform credential.",
          "type": "string",
          "enum": [
            "urn:wyrd:oauth:token-type:api_key"
          ]
        }
      ]
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    },
    "TenantSlug": {
      "description": "Human-visible tenant slug resolved to a DataTenantId at the auth boundary.",
      "type": "string"
    },
    "TokenAudience": {
      "description": "Audience (`aud`) of a Wyrd tenant access token.\n\nEvery directly issued token is [`Self::Wyrd`] and is accepted on every tenant surface. A [`Self::Bifrost`] token is accepted only on the Bifrost surfaces, so a token delegated for Bifrost cannot be replayed elsewhere.",
      "oneOf": [
        {
          "description": "Every Wyrd tenant surface.",
          "type": "string",
          "enum": [
            "wyrd"
          ]
        },
        {
          "description": "Only the Bifrost ingest and query surfaces.",
          "type": "string",
          "enum": [
            "bifrost"
          ]
        }
      ]
    }
  }
}
