{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenResponse",
  "description": "Response from `POST /auth/token`.",
  "type": "object",
  "required": [
    "access_token",
    "expires_at",
    "token_type"
  ],
  "properties": {
    "access_token": {
      "description": "Signed Wyrd access token.",
      "allOf": [
        {
          "$ref": "#/definitions/SecretBearer"
        }
      ]
    },
    "expires_at": {
      "description": "Access-token expiry timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "refresh_token": {
      "description": "Refresh token. Present only for grants that issue one: human OIDC login (`authorization_code`), API-key exchange (`wyrd_api_key`), and refresh rotation (`refresh_token`). Absent for the workload `jwt-bearer` and `token-exchange` (delegation) grants, whose clients re-present their durable credential to obtain a fresh access token instead of holding a long-lived refresh secret.",
      "anyOf": [
        {
          "$ref": "#/definitions/SecretBearer"
        },
        {
          "type": "null"
        }
      ]
    },
    "token_type": {
      "description": "Token type.",
      "allOf": [
        {
          "$ref": "#/definitions/TokenType"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    },
    "TokenType": {
      "description": "Bearer token marker.",
      "oneOf": [
        {
          "description": "Bearer token.",
          "type": "string",
          "enum": [
            "Bearer"
          ]
        }
      ]
    }
  }
}
