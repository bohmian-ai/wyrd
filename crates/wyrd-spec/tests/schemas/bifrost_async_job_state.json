{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AsyncJobState",
  "description": "Terminal/in-flight state of an async query job.",
  "oneOf": [
    {
      "description": "Accepted, not yet claimed by an executor.",
      "type": "string",
      "enum": [
        "Queued"
      ]
    },
    {
      "description": "Claimed by an executor.",
      "type": "string",
      "enum": [
        "Claimed"
      ]
    },
    {
      "description": "Executing.",
      "type": "string",
      "enum": [
        "Running"
      ]
    },
    {
      "description": "Completed successfully.",
      "type": "string",
      "enum": [
        "Succeeded"
      ]
    },
    {
      "description": "Failed.",
      "type": "string",
      "enum": [
        "Failed"
      ]
    },
    {
      "description": "Canceled.",
      "type": "string",
      "enum": [
        "Canceled"
      ]
    }
  ]
}
