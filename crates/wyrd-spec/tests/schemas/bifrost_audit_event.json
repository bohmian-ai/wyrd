{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEvent",
  "description": "One audited data-plane operation — the FULL locked M-06 field set.\n\nEvery audited op (register/install, sync query, async submit/status, ingest commit, RBAC deny) appends exactly one hash-chained `AuditEvent` row in the operation's own Postgres transaction. The hash-chain canonical encoding and per-tenant `seq` are owned by `vala-sql`; this type is the Arrow-free, PyO3-free wire/codegen shape.\n\n`card_ref` is the **writer-identity card** (who performed the op), derived from the resolved `Principal`; it is `None` only for a `User` principal. This is decoupled from the per-row `card_ref` data column.",
  "type": "object",
  "required": [
    "auth_method",
    "decision",
    "operation",
    "payload_summary",
    "permission",
    "principal_id",
    "principal_kind",
    "request_id",
    "resource",
    "result"
  ],
  "properties": {
    "auth_method": {
      "description": "How the principal authenticated.",
      "allOf": [
        {
          "$ref": "#/definitions/AuthMethod"
        }
      ]
    },
    "card_ref": {
      "description": "Writer-identity card of the acting principal; `None` for a `User`.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "description": "The authorization decision.",
      "allOf": [
        {
          "$ref": "#/definitions/AuditDecision"
        }
      ]
    },
    "operation": {
      "description": "Logical operation name (e.g. `bifrost.register_table`).",
      "type": "string"
    },
    "payload_summary": {
      "description": "Redacted summary of the operation payload.",
      "type": "string"
    },
    "permission": {
      "description": "Effective RBAC permission checked for the op.",
      "type": "string"
    },
    "principal_id": {
      "description": "Stable ID of the acting principal.",
      "type": "string",
      "format": "uuid"
    },
    "principal_kind": {
      "description": "Kind of the acting principal (tag encoding; card payload is not the audit subject — `card_ref` is its own field).",
      "allOf": [
        {
          "$ref": "#/definitions/PrincipalKind"
        }
      ]
    },
    "request_id": {
      "description": "Request correlation ID of the audited op.",
      "allOf": [
        {
          "$ref": "#/definitions/RequestId"
        }
      ]
    },
    "resource": {
      "description": "Target resource the op acted on (e.g. the fully-qualified table name).",
      "type": "string"
    },
    "result": {
      "description": "Whether the op completed successfully.",
      "allOf": [
        {
          "$ref": "#/definitions/AuditResult"
        }
      ]
    },
    "trace_id": {
      "description": "Distributed-trace ID, when a trace context is present.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "AuditDecision": {
      "description": "The RBAC authorization outcome recorded on an audit row.",
      "oneOf": [
        {
          "description": "The operation was authorized.",
          "type": "string",
          "enum": [
            "allow"
          ]
        },
        {
          "description": "The operation was refused by RBAC.",
          "type": "string",
          "enum": [
            "deny"
          ]
        }
      ]
    },
    "AuditResult": {
      "description": "Whether the audited operation completed successfully.",
      "oneOf": [
        {
          "description": "The operation succeeded.",
          "type": "string",
          "enum": [
            "success"
          ]
        },
        {
          "description": "The operation failed.",
          "type": "string",
          "enum": [
            "failure"
          ]
        }
      ]
    },
    "AuthMethod": {
      "description": "How the acting principal authenticated for an audited data-plane op.",
      "oneOf": [
        {
          "description": "Presented a Wyrd-issued JWT access token.",
          "type": "string",
          "enum": [
            "jwt"
          ]
        },
        {
          "description": "An internal, non-JWT principal (e.g. a system/relay caller).",
          "type": "string",
          "enum": [
            "internal"
          ]
        }
      ]
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "PrincipalKind": {
      "description": "Kind of authenticated identity, carrying the bound card for card-backed kinds.",
      "oneOf": [
        {
          "description": "Human user identity.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Card-bound service identity.",
          "type": "object",
          "required": [
            "card_ref",
            "kind"
          ],
          "properties": {
            "card_ref": {
              "description": "Bound Service card.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "service"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Card-bound agent identity.",
          "type": "object",
          "required": [
            "card_ref",
            "kind"
          ],
          "properties": {
            "card_ref": {
              "description": "Bound Agent card.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RequestId": {
      "description": "Request correlation ID; required to be a UUID v7.",
      "type": "string"
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
