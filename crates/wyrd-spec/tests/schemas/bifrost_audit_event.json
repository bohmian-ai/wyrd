{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEvent",
  "description": "One audited data-plane operation.\n\nEvery audited op (register/install, sync query, async submit/status, ingest commit, RBAC deny) appends exactly one hash-chained `AuditEvent` row in the operation's own Postgres transaction. The hash-chain canonical encoding and per-tenant `seq` are owned by `vala-sql`; this type is the Arrow-free, PyO3-free wire/codegen shape.\n\n`card_ref` is the **writer-identity card** (who performed the op), derived from the resolved `Principal`; it is `None` only for a `User` principal. This is decoupled from the per-row `card_ref` data column.",
  "type": "object",
  "required": [
    "auth_method",
    "decision",
    "operation",
    "payload_summary",
    "permission",
    "principal_id",
    "principal_kind",
    "request_id",
    "resource",
    "result"
  ],
  "properties": {
    "auth_method": {
      "description": "How the principal authenticated.",
      "allOf": [
        {
          "$ref": "#/definitions/AuthMethod"
        }
      ]
    },
    "card_ref": {
      "description": "Writer-identity card of the acting principal; `None` for a `User`.",
      "anyOf": [
        {
          "$ref": "#/definitions/CardRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "description": "The authorization decision.",
      "allOf": [
        {
          "$ref": "#/definitions/AuditDecision"
        }
      ]
    },
    "detail": {
      "description": "Optional typed, redacted operation detail used as the canonical hash preimage.",
      "anyOf": [
        {
          "$ref": "#/definitions/AuditDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "description": "Logical operation name (e.g. `bifrost.register_table`).",
      "type": "string"
    },
    "payload_summary": {
      "description": "Redacted summary of the operation payload.",
      "type": "string"
    },
    "permission": {
      "description": "Effective RBAC permission checked for the op.",
      "type": "string"
    },
    "principal_id": {
      "description": "Stable ID of the acting principal.",
      "type": "string",
      "format": "uuid"
    },
    "principal_kind": {
      "description": "Kind of the acting principal (tag encoding; card payload is not the audit subject — `card_ref` is its own field).",
      "allOf": [
        {
          "$ref": "#/definitions/PrincipalKindTag"
        }
      ]
    },
    "request_id": {
      "description": "Request correlation ID of the audited op.",
      "allOf": [
        {
          "$ref": "#/definitions/RequestId"
        }
      ]
    },
    "resource": {
      "description": "Target resource the op acted on (e.g. the fully-qualified table name).",
      "type": "string"
    },
    "result": {
      "description": "Whether the op completed successfully.",
      "allOf": [
        {
          "$ref": "#/definitions/AuditResult"
        }
      ]
    },
    "trace_id": {
      "description": "Distributed-trace ID, when a trace context is present.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "AuditDecision": {
      "description": "The RBAC authorization outcome recorded on an audit row.",
      "oneOf": [
        {
          "description": "The operation was authorized.",
          "type": "string",
          "enum": [
            "allow"
          ]
        },
        {
          "description": "The operation was refused by RBAC.",
          "type": "string",
          "enum": [
            "deny"
          ]
        }
      ]
    },
    "AuditDetail": {
      "description": "Structured detail for one auditable operation.",
      "oneOf": [
        {
          "description": "Authentication failure metadata; credentials are never representable here.",
          "type": "object",
          "required": [
            "error_code",
            "kind"
          ],
          "properties": {
            "error_code": {
              "description": "Stable reason for the authentication refusal.",
              "allOf": [
                {
                  "$ref": "#/definitions/AuditErrorCode"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "auth_failure"
              ]
            }
          }
        },
        {
          "description": "API-key issuance metadata; the key value is never representable here.",
          "type": "object",
          "required": [
            "api_key_id",
            "expires_at",
            "kind",
            "target_principal_id"
          ],
          "properties": {
            "api_key_id": {
              "description": "Identifier of the issued API key, not its secret value.",
              "type": "string",
              "format": "uuid"
            },
            "expires_at": {
              "description": "Credential expiry.",
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "type": "string",
              "enum": [
                "credential_issuance"
              ]
            },
            "target_principal_id": {
              "description": "Principal receiving the credential.",
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "description": "Token exchange metadata; bearer values are never representable here.",
          "type": "object",
          "required": [
            "actor_principal_id",
            "delegation_chain",
            "expires_at",
            "kind",
            "subject_principal_id"
          ],
          "properties": {
            "actor_principal_id": {
              "description": "Principal that performed the exchange.",
              "type": "string",
              "format": "uuid"
            },
            "delegation_chain": {
              "description": "Typed delegation chain.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/CardRef"
              }
            },
            "expires_at": {
              "description": "Token expiry.",
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "type": "string",
              "enum": [
                "token_exchange"
              ]
            },
            "subject_principal_id": {
              "description": "Subject principal in the exchanged token.",
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "description": "Refresh-token family revocation metadata.",
          "type": "object",
          "required": [
            "kind",
            "principal_id",
            "principal_kind",
            "revoked_token_count"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "refresh_family_revocation"
              ]
            },
            "principal_id": {
              "description": "Principal whose refresh-token family was revoked.",
              "type": "string",
              "format": "uuid"
            },
            "principal_kind": {
              "description": "Principal kind owning the family.",
              "allOf": [
                {
                  "$ref": "#/definitions/PrincipalKindTag"
                }
              ]
            },
            "revoked_token_count": {
              "description": "Number of active refresh rows revoked.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "Authorization decision metadata.",
          "type": "object",
          "required": [
            "callee_principal_id",
            "caller_principal_id",
            "decision",
            "delegation_chain",
            "kind"
          ],
          "properties": {
            "callee_principal_id": {
              "description": "Called principal.",
              "type": "string",
              "format": "uuid"
            },
            "caller_principal_id": {
              "description": "Calling principal.",
              "type": "string",
              "format": "uuid"
            },
            "decision": {
              "description": "Authorization result.",
              "allOf": [
                {
                  "$ref": "#/definitions/AuditDecision"
                }
              ]
            },
            "delegation_chain": {
              "description": "Typed delegation chain.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/CardRef"
              }
            },
            "deny_reason": {
              "description": "Stable denial reason, present only for a denial.",
              "anyOf": [
                {
                  "$ref": "#/definitions/AuditErrorCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "authz_check"
              ]
            }
          }
        },
        {
          "description": "Card registration metadata.",
          "type": "object",
          "required": [
            "card_kind",
            "card_uid",
            "kind",
            "operation"
          ],
          "properties": {
            "after_spec_hash": {
              "description": "Resulting spec hash, when applicable.",
              "type": [
                "string",
                "null"
              ]
            },
            "before_spec_hash": {
              "description": "Prior spec hash, when applicable.",
              "type": [
                "string",
                "null"
              ]
            },
            "card_kind": {
              "description": "Registered card kind.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardKind"
                }
              ]
            },
            "card_uid": {
              "description": "Registered card UID.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardUid"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "card_registration"
              ]
            },
            "operation": {
              "description": "Registration operation.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRegistrationOperation"
                }
              ]
            },
            "outcome": {
              "description": "Registration outcome, when applicable.",
              "anyOf": [
                {
                  "$ref": "#/definitions/CardRegistrationOutcome"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "description": "Card-scope mint metadata; scope members are references, never secrets.",
          "type": "object",
          "required": [
            "kind",
            "mint_kind",
            "root_card_ref",
            "scope_members"
          ],
          "properties": {
            "failure_code": {
              "description": "Stable failure code, present only on failure.",
              "anyOf": [
                {
                  "$ref": "#/definitions/AuditErrorCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "card_scope_mint"
              ]
            },
            "mint_kind": {
              "description": "How the scope was minted.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardScopeMintKind"
                }
              ]
            },
            "root_card_ref": {
              "description": "Root card reference.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "scope_hash": {
              "description": "Stable scope digest.",
              "type": [
                "string",
                "null"
              ]
            },
            "scope_member_count": {
              "description": "Number of scope members.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "scope_members": {
              "description": "Typed scope members.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/CardRef"
              }
            }
          }
        },
        {
          "description": "Storage lifecycle transition metadata.",
          "type": "object",
          "required": [
            "backend",
            "kind",
            "operation",
            "status_code",
            "storage_path"
          ],
          "properties": {
            "backend": {
              "description": "Closed backend identifier.",
              "allOf": [
                {
                  "$ref": "#/definitions/StorageBackend"
                }
              ]
            },
            "error_code": {
              "description": "Stable failure code, when applicable.",
              "anyOf": [
                {
                  "$ref": "#/definitions/AuditErrorCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "storage"
              ]
            },
            "operation": {
              "description": "Storage transition.",
              "allOf": [
                {
                  "$ref": "#/definitions/StorageAuditOperation"
                }
              ]
            },
            "status_code": {
              "description": "HTTP/backend status code.",
              "type": "integer",
              "format": "uint16",
              "minimum": 0.0
            },
            "storage_path": {
              "description": "Logical storage path.",
              "type": "string"
            },
            "upload_id": {
              "description": "Multipart upload identifier, when applicable.",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        },
        {
          "description": "Ingest batch metadata.",
          "type": "object",
          "required": [
            "batch_id",
            "decision",
            "kind",
            "origin",
            "record_count",
            "table"
          ],
          "properties": {
            "batch_id": {
              "description": "Idempotent batch identifier.",
              "type": "string"
            },
            "decision": {
              "description": "Ingest authorization decision.",
              "allOf": [
                {
                  "$ref": "#/definitions/AuditDecision"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "ingest"
              ]
            },
            "origin": {
              "description": "Code-origin of the emitting card or agent.",
              "allOf": [
                {
                  "$ref": "#/definitions/Origin"
                }
              ]
            },
            "record_count": {
              "description": "Number of records in the batch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "table": {
              "description": "Destination Bifrost table.",
              "type": "string"
            }
          }
        }
      ]
    },
    "AuditErrorCode": {
      "description": "Closed stable codes used for audit failures and denial reasons.",
      "oneOf": [
        {
          "description": "The caller lacked the required permission.",
          "type": "string",
          "enum": [
            "PERMISSION_DENIED"
          ]
        },
        {
          "description": "The audit outbox was unavailable.",
          "type": "string",
          "enum": [
            "AUDIT_UNAVAILABLE"
          ]
        },
        {
          "description": "The supplied token was invalid.",
          "type": "string",
          "enum": [
            "INVALID_TOKEN"
          ]
        },
        {
          "description": "The requested resource was not found.",
          "type": "string",
          "enum": [
            "NOT_FOUND"
          ]
        },
        {
          "description": "The operation failed in the storage backend.",
          "type": "string",
          "enum": [
            "STORAGE_BACKEND_FAILURE"
          ]
        },
        {
          "description": "The operation failed validation.",
          "type": "string",
          "enum": [
            "VALIDATION_FAILED"
          ]
        }
      ]
    },
    "AuditResult": {
      "description": "Whether the audited operation completed successfully.",
      "oneOf": [
        {
          "description": "The operation succeeded.",
          "type": "string",
          "enum": [
            "success"
          ]
        },
        {
          "description": "The operation failed.",
          "type": "string",
          "enum": [
            "failure"
          ]
        }
      ]
    },
    "AuthMethod": {
      "description": "How the acting principal authenticated for an audited data-plane op.",
      "oneOf": [
        {
          "description": "Presented a Wyrd-issued JWT access token.",
          "type": "string",
          "enum": [
            "jwt"
          ]
        },
        {
          "description": "An internal, non-JWT principal (e.g. a system/relay caller).",
          "type": "string",
          "enum": [
            "internal"
          ]
        }
      ]
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardRegistrationOperation": {
      "description": "Closed card-registration operation names.",
      "oneOf": [
        {
          "description": "A card was registered.",
          "type": "string",
          "enum": [
            "register"
          ]
        },
        {
          "description": "A card was updated.",
          "type": "string",
          "enum": [
            "update"
          ]
        },
        {
          "description": "A card was deleted.",
          "type": "string",
          "enum": [
            "delete"
          ]
        }
      ]
    },
    "CardRegistrationOutcome": {
      "description": "Closed card-registration outcomes.",
      "oneOf": [
        {
          "description": "A new card was created.",
          "type": "string",
          "enum": [
            "created"
          ]
        },
        {
          "description": "The registration was an idempotent no-op.",
          "type": "string",
          "enum": [
            "idempotent_noop"
          ]
        },
        {
          "description": "The registration was deduplicated.",
          "type": "string",
          "enum": [
            "deduplicated"
          ]
        }
      ]
    },
    "CardScopeMintKind": {
      "description": "Closed card-scope mint operation names.",
      "oneOf": [
        {
          "description": "Minted during API-key exchange.",
          "type": "string",
          "enum": [
            "api_key_exchange"
          ]
        },
        {
          "description": "Minted during token refresh.",
          "type": "string",
          "enum": [
            "refresh"
          ]
        },
        {
          "description": "Minted for delegation.",
          "type": "string",
          "enum": [
            "delegation"
          ]
        },
        {
          "description": "Minted during JWT bearer exchange.",
          "type": "string",
          "enum": [
            "jwt_bearer"
          ]
        }
      ]
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "CommitSha": {
      "type": "string",
      "maxLength": 40,
      "minLength": 7,
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "Origin": {
      "description": "Code-origin provenance for a card: the repository commit it was declared from, plus the in-repo path for monorepo disambiguation.",
      "type": "object",
      "required": [
        "commit",
        "repo"
      ],
      "properties": {
        "commit": {
          "description": "Commit the card was declared from. When `dirty`, this is the base commit of the uncommitted working tree.",
          "allOf": [
            {
              "$ref": "#/definitions/CommitSha"
            }
          ]
        },
        "dirty": {
          "description": "Whether the card was declared from an uncommitted working tree.",
          "type": "boolean"
        },
        "path": {
          "description": "Declaration path within the repository (monorepo disambiguation).",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "Normalized repository identifier, e.g. `github.com/org/repo`.",
          "type": "string"
        }
      }
    },
    "PrincipalKindTag": {
      "description": "Principal-kind discriminator without a bound card.\n\nSerializes as a bare snake_case string (`\"user\"`, `\"service\"`, `\"agent\"`); this is a stable wire contract for the revoke request body, token claims, and the revocation NOTIFY channel.",
      "oneOf": [
        {
          "description": "Human user principal.",
          "type": "string",
          "enum": [
            "user"
          ]
        },
        {
          "description": "Service principal.",
          "type": "string",
          "enum": [
            "service"
          ]
        },
        {
          "description": "Agent principal.",
          "type": "string",
          "enum": [
            "agent"
          ]
        }
      ]
    },
    "RequestId": {
      "description": "Request correlation ID; required to be a UUID v7.",
      "type": "string"
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "StorageAuditOperation": {
      "description": "Closed operation names for storage lifecycle audit rows.",
      "oneOf": [
        {
          "description": "An upload session was durably created.",
          "type": "string",
          "enum": [
            "session_created"
          ]
        },
        {
          "description": "The object-store backend was initialized.",
          "type": "string",
          "enum": [
            "backend_initialized"
          ]
        },
        {
          "description": "The object-store backend initialization failed.",
          "type": "string",
          "enum": [
            "backend_failed"
          ]
        },
        {
          "description": "An upload completed.",
          "type": "string",
          "enum": [
            "complete"
          ]
        },
        {
          "description": "An upload was aborted.",
          "type": "string",
          "enum": [
            "abort"
          ]
        },
        {
          "description": "A download was initialized.",
          "type": "string",
          "enum": [
            "download"
          ]
        },
        {
          "description": "A stale upload was reclaimed.",
          "type": "string",
          "enum": [
            "reclaimed"
          ]
        }
      ]
    },
    "StorageBackend": {
      "description": "Closed storage backend identifiers.",
      "oneOf": [
        {
          "description": "Local filesystem backend.",
          "type": "string",
          "enum": [
            "local"
          ]
        },
        {
          "description": "Amazon S3 backend.",
          "type": "string",
          "enum": [
            "s3"
          ]
        },
        {
          "description": "Google Cloud Storage backend.",
          "type": "string",
          "enum": [
            "gcs"
          ]
        },
        {
          "description": "Azure Blob Storage backend.",
          "type": "string",
          "enum": [
            "azure"
          ]
        }
      ]
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
