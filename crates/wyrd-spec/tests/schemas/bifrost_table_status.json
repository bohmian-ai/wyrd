{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TableStatus",
  "description": "Lifecycle status of a registered Bifrost table.",
  "oneOf": [
    {
      "description": "Table is active and writable.",
      "type": "string",
      "enum": [
        "Active"
      ]
    },
    {
      "description": "Table is deprecated but still readable.",
      "type": "string",
      "enum": [
        "Deprecated"
      ]
    },
    {
      "description": "Table is quarantined and not writable.",
      "type": "string",
      "enum": [
        "Quarantined"
      ]
    }
  ]
}
