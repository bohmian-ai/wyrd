{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardKind",
  "description": "Native Wyrd Card kind plus forward-compatible external catch-all.",
  "oneOf": [
    {
      "description": "Data Card.",
      "type": "string",
      "enum": [
        "Data"
      ]
    },
    {
      "description": "Model Card.",
      "type": "string",
      "enum": [
        "Model"
      ]
    },
    {
      "description": "Experiment Card.",
      "type": "string",
      "enum": [
        "Experiment"
      ]
    },
    {
      "description": "Prompt Card.",
      "type": "string",
      "enum": [
        "Prompt"
      ]
    },
    {
      "description": "Tool Card.",
      "type": "string",
      "enum": [
        "Tool"
      ]
    },
    {
      "description": "Agent Card.",
      "type": "string",
      "enum": [
        "Agent"
      ]
    },
    {
      "description": "Workflow Card.",
      "type": "string",
      "enum": [
        "Workflow"
      ]
    },
    {
      "description": "Evaluation Card.",
      "type": "string",
      "enum": [
        "Eval"
      ]
    },
    {
      "description": "Drift Card.",
      "type": "string",
      "enum": [
        "Drift"
      ]
    },
    {
      "description": "Service Card.",
      "type": "string",
      "enum": [
        "Service"
      ]
    },
    {
      "description": "Policy Card.",
      "type": "string",
      "enum": [
        "Policy"
      ]
    },
    {
      "description": "MCP Card.",
      "type": "string",
      "enum": [
        "Mcp"
      ]
    },
    {
      "description": "Skill Card.",
      "type": "string",
      "enum": [
        "Skill"
      ]
    },
    {
      "description": "Sub-agent Card.",
      "type": "string",
      "enum": [
        "SubAgent"
      ]
    },
    {
      "description": "Audit Card.",
      "type": "string",
      "enum": [
        "Audit"
      ]
    },
    {
      "description": "Artifact Card.",
      "type": "string",
      "enum": [
        "Artifact"
      ]
    },
    {
      "description": "Unknown Card kind with schema hash.",
      "type": "object",
      "required": [
        "External"
      ],
      "properties": {
        "External": {
          "type": "object",
          "required": [
            "name",
            "schema_hash"
          ],
          "properties": {
            "name": {
              "description": "External kind name.",
              "type": "string"
            },
            "schema_hash": {
              "description": "32-byte schema hash.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              },
              "maxItems": 32,
              "minItems": 32
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
