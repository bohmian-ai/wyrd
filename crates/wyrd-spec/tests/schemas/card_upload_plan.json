{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardUploadPlan",
  "description": "Upload plan group keyed by the resolved card reference.",
  "type": "object",
  "required": [
    "card_ref",
    "entries"
  ],
  "properties": {
    "card_ref": {
      "description": "Card whose submission declared the artifact manifest.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "entries": {
      "description": "One server-minted upload per manifest entry.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardUploadEntry"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "CardUploadEntry": {
      "description": "One tenant-scoped, server-minted upload for a card artifact.",
      "type": "object",
      "required": [
        "plan",
        "relative_path",
        "upload_id"
      ],
      "properties": {
        "plan": {
          "description": "Backend-specific transfer protocol minted by the storage service.",
          "allOf": [
            {
              "$ref": "#/definitions/UploadPlan"
            }
          ]
        },
        "relative_path": {
          "description": "Manifest path this upload accepts.",
          "type": "string"
        },
        "upload_id": {
          "description": "Durable storage upload identifier used for part URLs and completion.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HeaderPair": {
      "description": "Required HTTP header for a client upload request.",
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "description": "Header name.",
          "type": "string"
        },
        "value": {
          "description": "Header value.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "UploadPlan": {
      "description": "Tagged union describing how the client uploads bytes.",
      "oneOf": [
        {
          "description": "Single PUT to a presigned URL.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "put_url",
                "ttl_secs"
              ],
              "properties": {
                "put_url": {
                  "description": "Presigned PUT URL.",
                  "type": "string"
                },
                "required_headers": {
                  "description": "Headers the client must include on the PUT.",
                  "default": [],
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HeaderPair"
                  }
                },
                "ttl_secs": {
                  "description": "URL time-to-live in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "single_put"
              ]
            }
          }
        },
        {
          "description": "Local filesystem auth-gated upload.\n\nSignals that the upload URL is an auth-gated server route for one server-minted upload capability, not a caller-selected storage path.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "put_url",
                "ttl_secs"
              ],
              "properties": {
                "put_url": {
                  "description": "Server route PUT URL.",
                  "type": "string"
                },
                "ttl_secs": {
                  "description": "URL time-to-live in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "local_fs"
              ]
            }
          }
        },
        {
          "description": "AWS S3 multipart upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "part_count",
                "part_size_bytes",
                "part_url_ttl_secs"
              ],
              "properties": {
                "part_count": {
                  "description": "Number of parts planned.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "part_size_bytes": {
                  "description": "Size of each non-final part.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "part_url_ttl_secs": {
                  "description": "Time-to-live for per-part URLs in seconds.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "required_headers": {
                  "description": "Headers the client must include on each part PUT.",
                  "default": [],
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HeaderPair"
                  }
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "s3_multipart"
              ]
            }
          }
        },
        {
          "description": "Google Cloud Storage resumable upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "chunk_size_bytes",
                "session_uri"
              ],
              "properties": {
                "chunk_size_bytes": {
                  "description": "Recommended chunk size in bytes.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "session_uri": {
                  "description": "Resumable session URI returned once to the client.",
                  "type": "string"
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "gcs_resumable"
              ]
            }
          }
        },
        {
          "description": "Azure block blob upload.",
          "type": "object",
          "required": [
            "data",
            "protocol"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "block_count_planned",
                "block_size_bytes",
                "sas_url"
              ],
              "properties": {
                "block_count_planned": {
                  "description": "Number of blocks the server expects to commit.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "block_size_bytes": {
                  "description": "Recommended block size in bytes.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "sas_url": {
                  "description": "SAS URL returned once to the client.",
                  "type": "string"
                }
              }
            },
            "protocol": {
              "type": "string",
              "enum": [
                "azure_block_blob"
              ]
            }
          }
        }
      ]
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
