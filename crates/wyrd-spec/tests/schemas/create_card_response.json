{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateCardResponse",
  "description": "Composite registration response.",
  "type": "object",
  "required": [
    "outcomes",
    "root",
    "upload_plans"
  ],
  "properties": {
    "outcomes": {
      "description": "Per-submission outcomes in server topo order.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRegistrationOutcome"
      }
    },
    "root": {
      "description": "Server-derived graph root.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "upload_plans": {
      "description": "Upload plans for artifact-bearing submissions.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardUploadPlan"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardLifecycleStatus": {
      "description": "Server-managed lifecycle state for a Card.",
      "oneOf": [
        {
          "description": "Registration is waiting for artifact upload and verification.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Card is available for use.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Card has been superseded by a newer version.",
          "type": "string",
          "enum": [
            "deprecated"
          ]
        },
        {
          "description": "Registration failed and awaits cleanup or retry.",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "Registration expired before completion.",
          "type": "string",
          "enum": [
            "expired"
          ]
        },
        {
          "description": "Card was soft-deleted.",
          "type": "string",
          "enum": [
            "deleted"
          ]
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardRegistrationOutcome": {
      "description": "Outcome for one submission in a composite registration.",
      "type": "object",
      "required": [
        "card_ref",
        "outcome",
        "spec_hash",
        "status"
      ],
      "properties": {
        "artifact_hash": {
          "description": "BLAKE3 hex hash of the sorted artifact manifest, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "card_blob_uri": {
          "description": "URI of the durable card blob once written.",
          "type": [
            "string",
            "null"
          ]
        },
        "card_ref": {
          "description": "Server-resolved card identity.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        "outcome": {
          "description": "Registration result for this submission.",
          "allOf": [
            {
              "$ref": "#/definitions/RegistrationOutcomeKind"
            }
          ]
        },
        "spec_hash": {
          "description": "BLAKE3 hex hash of the JCS-canonical resolved spec.",
          "type": "string"
        },
        "status": {
          "description": "Server-managed lifecycle state.",
          "allOf": [
            {
              "$ref": "#/definitions/CardLifecycleStatus"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "CardUploadPlan": {
      "description": "Upload plan group keyed by the resolved card reference.",
      "type": "object",
      "required": [
        "card_ref",
        "entries"
      ],
      "properties": {
        "card_ref": {
          "description": "Card whose submission declared the artifact manifest.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        "entries": {
          "description": "One presigned upload per manifest entry.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PresignedUpload"
          }
        }
      },
      "additionalProperties": false
    },
    "HttpMethod": {
      "description": "HTTP method permitted for a presigned upload.",
      "oneOf": [
        {
          "description": "Upload bytes with a single PUT request.",
          "type": "string",
          "enum": [
            "PUT"
          ]
        }
      ]
    },
    "PresignedUpload": {
      "description": "One tenant-scoped, single-artifact presigned upload.",
      "type": "object",
      "required": [
        "expires_at",
        "method",
        "relative_path",
        "url"
      ],
      "properties": {
        "expires_at": {
          "description": "URL expiration instant.",
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "description": "Only `PUT` is legal for v1 artifact uploads.",
          "allOf": [
            {
              "$ref": "#/definitions/HttpMethod"
            }
          ]
        },
        "relative_path": {
          "description": "Manifest path this URL accepts.",
          "type": "string"
        },
        "required_headers": {
          "description": "Headers required by the storage provider.",
          "default": [],
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "url": {
          "description": "Presigned PUT URL.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RegistrationOutcomeKind": {
      "description": "Result of a registration write.",
      "oneOf": [
        {
          "description": "A new registration row was created.",
          "type": "string",
          "enum": [
            "registered"
          ]
        },
        {
          "description": "The same idempotent request was replayed.",
          "type": "string",
          "enum": [
            "idempotent_noop"
          ]
        },
        {
          "description": "An active card with identical content already exists.",
          "type": "string",
          "enum": [
            "deduplicated"
          ]
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
