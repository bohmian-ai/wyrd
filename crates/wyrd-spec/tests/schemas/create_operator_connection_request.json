{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateOperatorConnectionRequest",
  "description": "`POST /v1/operator-connections` body.",
  "oneOf": [
    {
      "description": "A Slack workspace bot token.",
      "type": "object",
      "required": [
        "bot_token",
        "name",
        "provider",
        "workspace_id"
      ],
      "properties": {
        "bot_token": {
          "description": "Bot token with `chat:write`.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "name": {
          "description": "Immutable connection name.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "slack"
          ]
        },
        "workspace_id": {
          "description": "Slack workspace (team) ID the token belongs to.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A PagerDuty Global Integration key.",
      "type": "object",
      "required": [
        "integration_key",
        "name",
        "provider"
      ],
      "properties": {
        "integration_key": {
          "description": "Events API v2 Global Integration key.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretBearer"
            }
          ]
        },
        "name": {
          "description": "Immutable connection name.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "pager_duty"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Credentials for one HTTPS origin.",
      "type": "object",
      "required": [
        "auth",
        "name",
        "origin",
        "provider"
      ],
      "properties": {
        "auth": {
          "description": "The credential and its scheme.",
          "allOf": [
            {
              "$ref": "#/definitions/HttpConnectionAuth"
            }
          ]
        },
        "name": {
          "description": "Immutable connection name.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectionName"
            }
          ]
        },
        "origin": {
          "description": "The only origin these credentials may be sent to.",
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": [
            "http"
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ConnectionName": {
      "description": "Immutable tenant-scoped Operator connection name, unique per provider.",
      "type": "string"
    },
    "HttpConnectionAuth": {
      "description": "Write-only HTTP credential of a create or update.",
      "oneOf": [
        {
          "description": "`Authorization: Bearer <token>`.",
          "type": "object",
          "required": [
            "scheme",
            "token"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "enum": [
                "bearer"
              ]
            },
            "token": {
              "description": "The bearer token.",
              "allOf": [
                {
                  "$ref": "#/definitions/SecretBearer"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "`Authorization: Basic` from a username and password.",
          "type": "object",
          "required": [
            "password",
            "scheme",
            "username"
          ],
          "properties": {
            "password": {
              "description": "The password.",
              "allOf": [
                {
                  "$ref": "#/definitions/SecretBearer"
                }
              ]
            },
            "scheme": {
              "type": "string",
              "enum": [
                "basic"
              ]
            },
            "username": {
              "description": "The username; treated as secret.",
              "allOf": [
                {
                  "$ref": "#/definitions/SecretBearer"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A custom header carrying `value`.",
          "type": "object",
          "required": [
            "name",
            "scheme",
            "value"
          ],
          "properties": {
            "name": {
              "description": "Header name; case-insensitive, never a server-owned header.",
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "header"
              ]
            },
            "value": {
              "description": "The header value.",
              "allOf": [
                {
                  "$ref": "#/definitions/SecretBearer"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SecretBearer": {
      "description": "Opaque secret. Redacted in logs and audit payloads.",
      "writeOnly": true,
      "type": "string",
      "format": "password"
    }
  }
}
