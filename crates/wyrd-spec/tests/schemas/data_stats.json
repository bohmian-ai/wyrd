{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataStats",
  "description": "Storage and byte-level statistics for a DataCard source.",
  "type": "object",
  "required": [
    "byte_count",
    "sha256"
  ],
  "properties": {
    "byte_count": {
      "description": "Number of bytes represented by this data artifact or source.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "col_count": {
      "description": "Optional column count.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "row_count": {
      "description": "Optional row count.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "sha256": {
      "description": "Lowercase SHA-256 hex digest for the represented bytes.",
      "type": "string"
    }
  }
}
