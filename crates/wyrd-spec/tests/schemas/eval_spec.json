{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalSpec",
  "description": "Reusable evaluation logic and pass gates.",
  "type": "object",
  "required": [
    "eval_type"
  ],
  "properties": {
    "assertions": {
      "description": "Assertion definitions.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvalAssertion"
      }
    },
    "dataset_refs": {
      "description": "Dataset references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "description": {
      "description": "Eval description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": true
    },
    "eval_type": {
      "description": "Eval type, such as `judge`, `assertion`, or `benchmark`.",
      "type": "string"
    },
    "judge_refs": {
      "description": "Judge Card references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "pass_gates": {
      "description": "Pass gate definitions.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvalPassGate"
      }
    },
    "target_refs": {
      "description": "Target Card references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "CardKind": {
      "description": "Native Wyrd Card kind plus forward-compatible external catch-all.",
      "oneOf": [
        {
          "description": "Data Card.",
          "type": "string",
          "enum": [
            "Data"
          ]
        },
        {
          "description": "Model Card.",
          "type": "string",
          "enum": [
            "Model"
          ]
        },
        {
          "description": "Experiment Card.",
          "type": "string",
          "enum": [
            "Experiment"
          ]
        },
        {
          "description": "Prompt Card.",
          "type": "string",
          "enum": [
            "Prompt"
          ]
        },
        {
          "description": "Tool Card.",
          "type": "string",
          "enum": [
            "Tool"
          ]
        },
        {
          "description": "Agent Card.",
          "type": "string",
          "enum": [
            "Agent"
          ]
        },
        {
          "description": "Workflow Card.",
          "type": "string",
          "enum": [
            "Workflow"
          ]
        },
        {
          "description": "Evaluation Card.",
          "type": "string",
          "enum": [
            "Eval"
          ]
        },
        {
          "description": "Drift Card.",
          "type": "string",
          "enum": [
            "Drift"
          ]
        },
        {
          "description": "Service Card.",
          "type": "string",
          "enum": [
            "Service"
          ]
        },
        {
          "description": "Policy Card.",
          "type": "string",
          "enum": [
            "Policy"
          ]
        },
        {
          "description": "MCP Card.",
          "type": "string",
          "enum": [
            "Mcp"
          ]
        },
        {
          "description": "Skill Card.",
          "type": "string",
          "enum": [
            "Skill"
          ]
        },
        {
          "description": "Sub-agent Card.",
          "type": "string",
          "enum": [
            "SubAgent"
          ]
        },
        {
          "description": "Audit Card.",
          "type": "string",
          "enum": [
            "Audit"
          ]
        },
        {
          "description": "Artifact Card.",
          "type": "string",
          "enum": [
            "Artifact"
          ]
        },
        {
          "description": "Unknown Card kind with schema hash.",
          "type": "object",
          "required": [
            "External"
          ],
          "properties": {
            "External": {
              "type": "object",
              "required": [
                "name",
                "schema_hash"
              ],
              "properties": {
                "name": {
                  "description": "External kind name.",
                  "type": "string"
                },
                "schema_hash": {
                  "description": "32-byte schema hash.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  },
                  "maxItems": 32,
                  "minItems": 32
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space; omitted means current/default space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "EvalAssertion": {
      "description": "Evaluation assertion.",
      "type": "object",
      "required": [
        "name",
        "rule"
      ],
      "properties": {
        "metadata": {
          "description": "Assertion metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "name": {
          "description": "Assertion name.",
          "type": "string"
        },
        "rule": {
          "description": "Assertion expression or declarative rule.",
          "type": "string"
        }
      }
    },
    "EvalPassGate": {
      "description": "Evaluation pass gate.",
      "type": "object",
      "required": [
        "name",
        "operator",
        "threshold"
      ],
      "properties": {
        "name": {
          "description": "Metric or assertion name.",
          "type": "string"
        },
        "operator": {
          "description": "Comparison operator.",
          "type": "string"
        },
        "threshold": {
          "description": "Threshold value.",
          "type": "number",
          "format": "double"
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
