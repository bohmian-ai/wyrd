{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalSpec",
  "description": "Reusable evaluation logic and pass gates.",
  "type": "object",
  "required": [
    "eval_type"
  ],
  "properties": {
    "assertions": {
      "description": "Assertion definitions.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvalAssertion"
      }
    },
    "dataset_refs": {
      "description": "Dataset references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "default_parameters": {
      "description": "Default non-secret parameters for eval orchestration.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ParameterValue"
      }
    },
    "description": {
      "description": "Eval description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "eval_type": {
      "description": "Eval type, such as `judge`, `assertion`, or `benchmark`.",
      "allOf": [
        {
          "$ref": "#/definitions/EvalType"
        }
      ]
    },
    "governance": {
      "description": "Governance and audit requirements.",
      "anyOf": [
        {
          "$ref": "#/definitions/Governance"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge_refs": {
      "description": "Judge Card references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "observation_hooks": {
      "description": "Observation routing for eval runs.",
      "anyOf": [
        {
          "$ref": "#/definitions/ObservationHooks"
        },
        {
          "type": "null"
        }
      ]
    },
    "pass_gates": {
      "description": "Pass gate definitions.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvalPassGate"
      }
    },
    "profile": {
      "description": "Reusable evaluation profile.",
      "anyOf": [
        {
          "$ref": "#/definitions/EvalProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_refs": {
      "description": "Target Card references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "AgenticEvalProfile": {
      "description": "Agentic eval profile.",
      "type": "object",
      "properties": {
        "max_steps": {
          "description": "Maximum step count for the evaluated behavior.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "required_tools": {
          "description": "Required tool names or Card aliases.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarios": {
          "description": "Scenario definitions.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvalScenario"
          }
        }
      }
    },
    "AssertionEvalProfile": {
      "description": "Assertion-based eval profile.",
      "type": "object",
      "properties": {
        "input_schema": {
          "description": "Optional input schema."
        },
        "output_schema": {
          "description": "Optional output schema."
        },
        "rules": {
          "description": "Assertion expressions or rule names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BenchmarkEvalProfile": {
      "description": "Benchmark eval profile.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "dataset_refs": {
          "description": "Dataset Card references.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        },
        "metrics": {
          "description": "Expected metric names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "Benchmark name.",
          "type": "string"
        }
      }
    },
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Tool",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Skill",
        "SubAgent",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "External"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space; omitted means current/default space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "CustomEvalProfile": {
      "description": "Custom eval profile.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "config": {
          "description": "Non-secret profile configuration.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "name": {
          "description": "Custom profile name.",
          "type": "string"
        }
      }
    },
    "EvalAssertion": {
      "description": "Evaluation assertion.",
      "type": "object",
      "required": [
        "name",
        "rule"
      ],
      "properties": {
        "metadata": {
          "description": "Assertion metadata.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "name": {
          "description": "Assertion name.",
          "type": "string"
        },
        "rule": {
          "description": "Assertion expression or declarative rule.",
          "type": "string"
        }
      }
    },
    "EvalPassGate": {
      "description": "Evaluation pass gate.",
      "type": "object",
      "required": [
        "name",
        "operator",
        "threshold"
      ],
      "properties": {
        "name": {
          "description": "Metric or assertion name.",
          "type": "string"
        },
        "operator": {
          "description": "Comparison operator.",
          "type": "string"
        },
        "threshold": {
          "description": "Threshold value.",
          "type": "number",
          "format": "double"
        }
      }
    },
    "EvalProfile": {
      "description": "Typed reusable evaluation profile.",
      "oneOf": [
        {
          "description": "Assertion bundle profile.",
          "type": "object",
          "required": [
            "config",
            "type"
          ],
          "properties": {
            "config": {
              "$ref": "#/definitions/AssertionEvalProfile"
            },
            "type": {
              "type": "string",
              "enum": [
                "assertion"
              ]
            }
          }
        },
        {
          "description": "Judge prompt/profile.",
          "type": "object",
          "required": [
            "config",
            "type"
          ],
          "properties": {
            "config": {
              "$ref": "#/definitions/JudgeEvalProfile"
            },
            "type": {
              "type": "string",
              "enum": [
                "judge"
              ]
            }
          }
        },
        {
          "description": "Benchmark profile.",
          "type": "object",
          "required": [
            "config",
            "type"
          ],
          "properties": {
            "config": {
              "$ref": "#/definitions/BenchmarkEvalProfile"
            },
            "type": {
              "type": "string",
              "enum": [
                "benchmark"
              ]
            }
          }
        },
        {
          "description": "Agentic evaluation profile.",
          "type": "object",
          "required": [
            "config",
            "type"
          ],
          "properties": {
            "config": {
              "$ref": "#/definitions/AgenticEvalProfile"
            },
            "type": {
              "type": "string",
              "enum": [
                "agentic"
              ]
            }
          }
        },
        {
          "description": "Custom profile.",
          "type": "object",
          "required": [
            "config",
            "type"
          ],
          "properties": {
            "config": {
              "$ref": "#/definitions/CustomEvalProfile"
            },
            "type": {
              "type": "string",
              "enum": [
                "custom"
              ]
            }
          }
        }
      ]
    },
    "EvalRubricItem": {
      "description": "Judge rubric item.",
      "type": "object",
      "required": [
        "description",
        "name"
      ],
      "properties": {
        "description": {
          "description": "Criterion description.",
          "type": "string"
        },
        "name": {
          "description": "Rubric criterion name.",
          "type": "string"
        },
        "weight": {
          "description": "Optional weight.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "EvalScenario": {
      "description": "Agentic eval scenario.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "expectations": {
          "description": "Expected outcomes or checks.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "description": "Scenario input values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ParameterValue"
          }
        },
        "name": {
          "description": "Scenario name.",
          "type": "string"
        }
      }
    },
    "EvalType": {
      "description": "Reusable evaluation category.",
      "oneOf": [
        {
          "description": "Rule/assertion evaluation.",
          "type": "string",
          "enum": [
            "assertion"
          ]
        },
        {
          "description": "LLM or model judge evaluation.",
          "type": "string",
          "enum": [
            "judge"
          ]
        },
        {
          "description": "Dataset or benchmark evaluation.",
          "type": "string",
          "enum": [
            "benchmark"
          ]
        },
        {
          "description": "Agentic evaluation of tool use or multi-step behavior.",
          "type": "string",
          "enum": [
            "agentic"
          ]
        },
        {
          "description": "Custom evaluation profile.",
          "type": "string",
          "enum": [
            "custom"
          ]
        }
      ]
    },
    "Governance": {
      "description": "Declarative governance and audit hooks.",
      "type": "object",
      "properties": {
        "approval_requirements": {
          "description": "Required approval labels or scopes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_ref": {
          "description": "Audit Card reference.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "description": "Governance metadata.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "policy_refs": {
          "description": "Policy Card references.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        }
      }
    },
    "JudgeEvalProfile": {
      "description": "Judge-based eval profile.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Judge configuration without secret values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "prompt_refs": {
          "description": "Prompt Cards used by the judge.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        },
        "rubric": {
          "description": "Judge rubric.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvalRubricItem"
          }
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "ObservationHooks": {
      "description": "Observation routing hooks for Cards that produce runs or events.",
      "type": "object",
      "properties": {
        "events": {
          "description": "Event names to observe.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_refs": {
          "description": "Observation route Card references.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        }
      }
    },
    "ParameterValue": {
      "description": "Typed parameter value for experiments, runs, workflows, and tools.",
      "oneOf": [
        {
          "description": "Integer value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "int"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "description": "Floating-point value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "float"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "Structured JSON value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json"
              ]
            },
            "value": true
          }
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
