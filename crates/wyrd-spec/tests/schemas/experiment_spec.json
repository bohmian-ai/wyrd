{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentSpec",
  "description": "Grouping and comparison context for related runs.",
  "type": "object",
  "properties": {
    "best_run_ref": {
      "description": "Best run reference.",
      "anyOf": [
        {
          "$ref": "#/definitions/RunRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "card_refs": {
      "description": "Artifact references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Ref"
      }
    },
    "default_parameters": {
      "description": "Default parameters applied to runs.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ParameterValue"
      }
    },
    "description": {
      "description": "Experiment description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "experiment_type": {
      "description": "Experiment type.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_refs": {
      "description": "Associated runs.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RunRef"
      }
    },
    "summary_metrics": {
      "description": "Summary metrics for comparison.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/MetricEntry"
      }
    },
    "target_refs": {
      "description": "Primary target Cards.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Ref"
      }
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "LabelValue": {
      "description": "Validated value for queryable Card and Run labels.",
      "type": "string"
    },
    "MetricEntry": {
      "description": "Metric summary entry.",
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "created_at": {
          "description": "Metric creation timestamp.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "is_eval": {
          "description": "Whether this metric came from evaluation.",
          "default": false,
          "type": "boolean"
        },
        "name": {
          "description": "Metric name.",
          "type": "string"
        },
        "step": {
          "description": "Optional step.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "timestamp": {
          "description": "Metric event timestamp.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "value": {
          "description": "Numeric metric value.",
          "type": "number",
          "format": "double"
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "ParameterValue": {
      "description": "Typed parameter value for experiments, runs, workflows, and tools.",
      "oneOf": [
        {
          "description": "Integer value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "int"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "description": "Floating-point value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "float"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "Structured JSON value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json"
              ]
            },
            "value": true
          }
        }
      ]
    },
    "Ref": {
      "description": "A reference position that requires durable identity.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. Authored `Ref` values remain external references even when they identify a submitted card.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "RunKind": {
      "description": "Execution kind recorded as a Run.",
      "oneOf": [
        {
          "description": "Training execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "training"
              ]
            }
          }
        },
        {
          "description": "Inference execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inference"
              ]
            }
          }
        },
        {
          "description": "Offline or batch evaluation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "offline_eval"
              ]
            }
          }
        },
        {
          "description": "Drift check execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "drift_check"
              ]
            }
          }
        },
        {
          "description": "Import execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "import"
              ]
            }
          }
        },
        {
          "description": "Workflow execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "workflow"
              ]
            }
          }
        },
        {
          "description": "Autonomous remediation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "remediation"
              ]
            }
          }
        },
        {
          "description": "Externally defined execution kind.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "external"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "RunRef": {
      "description": "Reference to a Run.",
      "type": "object",
      "required": [
        "kind",
        "uid"
      ],
      "properties": {
        "kind": {
          "description": "Run kind.",
          "allOf": [
            {
              "$ref": "#/definitions/RunKind"
            }
          ]
        },
        "labels": {
          "description": "Query/display labels.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/LabelValue"
          }
        },
        "space": {
          "description": "Optional space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Run UID. Promoted to `RunUid` in the Runs phase.",
          "type": "string"
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
