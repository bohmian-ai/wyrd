{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayCapturePolicyWrite",
  "description": "`PUT /v1/admin/gateway/capture-policy` body.",
  "type": "object",
  "required": [
    "mode",
    "payload_fields"
  ],
  "properties": {
    "mode": {
      "description": "Capture mode.",
      "allOf": [
        {
          "$ref": "#/definitions/GatewayCaptureMode"
        }
      ]
    },
    "payload_fields": {
      "description": "Payload fields; empty unless `mode` is `payload`.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/GatewayPayloadField"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GatewayCaptureMode": {
      "description": "Gateway-call capture mode.",
      "oneOf": [
        {
          "description": "Publish nothing to Bifrost.",
          "type": "string",
          "enum": [
            "disabled"
          ]
        },
        {
          "description": "Publish call metadata without request or response content.",
          "type": "string",
          "enum": [
            "metadata"
          ]
        },
        {
          "description": "Publish metadata plus the selected redacted payload fields.",
          "type": "string",
          "enum": [
            "payload"
          ]
        }
      ]
    },
    "GatewayPayloadField": {
      "description": "Payload column selected for capture.",
      "oneOf": [
        {
          "description": "Redacted request payload.",
          "type": "string",
          "enum": [
            "request"
          ]
        },
        {
          "description": "Redacted response payload.",
          "type": "string",
          "enum": [
            "response"
          ]
        }
      ]
    }
  }
}
