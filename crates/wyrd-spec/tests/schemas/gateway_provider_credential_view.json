{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCredentialView",
  "description": "Redacted read view of one provider credential.",
  "type": "object",
  "required": [
    "created_at",
    "name",
    "provider",
    "source",
    "state",
    "updated_at"
  ],
  "properties": {
    "created_at": {
      "description": "First creation time.",
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "description": "Tenant-unique credential name.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCredentialName"
        }
      ]
    },
    "provider": {
      "description": "Provider the credential authenticates to.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderId"
        }
      ]
    },
    "revoked_at": {
      "description": "Revocation time, if revoked.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rotated_at": {
      "description": "Last active replacement time, if ever rotated.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "description": "Redacted source.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCredentialSourceView"
        }
      ]
    },
    "state": {
      "description": "Lifecycle state.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCredentialState"
        }
      ]
    },
    "updated_at": {
      "description": "Last mutation time.",
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CredentialBindingName": {
      "description": "Operator-configured gateway credential binding name.",
      "type": "string"
    },
    "ProviderCredentialName": {
      "description": "Tenant-unique gateway provider credential name.",
      "type": "string"
    },
    "ProviderCredentialSourceView": {
      "description": "Redacted credential source.\n\nDiscloses no plaintext, ciphertext, digest, fingerprint, prefix, or suffix.",
      "oneOf": [
        {
          "description": "Operator-configured binding.",
          "type": "object",
          "required": [
            "environment"
          ],
          "properties": {
            "environment": {
              "type": "object",
              "required": [
                "binding"
              ],
              "properties": {
                "binding": {
                  "description": "Binding name.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/CredentialBindingName"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "External secret backend reference.",
          "type": "object",
          "required": [
            "external_secret"
          ],
          "properties": {
            "external_secret": {
              "type": "object",
              "required": [
                "backend",
                "reference"
              ],
              "properties": {
                "backend": {
                  "description": "Configured backend identity.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/SecretBackendName"
                    }
                  ]
                },
                "reference": {
                  "description": "Opaque backend reference.",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Wyrd-protected tenant secret; the view carries no member at all.",
          "type": "string",
          "enum": [
            "managed_secret"
          ]
        }
      ]
    },
    "ProviderCredentialState": {
      "description": "Lifecycle state of a provider credential.",
      "oneOf": [
        {
          "description": "Usable by newly admitted calls.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Terminally revoked; cannot be replaced or reactivated.",
          "type": "string",
          "enum": [
            "revoked"
          ]
        }
      ]
    },
    "ProviderId": {
      "description": "Tenant-visible gateway provider identifier using the canonical Wyrd name grammar.",
      "type": "string"
    },
    "SecretBackendName": {
      "description": "Operator-configured external secret backend identity.",
      "type": "string"
    }
  }
}
