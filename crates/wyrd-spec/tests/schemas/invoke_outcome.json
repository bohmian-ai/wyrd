{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvokeOutcome",
  "description": "Invocation outcome passed to post-invoke Policy Cards.",
  "type": "object",
  "required": [
    "success"
  ],
  "properties": {
    "error_code": {
      "description": "Machine-readable error code.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_ref": {
      "description": "Run reference produced by the invocation.",
      "anyOf": [
        {
          "$ref": "#/definitions/RunRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "success": {
      "description": "Whether the invocation succeeded.",
      "type": "boolean"
    },
    "summary": {
      "description": "Runtime outcome summary; runtime phases validate schemas and redact before audit."
    }
  },
  "definitions": {
    "LabelValue": {
      "description": "Validated value for queryable Card and Run labels.",
      "type": "string"
    },
    "RunKind": {
      "description": "Execution kind recorded as a Run.",
      "oneOf": [
        {
          "description": "Training execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "training"
              ]
            }
          }
        },
        {
          "description": "Inference execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inference"
              ]
            }
          }
        },
        {
          "description": "Offline or batch evaluation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "offline_eval"
              ]
            }
          }
        },
        {
          "description": "Drift check execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "drift_check"
              ]
            }
          }
        },
        {
          "description": "Import execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "import"
              ]
            }
          }
        },
        {
          "description": "Workflow execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "workflow"
              ]
            }
          }
        },
        {
          "description": "Autonomous remediation execution.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "remediation"
              ]
            }
          }
        },
        {
          "description": "Externally defined execution kind.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "external"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "RunRef": {
      "description": "Reference to a Run.",
      "type": "object",
      "required": [
        "kind",
        "uid"
      ],
      "properties": {
        "kind": {
          "description": "Run kind.",
          "allOf": [
            {
              "$ref": "#/definitions/RunKind"
            }
          ]
        },
        "labels": {
          "description": "Query/display labels.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/LabelValue"
          }
        },
        "space": {
          "description": "Optional space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Run UID. Promoted to `RunUid` in the Runs phase.",
          "type": "string"
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    }
  }
}
