{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatorBudget",
  "description": "Operator execution budget.",
  "type": "object",
  "properties": {
    "max_memory_mb": {
      "description": "Maximum memory in MiB.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "max_tool_calls": {
      "description": "Maximum tool calls allowed during invocation.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "max_wall_seconds": {
      "description": "Maximum wall-clock runtime in seconds.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  }
}
