{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyDecision",
  "description": "Policy evaluation decision.",
  "oneOf": [
    {
      "description": "Permit the operation.",
      "type": "object",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "allow"
          ]
        }
      }
    },
    {
      "description": "Deny the operation with a human-readable reason.",
      "type": "object",
      "required": [
        "reason",
        "verdict"
      ],
      "properties": {
        "reason": {
          "description": "Denial reason.",
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "deny"
          ]
        }
      }
    }
  ]
}
