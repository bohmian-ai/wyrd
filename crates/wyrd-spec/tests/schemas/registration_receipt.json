{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistrationReceipt",
  "description": "Server-resolved registration receipt.",
  "type": "object",
  "required": [
    "card_ref",
    "created_at",
    "outcome",
    "status"
  ],
  "properties": {
    "card_ref": {
      "description": "Resolved card reference.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    },
    "created_at": {
      "description": "Creation timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "description": "Registration result.",
      "allOf": [
        {
          "$ref": "#/definitions/RegisterOutcome"
        }
      ]
    },
    "principal_id": {
      "description": "Principal attributed to the operation.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "status": {
      "description": "Lifecycle status.",
      "allOf": [
        {
          "$ref": "#/definitions/CardLifecycleStatus"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardLifecycleStatus": {
      "description": "Server-managed lifecycle state for a Card.",
      "oneOf": [
        {
          "description": "Registration is waiting for artifact upload and verification.",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "Card is available for use.",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "Card has been superseded by a newer version.",
          "type": "string",
          "enum": [
            "deprecated"
          ]
        },
        {
          "description": "Registration failed and awaits cleanup or retry.",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "Registration expired before completion.",
          "type": "string",
          "enum": [
            "expired"
          ]
        },
        {
          "description": "Card was soft-deleted.",
          "type": "string",
          "enum": [
            "deleted"
          ]
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "RegisterOutcome": {
      "description": "Result of a registration write.",
      "oneOf": [
        {
          "description": "A new registration row was created.",
          "type": "string",
          "enum": [
            "created"
          ]
        },
        {
          "description": "The same idempotent request was replayed.",
          "type": "string",
          "enum": [
            "idempotent_noop"
          ]
        },
        {
          "description": "An active card with identical content already exists.",
          "type": "string",
          "enum": [
            "deduplicated"
          ]
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
