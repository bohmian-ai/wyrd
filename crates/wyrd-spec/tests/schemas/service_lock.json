{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceLock",
  "description": "Installed service lock.",
  "type": "object",
  "required": [
    "lock_hash",
    "ref"
  ],
  "properties": {
    "components": {
      "description": "Locked components.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/LockedComponent"
      }
    },
    "lock_hash": {
      "description": "Lock hash.",
      "type": "string"
    },
    "metadata": {
      "description": "Lock metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "ref": {
      "description": "Locked service reference.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "LockedComponent": {
      "description": "Locked resolved service component.",
      "type": "object",
      "required": [
        "alias",
        "ref"
      ],
      "properties": {
        "alias": {
          "description": "Local AppState handle.",
          "type": "string"
        },
        "content_hash": {
          "description": "Content hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "installed_path": {
          "description": "Installed artifact path, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "description": "Component metadata.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "ref": {
          "description": "Exact locked Card reference.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
