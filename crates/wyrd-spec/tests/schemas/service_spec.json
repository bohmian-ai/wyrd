{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceSpec",
  "description": "Composition of cards used by an application or deployment.",
  "type": "object",
  "properties": {
    "components": {
      "description": "Alias-bound components.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ServiceComponent"
      }
    },
    "content_hash": {
      "description": "Content hash.",
      "type": [
        "string",
        "null"
      ]
    },
    "credential_refs": {
      "description": "Credential references required by this service.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialRef"
      }
    },
    "deployment": {
      "description": "Deployment metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "description": {
      "description": "Service description.",
      "type": [
        "string",
        "null"
      ]
    },
    "entry_point": {
      "description": "Entry point descriptor.",
      "type": [
        "string",
        "null"
      ]
    },
    "lock_hash": {
      "description": "Lock hash.",
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "description": "Free-form metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "runtime": {
      "description": "Optional server-side runtime declaration.",
      "anyOf": [
        {
          "$ref": "#/definitions/ServiceRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_config": {
      "description": "Service config.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "service_type": {
      "description": "Service type.",
      "type": [
        "string",
        "null"
      ]
    },
    "verified_by": {
      "description": "Continuous verification bindings owned by this Service as a whole.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/VerificationBinding"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Verifier",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "ComponentSource": {
      "description": "Development-time local source resolved by `lock` or `install`.",
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "description": "Source kind hint.",
          "type": "string"
        },
        "path": {
          "description": "Local path.",
          "type": "string"
        }
      }
    },
    "CredentialRef": {
      "description": "Reference to a credential or secret managed outside public Card specs.",
      "type": "object",
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "description": "Key or logical name in that provider.",
          "type": "string"
        },
        "provider": {
          "description": "Credential provider or secret store name.",
          "type": "string"
        }
      }
    },
    "HttpAuth": {
      "description": "Server-side authentication sources for an HTTP action.",
      "oneOf": [
        {
          "description": "No authentication.",
          "type": "object",
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Bearer token loaded from an environment variable.",
          "type": "object",
          "required": [
            "env",
            "scheme"
          ],
          "properties": {
            "env": {
              "description": "Environment variable name.",
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "bearer"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "`user:password` loaded from an environment variable.",
          "type": "object",
          "required": [
            "env",
            "scheme"
          ],
          "properties": {
            "env": {
              "description": "Environment variable name.",
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "basic"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Custom header value loaded from an environment variable.",
          "type": "object",
          "required": [
            "env",
            "name",
            "scheme"
          ],
          "properties": {
            "env": {
              "description": "Environment variable name.",
              "type": "string"
            },
            "name": {
              "description": "Header name.",
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "header"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "HttpMethod": {
      "description": "HTTP methods supported by an HTTP Operator action.",
      "oneOf": [
        {
          "description": "GET.",
          "type": "string",
          "enum": [
            "get"
          ]
        },
        {
          "description": "POST.",
          "type": "string",
          "enum": [
            "post"
          ]
        },
        {
          "description": "PUT.",
          "type": "string",
          "enum": [
            "put"
          ]
        },
        {
          "description": "PATCH.",
          "type": "string",
          "enum": [
            "patch"
          ]
        },
        {
          "description": "DELETE.",
          "type": "string",
          "enum": [
            "delete"
          ]
        }
      ]
    },
    "InlineableRef_for_OperatorSpec": {
      "description": "A reference position that may carry an embedded child spec.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. `Inline` bodies are authored, not synthesized by the loader.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "An embedded child spec.",
          "allOf": [
            {
              "$ref": "#/definitions/OperatorSpec"
            }
          ]
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "InlineableRef_for_TriggerSpec": {
      "description": "A reference position that may carry an embedded child spec.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. `Inline` bodies are authored, not synthesized by the loader.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "An embedded child spec.",
          "allOf": [
            {
              "$ref": "#/definitions/TriggerSpec"
            }
          ]
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "NotifyChannel": {
      "description": "Typed notification destinations.",
      "oneOf": [
        {
          "description": "PagerDuty event payload.",
          "type": "object",
          "required": [
            "kind",
            "severity",
            "summary"
          ],
          "properties": {
            "dedup_key": {
              "description": "Optional de-duplication key.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "pager_duty"
              ]
            },
            "severity": {
              "description": "PagerDuty severity.",
              "type": "string"
            },
            "summary": {
              "description": "Human-readable event summary.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Slack message payload.",
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "slack"
              ]
            },
            "text": {
              "description": "Message text.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "OperatorBudget": {
      "description": "Operator execution limits.",
      "type": "object",
      "properties": {
        "max_tool_calls": {
          "description": "Maximum tool calls allowed during invocation.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "max_wall_seconds": {
          "description": "Maximum wall-clock runtime in seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "OperatorSpec": {
      "description": "A server-owned side-effect template.",
      "type": "object",
      "oneOf": [
        {
          "description": "Dispatch a registered Workflow.",
          "type": "object",
          "required": [
            "kind",
            "workflow_ref"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workflow"
              ]
            },
            "workflow_ref": {
              "description": "Workflow to dispatch with the trigger context.",
              "allOf": [
                {
                  "$ref": "#/definitions/Ref"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Send a typed notification.",
          "type": "object",
          "required": [
            "channel",
            "kind"
          ],
          "properties": {
            "channel": {
              "description": "Notification destination and payload.",
              "allOf": [
                {
                  "$ref": "#/definitions/NotifyChannel"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "notify"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Perform an HTTP request.",
          "type": "object",
          "required": [
            "kind",
            "method",
            "url"
          ],
          "properties": {
            "auth": {
              "description": "Optional server-side authentication binding.",
              "anyOf": [
                {
                  "$ref": "#/definitions/HttpAuth"
                },
                {
                  "type": "null"
                }
              ]
            },
            "body": {
              "description": "Optional structured JSON body."
            },
            "expect_status": {
              "description": "Optional expected response status.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "minimum": 0.0
            },
            "headers": {
              "description": "Optional request headers.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "method": {
              "description": "HTTP method.",
              "allOf": [
                {
                  "$ref": "#/definitions/HttpMethod"
                }
              ]
            },
            "timeout_seconds": {
              "description": "Optional request timeout.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "url": {
              "description": "URL template.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ],
      "properties": {
        "budget": {
          "description": "Optional execution limits.",
          "anyOf": [
            {
              "$ref": "#/definitions/OperatorBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "Optional human-readable purpose.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Ref": {
      "description": "A reference position that requires durable identity.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. Authored `Ref` values remain external references even when they identify a submitted card.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "ServiceComponent": {
      "description": "Alias-bound service component.",
      "type": "object",
      "required": [
        "alias",
        "ref"
      ],
      "properties": {
        "alias": {
          "description": "Local AppState handle.",
          "type": "string"
        },
        "config": {
          "description": "Component config. TODO: does this earn its place?",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "credential_refs": {
          "description": "Component credential references. TODO: does this earn its place?",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CredentialRef"
          }
        },
        "ref": {
          "description": "Canonical Card reference.",
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ]
        },
        "source": {
          "description": "Optional development-time source.",
          "anyOf": [
            {
              "$ref": "#/definitions/ComponentSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_by": {
          "description": "Continuous verification bindings owned by this component occurrence.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/VerificationBinding"
          }
        }
      }
    },
    "ServiceRuntime": {
      "description": "Server-side runtime declaration; tenancy is inherited from `Card.metadata.space`.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "config": {
          "description": "Non-secret runtime configuration.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "framework": {
          "description": "Framework or adapter hint.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Runtime kind.",
          "allOf": [
            {
              "$ref": "#/definitions/ServiceRuntimeKind"
            }
          ]
        },
        "mode": {
          "description": "Runtime placement mode.",
          "anyOf": [
            {
              "$ref": "#/definitions/ServiceRuntimeMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "description": "Runtime policy settings.",
          "anyOf": [
            {
              "$ref": "#/definitions/ServiceRuntimePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "strict": {
          "description": "Whether the runtime should fail closed on unsupported features.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ServiceRuntimeKind": {
      "description": "Service runtime kind.",
      "oneOf": [
        {
          "description": "API service runtime.",
          "type": "string",
          "enum": [
            "api"
          ]
        },
        {
          "description": "MCP service runtime.",
          "type": "string",
          "enum": [
            "mcp"
          ]
        },
        {
          "description": "Agent service runtime.",
          "type": "string",
          "enum": [
            "agent"
          ]
        },
        {
          "description": "Workflow service runtime.",
          "type": "string",
          "enum": [
            "workflow"
          ]
        }
      ]
    },
    "ServiceRuntimeMode": {
      "description": "Service runtime placement mode.",
      "oneOf": [
        {
          "description": "Run inside Wyrd's server process.",
          "type": "string",
          "enum": [
            "in_process"
          ]
        }
      ]
    },
    "ServiceRuntimePolicy": {
      "description": "Service runtime policy settings.",
      "type": "object",
      "properties": {
        "runtime_hooks": {
          "description": "Whether to invoke Policy Cards around server-side runtime calls.",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "TriggerSpec": {
      "description": "Declarative activation for a bound Verifier.",
      "type": "object",
      "oneOf": [
        {
          "description": "Activate on each due occurrence of a cron schedule.",
          "type": "object",
          "required": [
            "cron",
            "kind"
          ],
          "properties": {
            "cron": {
              "description": "Cron expression.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "schedule"
              ]
            },
            "tz": {
              "description": "Optional IANA timezone; absent means UTC.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Activate on each successfully committed observation for the subject.\n\nDeclared as a fieldless struct variant so the enum-level `deny_unknown_fields` applies: a unit variant's internally tagged visitor would silently drain every sibling key, admitting typos and pasted secrets. The authored wire shape stays `{kind: observations_ready}`.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "observations_ready"
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "properties": {
        "description": {
          "description": "Optional human-readable purpose.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "VerificationBinding": {
      "description": "One inline declaration attaching a Verifier to its containing subject.\n\nAuthored on a Service, a Service component occurrence, or a standalone Agent. Registration resolves and UID-pins the Verifier, the effective Trigger, and every effective Operator before the owning Card persists.",
      "type": "object",
      "required": [
        "runs_on",
        "verifier"
      ],
      "properties": {
        "on_failure": {
          "description": "Operators dispatched independently after a `failed` verdict.\n\nEmpty means a failed result stays durable with no reaction.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/InlineableRef_for_OperatorSpec"
          }
        },
        "runs_on": {
          "description": "When the bound Verifier runs, inline or as a referenced Trigger Card.",
          "allOf": [
            {
              "$ref": "#/definitions/InlineableRef_for_TriggerSpec"
            }
          ]
        },
        "verifier": {
          "description": "The exact Verifier Card this subject is verified by.",
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ]
        }
      },
      "additionalProperties": false
    },
