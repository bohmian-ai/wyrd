{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SplitStrategy",
  "description": "Data split strategy.",
  "oneOf": [
    {
      "description": "Reference to an already materialized split artifact.",
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Materialized"
          ]
        },
        "value": {
          "$ref": "#/definitions/CardRef"
        }
      }
    },
    {
      "description": "Predicate over a schema column.",
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Column"
          ]
        },
        "value": {
          "type": "object",
          "required": [
            "name",
            "op",
            "value"
          ],
          "properties": {
            "name": {
              "description": "Schema column referenced by the predicate.",
              "allOf": [
                {
                  "$ref": "#/definitions/ColumnName"
                }
              ]
            },
            "op": {
              "description": "Predicate operator.",
              "allOf": [
                {
                  "$ref": "#/definitions/Inequality"
                }
              ]
            },
            "value": {
              "description": "Predicate comparison value.",
              "allOf": [
                {
                  "$ref": "#/definitions/ColValue"
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Positional range using inclusive start and exclusive stop.",
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "IndexRange"
          ]
        },
        "value": {
          "type": "object",
          "required": [
            "start",
            "stop"
          ],
          "properties": {
            "start": {
              "description": "Inclusive starting index.",
              "type": "integer",
              "format": "int64"
            },
            "stop": {
              "description": "Exclusive stopping index.",
              "type": "integer",
              "format": "int64"
            }
          }
        }
      }
    },
    {
      "description": "Explicit positional indices.",
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Indices"
          ]
        },
        "value": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  ],
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "ColValue": {
      "description": "Literal value used by a column split predicate.",
      "anyOf": [
        {
          "description": "Signed integer predicate value.",
          "type": "integer",
          "format": "int64"
        },
        {
          "description": "Floating-point predicate value.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "String predicate value.",
          "type": "string"
        },
        {
          "description": "Boolean predicate value.",
          "type": "boolean"
        },
        {
          "description": "UTC timestamp predicate value.",
          "type": "string",
          "format": "date-time"
        },
        {
          "description": "List predicate value used by membership checks.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ColValue"
          }
        }
      ]
    },
    "ColumnName": {
      "description": "DataCard column name.",
      "type": "string"
    },
    "Inequality": {
      "description": "Predicate operator for a column split.",
      "oneOf": [
        {
          "description": "Equality comparison.",
          "type": "string",
          "enum": [
            "Eq"
          ]
        },
        {
          "description": "Inequality comparison.",
          "type": "string",
          "enum": [
            "Ne"
          ]
        },
        {
          "description": "Greater-than comparison.",
          "type": "string",
          "enum": [
            "Gt"
          ]
        },
        {
          "description": "Greater-than-or-equal comparison.",
          "type": "string",
          "enum": [
            "Ge"
          ]
        },
        {
          "description": "Less-than comparison.",
          "type": "string",
          "enum": [
            "Lt"
          ]
        },
        {
          "description": "Less-than-or-equal comparison.",
          "type": "string",
          "enum": [
            "Le"
          ]
        },
        {
          "description": "Membership comparison.",
          "type": "string",
          "enum": [
            "In"
          ]
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
