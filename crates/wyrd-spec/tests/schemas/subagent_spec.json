{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubAgentSpec",
  "description": "Declarative sub-agent definition for harnesses.",
  "type": "object",
  "properties": {
    "background": {
      "description": "Whether background execution is allowed by the harness.",
      "default": false,
      "type": "boolean"
    },
    "compatible_clis": {
      "description": "Compatible CLI names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Sub-agent description.",
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Free-form details.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "disallowed_tools": {
      "description": "Disallowed tool names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effort": {
      "description": "Effort setting.",
      "type": [
        "string",
        "null"
      ]
    },
    "governance": {
      "description": "Governance and audit controls.",
      "anyOf": [
        {
          "$ref": "#/definitions/Governance"
        },
        {
          "type": "null"
        }
      ]
    },
    "isolation": {
      "description": "Isolation descriptor.",
      "type": [
        "string",
        "null"
      ]
    },
    "max_turns": {
      "description": "Maximum turns.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "mcp_servers": {
      "description": "MCP server references or names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "description": "Memory descriptor.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "model": {
      "description": "Model selector.",
      "type": [
        "string",
        "null"
      ]
    },
    "observation_hooks": {
      "description": "Observation hooks.",
      "anyOf": [
        {
          "$ref": "#/definitions/ObservationHooks"
        },
        {
          "type": "null"
        }
      ]
    },
    "permission_mode": {
      "description": "Permission mode.",
      "type": [
        "string",
        "null"
      ]
    },
    "sandbox_mode": {
      "description": "Sandbox mode.",
      "type": [
        "string",
        "null"
      ]
    },
    "skill_refs": {
      "description": "Skill references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    },
    "system_prompt": {
      "description": "System prompt or prompt reference text.",
      "type": [
        "string",
        "null"
      ]
    },
    "temperature": {
      "description": "Model temperature.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "tool_refs": {
      "description": "Tool references.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CardRef"
      }
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Native Wyrd Card kind string or external kind object.",
      "oneOf": [
        {
          "title": "NativeCardKind",
          "description": "Native Wyrd Card kind.",
          "type": "string",
          "enum": [
            "Data",
            "Model",
            "Experiment",
            "Prompt",
            "Tool",
            "Agent",
            "Workflow",
            "Eval",
            "Drift",
            "Service",
            "Policy",
            "Mcp",
            "Skill",
            "SubAgent",
            "Audit",
            "Artifact",
            "Trigger",
            "Operator"
          ]
        },
        {
          "title": "ExternalCardKind",
          "description": "External Card kind with schema hash.",
          "type": "object",
          "required": [
            "kind",
            "schema_hash"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "schema_hash": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Optional space; omitted means current/default space.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "Governance": {
      "description": "Declarative governance and audit hooks.",
      "type": "object",
      "properties": {
        "approval_requirements": {
          "description": "Required approval labels or scopes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_ref": {
          "description": "Audit Card reference.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "description": "Governance metadata.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/NonSecretValue"
          }
        },
        "policy_refs": {
          "description": "Policy Card references.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        }
      }
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "ObservationHooks": {
      "description": "Observation routing hooks for Cards that produce runs or events.",
      "type": "object",
      "properties": {
        "events": {
          "description": "Event names to observe.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_refs": {
          "description": "Observation route Card references.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardRef"
          }
        }
      }
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
