{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriggerSource",
  "description": "Observation source evaluated by a Trigger.",
  "oneOf": [
    {
      "description": "Drift observations, optionally limited to one publisher.",
      "type": "object",
      "required": [
        "drift_ref",
        "kind"
      ],
      "properties": {
        "drift_ref": {
          "description": "Drift card to evaluate.",
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "drift_observation"
          ]
        },
        "subject_filter": {
          "description": "Optional publisher restriction.",
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Eval observations, optionally limited to one publisher.",
      "type": "object",
      "required": [
        "eval_ref",
        "kind"
      ],
      "properties": {
        "eval_ref": {
          "description": "Eval card to evaluate.",
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "eval_observation"
          ]
        },
        "subject_filter": {
          "description": "Optional publisher restriction.",
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, optional space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.\n\nAuthors may omit it; the loader inherits the enclosing card's resolved metadata space before the reference crosses a wire boundary.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpaceName"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Optional server-resolved durable UID.\n\nAuthors identify a dependency with `(kind, space, name, version)` and may omit this field. The server resolves that reference to a [`CardUid`] before registration; the UID is then used for durable authorization and lineage without changing the authored reference identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "Ref": {
      "description": "A reference position that requires durable identity.\n\nLoaders rewrite `Path` values to `Sibling` values before submitting a request; the server rejects unresolved paths at the wire boundary. Authored `Ref` values remain external references even when they identify a submitted card.",
      "anyOf": [
        {
          "description": "A direct reference to a registered Card.",
          "allOf": [
            {
              "$ref": "#/definitions/CardRef"
            }
          ]
        },
        {
          "description": "A loader-projected reference to another submission in the same request.",
          "type": "object",
          "required": [
            "sibling"
          ],
          "properties": {
            "sibling": {
              "description": "Exact identity of the sibling submission.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            }
          }
        },
        {
          "description": "A local authored path awaiting loader resolution.",
          "type": "string"
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
