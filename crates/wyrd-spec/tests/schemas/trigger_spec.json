{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriggerSpec",
  "description": "Declarative trigger that invokes an Operator when its source condition fires.",
  "type": "object",
  "required": [
    "source",
    "target"
  ],
  "properties": {
    "config": {
      "description": "Non-secret trigger configuration.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NonSecretValue"
      }
    },
    "cooldown_seconds": {
      "description": "Minimum cooldown between firings, in seconds.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "source": {
      "description": "Trigger source.",
      "allOf": [
        {
          "$ref": "#/definitions/TriggerSource"
        }
      ]
    },
    "target": {
      "description": "Target Operator Card reference.",
      "allOf": [
        {
          "$ref": "#/definitions/CardRef"
        }
      ]
    }
  },
  "definitions": {
    "CardKind": {
      "title": "CardKind",
      "description": "Wyrd Card kind.",
      "type": "string",
      "enum": [
        "Data",
        "Model",
        "Experiment",
        "Prompt",
        "Agent",
        "Workflow",
        "Eval",
        "Drift",
        "Service",
        "Policy",
        "Mcp",
        "Audit",
        "Artifact",
        "Trigger",
        "Operator",
        "Source"
      ]
    },
    "CardName": {
      "description": "Human-visible Card name.",
      "type": "string"
    },
    "CardRef": {
      "description": "Reference to a registered Card by kind, name, version, space, and optional UID.",
      "type": "object",
      "required": [
        "kind",
        "name",
        "space",
        "version"
      ],
      "properties": {
        "kind": {
          "description": "Referenced Card kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CardKind"
            }
          ]
        },
        "name": {
          "description": "Referenced Card name.",
          "allOf": [
            {
              "$ref": "#/definitions/CardName"
            }
          ]
        },
        "space": {
          "description": "Space pinning identity together with `name` and `version`.",
          "allOf": [
            {
              "$ref": "#/definitions/SpaceName"
            }
          ]
        },
        "uid": {
          "description": "Optional resolved UID.",
          "anyOf": [
            {
              "$ref": "#/definitions/CardUid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "Exact referenced Card version.",
          "allOf": [
            {
              "$ref": "#/definitions/VersionBlock"
            }
          ]
        }
      }
    },
    "CardUid": {
      "description": "Resolved immutable Card UID.",
      "type": "string"
    },
    "NonSecretValue": {
      "description": "Non-secret JSON-like configuration value.",
      "oneOf": [
        {
          "description": "String value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "str"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "description": "Numeric value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Boolean value.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "description": "List of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        },
        {
          "description": "Object of non-secret values.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/NonSecretValue"
              }
            }
          }
        }
      ]
    },
    "SpaceName": {
      "description": "Human-visible namespace for Cards and Runs.",
      "type": "string"
    },
    "TriggerSource": {
      "description": "Trigger source declaration.",
      "oneOf": [
        {
          "description": "Drift observation emitted by a Drift Card.",
          "type": "object",
          "required": [
            "card",
            "kind"
          ],
          "properties": {
            "card": {
              "description": "Source Drift Card reference.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "drift_observation"
              ]
            }
          }
        },
        {
          "description": "Evaluation observation emitted by an Eval Card.",
          "type": "object",
          "required": [
            "card",
            "kind"
          ],
          "properties": {
            "card": {
              "description": "Source Eval Card reference.",
              "allOf": [
                {
                  "$ref": "#/definitions/CardRef"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "eval_observation"
              ]
            }
          }
        },
        {
          "description": "Cron schedule.",
          "type": "object",
          "required": [
            "cron",
            "kind"
          ],
          "properties": {
            "cron": {
              "description": "Cron expression.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "schedule"
              ]
            }
          }
        }
      ]
    },
    "VersionBlock": {
      "description": "Semver-compatible version string.",
      "type": "string"
    }
  }
}
