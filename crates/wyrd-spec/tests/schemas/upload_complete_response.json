{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UploadCompleteResponse",
  "description": "Server response after an upload completes.",
  "type": "object",
  "required": [
    "stored"
  ],
  "properties": {
    "stored": {
      "description": "Wire-only descriptor for the stored bytes.",
      "allOf": [
        {
          "$ref": "#/definitions/StoredObjectRef"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "StoredObjectRef": {
      "description": "Verified stored object descriptor returned after upload completion.",
      "type": "object",
      "required": [
        "created_at",
        "sha256",
        "size_bytes",
        "storage_path"
      ],
      "properties": {
        "content_type": {
          "description": "Object content type when known.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "description": "Server completion timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "description": "Verified base64-encoded SHA-256 digest.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Verified byte length.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sse_marker": {
          "description": "Backend-specific server-side-encryption marker when known.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "storage_path": {
          "description": "Full tenant-scoped storage path.",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
