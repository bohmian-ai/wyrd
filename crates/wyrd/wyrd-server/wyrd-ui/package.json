{
  "name": "wyrd-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "package": "pnpm --filter wyrd-ai-ui build",
    "dev": "pnpm package && vite",
    "build": "pnpm package && vite build",
    "preview": "vite preview",
    "check": "pnpm package && pnpm --filter wyrd-ai-ui check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm package && node --input-type=module -e 'import assert from \"node:assert/strict\"; const loaders = await import(\"wyrd-ai-ui/loaders\"); const mcp = await import(\"wyrd-ai-ui/mcp\"); assert.equal(loaders.chartParams(\"SELECT $1\", undefined).code, \"WYRD_SPEC_400_VALIDATION\"); assert.equal(typeof mcp.mcpExecutor, \"function\");' && vitest run",
    "tokens": "node brand/gen-theme.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/svelte": "latest",
    "@types/node": "latest",
    "@wyrd/testing": "link:../../../../sdks/wyrd-sdk-ts/testing",
    "autoprefixer": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest",
    "wyrd-ai-ui": "workspace:*",
    "zod": "4.5.4"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@xyflow/svelte": "^1.6.6",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "wyrd-ai": "link:../../../../sdks/wyrd-sdk-ts/wyrd"
  }
}
