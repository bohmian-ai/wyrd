{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wyrd.bifrost.capacity/v1",
  "title": "BifrostCapacityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "tree_clean", "dataset_digest", "workload_digest", "tier", "topology", "environment", "stages", "body"],
  "properties": {
    "schema_version": {"const": "wyrd.bifrost.capacity/v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "tree_clean": {"type": "boolean"},
    "dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tier": {"enum": ["smoke", "qualification", "scale"]},
    "topology": {"$ref": "#/$defs/topology"},
    "environment": {"$ref": "#/$defs/environment"},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "body": {"oneOf": [{"$ref": "#/$defs/ingest_body"}, {"$ref": "#/$defs/query_body"}, {"$ref": "#/$defs/distributed_body"}, {"$ref": "#/$defs/mixed_body"}]}
  },
  "$defs": {
    "topology": {"type": "object", "additionalProperties": false, "required": ["topology_id", "oracle_pods"], "properties": {"topology_id": {"type": "string"}, "oracle_pods": {"type": "integer", "minimum": 0}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory_bytes", "os", "storage_mode", "unavailable_reason"], "properties": {"cpu": {"type": ["string", "null"]}, "memory_bytes": {"type": ["integer", "null"]}, "os": {"type": "string"}, "storage_mode": {"type": "string"}, "unavailable_reason": {"type": ["string", "null"]}}},
    "window": {"type": "object", "additionalProperties": false, "required": ["window_id", "started_at_micros", "ended_at_micros"], "properties": {"window_id": {"type": "string", "minLength": 1}, "started_at_micros": {"type": "integer"}, "ended_at_micros": {"type": "integer"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["run_id", "ordinal", "capture_window", "observation_digests"], "properties": {"run_id": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 0}, "capture_window": {"$ref": "#/$defs/window"}, "observation_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}},
    "control": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["unit", "value", "max_in_flight"], "properties": {"unit": {"const": "qps"}, "value": {"type": "integer", "minimum": 0}, "max_in_flight": {"type": "integer", "minimum": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["unit", "value"], "properties": {"unit": {"enum": ["concurrency", "streams", "logical_bytes_per_sec", "returned_bytes_per_sec", "requests_per_sec"]}, "value": {"type": "integer", "minimum": 0}}}
    ]},
    "counts": {"type": "object", "additionalProperties": false, "required": ["operations", "rows", "bytes"], "properties": {"operations": {"type": "integer", "minimum": 0}, "rows": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}},
    "latency": {"type": "object", "additionalProperties": false, "required": ["admission", "queue", "planning", "ttfb", "execution", "total", "unavailable_reason"], "properties": {"admission": {"type": ["integer", "null"]}, "queue": {"type": ["integer", "null"]}, "planning": {"type": ["integer", "null"]}, "ttfb": {"type": ["integer", "null"]}, "execution": {"type": ["integer", "null"]}, "total": {"type": ["integer", "null"]}, "unavailable_reason": {"type": ["string", "null"]}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["cpu_seconds", "resident_bytes", "peak_query_memory_bytes", "spill_bytes", "network_bytes"], "properties": {"cpu_seconds": {"type": ["number", "null"]}, "resident_bytes": {"type": ["integer", "null"]}, "peak_query_memory_bytes": {"type": ["integer", "null"]}, "spill_bytes": {"type": ["integer", "null"]}, "network_bytes": {"type": ["integer", "null"]}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["backlog_records", "backlog_bytes", "lag_micros"], "properties": {"backlog_records": {"type": "integer", "minimum": 0}, "backlog_bytes": {"type": "integer", "minimum": 0}, "lag_micros": {"type": "integer", "minimum": 0}}},
    "correctness": {"oneOf": [{"const": "passed"}, {"type": "object", "additionalProperties": false, "required": ["failed"], "properties": {"failed": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string"}}}}}]},
    "saturation": {"type": ["string", "null"], "enum": ["controlled_admission", "latency", "resources", "driver", "correctness", null]},
    "replay": {"oneOf": [{"type": "null"}, {"const": "passed"}, {"type": "object", "additionalProperties": false, "required": ["failed"], "properties": {"failed": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string"}}}}}]},
    "stage": {"type": "object", "additionalProperties": false, "required": ["profile_id", "ordinal", "control", "offered", "admitted", "completed", "rejected", "failed", "latency", "logical_bytes", "physical_bytes", "unavailable_reason", "rows_returned", "bytes_returned", "resources", "audit", "fairness", "correctness", "healthy", "saturation", "recovery_replay", "stage_execution"], "properties": {"profile_id": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 0}, "control": {"$ref": "#/$defs/control"}, "offered": {"$ref": "#/$defs/counts"}, "admitted": {"$ref": "#/$defs/counts"}, "completed": {"$ref": "#/$defs/counts"}, "rejected": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "latency": {"$ref": "#/$defs/latency"}, "logical_bytes": {"type": "integer", "minimum": 0}, "physical_bytes": {"type": ["integer", "null"]}, "unavailable_reason": {"type": ["string", "null"]}, "rows_returned": {"type": "integer", "minimum": 0}, "bytes_returned": {"type": "integer", "minimum": 0}, "resources": {"$ref": "#/$defs/resources"}, "audit": {"$ref": "#/$defs/audit"}, "fairness": {"type": ["number", "null"]}, "correctness": {"$ref": "#/$defs/correctness"}, "healthy": {"type": "boolean"}, "saturation": {"$ref": "#/$defs/saturation"}, "recovery_replay": {"$ref": "#/$defs/replay"}, "stage_execution": {"$ref": "#/$defs/execution"}}},
    "recommended": {"type": "object", "additionalProperties": false, "required": ["ordinal", "controlling_value", "headroom_fraction", "saturation_ordinal", "saturation"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "controlling_value": {"type": "integer", "minimum": 0}, "headroom_fraction": {"type": "number"}, "saturation_ordinal": {"type": "integer", "minimum": 0}, "saturation": {"const": "controlled_admission"}}},
    "ingest_body": {"type": "object", "additionalProperties": false, "required": ["profile_id", "saturation_reached"], "properties": {"profile_id": {"type": "string"}, "saturation_reached": {"type": "boolean"}, "recommended": {"$ref": "#/$defs/recommended"}}, "allOf": [{"if": {"properties": {"saturation_reached": {"const": true}}, "required": ["saturation_reached"]}, "then": {"required": ["recommended"]}, "else": {"not": {"required": ["recommended"]}}}]},
    "query_body": {"type": "object", "additionalProperties": false, "required": ["query_id", "saturation_reached"], "properties": {"query_id": {"type": "string"}, "saturation_reached": {"type": "boolean"}, "recommended": {"$ref": "#/$defs/recommended"}}, "allOf": [{"if": {"properties": {"saturation_reached": {"const": true}}, "required": ["saturation_reached"]}, "then": {"required": ["recommended"]}, "else": {"not": {"required": ["recommended"]}}}]},
    "distributed_body": {"type": "object", "additionalProperties": false, "required": ["query_id", "oracle_pods", "throughput", "efficiency", "saturation_reached"], "properties": {"query_id": {"type": "string"}, "oracle_pods": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "throughput": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "efficiency": {"type": "array", "items": {"type": "number"}}, "saturation_reached": {"type": "boolean"}, "recommended": {"$ref": "#/$defs/recommended"}}, "allOf": [{"if": {"properties": {"saturation_reached": {"const": true}}, "required": ["saturation_reached"]}, "then": {"required": ["recommended"]}, "else": {"not": {"required": ["recommended"]}}}]},
    "mixed_body": {"type": "object", "additionalProperties": false, "required": ["fractions", "forge_debt_generations_per_tenant", "saturation_reached"], "properties": {"fractions": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false}}, "forge_debt_generations_per_tenant": {"type": "integer", "minimum": 0}, "saturation_reached": {"type": "boolean"}, "recommended": {"$ref": "#/$defs/recommended"}}, "allOf": [{"if": {"properties": {"saturation_reached": {"const": true}}, "required": ["saturation_reached"]}, "then": {"required": ["recommended"]}, "else": {"not": {"required": ["recommended"]}}}]}
  }
}
