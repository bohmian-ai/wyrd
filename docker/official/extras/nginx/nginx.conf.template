worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    sendfile on;
    tcp_nodelay on;
    keepalive_timeout 65;

    upstream wyrd_http {
        server ${WYRD_SERVER_BIND};
        keepalive 32;
    }

    upstream wyrd_ui {
        server 127.0.0.1:3000;
        keepalive 32;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' '';
    }

    # RFC 8628 section 5.1: limit attempts to verify the short device user
    # code, per client address this gateway observes. Only POST /auth/device
    # has a key; an empty key is never limited, so no other route shares the
    # zone. The zone is gateway shared memory, so backend replicas see one
    # budget.
    map "$request_method $uri" $device_verification_client {
        "POST /auth/device" $binary_remote_addr;
        default "";
    }
    limit_req_zone $device_verification_client zone=device_verification:10m rate=10r/m;
    limit_req_status 429;

    server {
        listen 8080;
        server_name _;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Rust owns these paths verbatim; nothing is rewritten. Bodies stream
        # through unbuffered so artifact uploads and MCP streams are not held
        # or size-capped here; the server enforces its own limits.
        location ~ ^/(v1|auth|platform|mcp)(/|$)|^/(openapi\.json|healthz|readyz)$ {
            proxy_pass http://wyrd_http;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            limit_req zone=device_verification burst=5 nodelay;
        }

        location / {
            proxy_pass http://wyrd_ui;
            proxy_set_header Connection "";
        }
    }

    server {
        listen 50051 http2;
        server_name _;

        location / {
            grpc_pass grpc://${WYRD_GRPC_BIND};
            client_max_body_size 0;
            grpc_read_timeout 1h;
            grpc_send_timeout 1h;
        }
    }
}
