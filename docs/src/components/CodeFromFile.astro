---
import { Code } from '@astrojs/starlight/components';

interface Props {
  /**
   * Path to the example file, relative to this component.
   * Example: "../../../examples/rust/workflow_with_observer.rs"
   */
  file: string;
  /** Language id for syntax highlighting, e.g. "rust", "python", "yaml". */
  lang: string;
  /** Title shown in the code block frame. Defaults to the file basename. */
  title?: string;
  /** Optional line range, e.g. "10-40" (1-based, inclusive). */
  range?: string;
}

const { file, lang, title, range } = Astro.props;

const files = import.meta.glob(
  [
    '../../../crates/**/*.rs',
    '../../../crates/**/*.yaml',
    '../../../examples/**/*.rs',
    '../../../examples/**/*.py',
    '../../../examples/**/*.yaml',
    '../../../python/**/*.py',
    '../../../python/**/*.yaml',
  ],
  {
    eager: true,
    import: 'default',
    query: '?raw',
  },
) as Record<string, string>;

let code = files[file];
if (code === undefined) {
  throw new Error(`CodeFromFile: file not found: ${file}`);
}

if (range) {
  const [startStr, endStr] = range.split('-');
  const start = Number.parseInt(startStr, 10);
  const end = Number.parseInt(endStr ?? startStr, 10);
  if (!Number.isFinite(start) || !Number.isFinite(end) || start < 1 || end < start) {
    throw new Error(`CodeFromFile: invalid range "${range}" for ${file}`);
  }
  const lines = code.split('\n');
  code = lines.slice(start - 1, end).join('\n');
}

const displayTitle = title ?? file.split('/').pop() ?? file;
---
<Code code={code} lang={lang} title={displayTitle} />
