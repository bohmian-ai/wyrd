---
// Brutalist SVG of the 7-primitive connection graph.
// Geometry: hard-shadowed boxes, 2.5px borders, 3px arrows.
// All colors flow through wyrd.css tokens so light/dark both work.
---

<svg
  class="wyrd-diagram"
  viewBox="0 0 720 460"
  role="img"
  aria-label="Wyrd primitives: Card, Spec, Run, Observation, Policy, Audit, Lineage"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <marker
      id="wyrd-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 Z" fill="var(--neo-shadow-color)" />
    </marker>
  </defs>

  <!-- Policy (top) -->
  <g transform="translate(300, 12)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">POLICY</text>
    <text class="node-sub" x="60" y="44">decides</text>
  </g>

  <!-- Card (center, accent) -->
  <g transform="translate(300, 192)">
    <rect class="node-shadow" x="6" y="6" width="120" height="64" />
    <rect class="node-fill-accent" x="0" y="0" width="120" height="64" />
    <rect class="node-stroke" x="0" y="0" width="120" height="64" />
    <text class="node-text node-text-on-accent" x="60" y="30">CARD</text>
    <text class="node-sub node-sub-on-accent" x="60" y="50">envelope</text>
  </g>

  <!-- Spec (left of Card) -->
  <g transform="translate(80, 196)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">SPEC</text>
    <text class="node-sub" x="60" y="44">typed payload</text>
  </g>

  <!-- Audit (right of Card) -->
  <g transform="translate(520, 196)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">AUDIT</text>
    <text class="node-sub" x="60" y="44">who or what</text>
  </g>

  <!-- Lineage (below Card) -->
  <g transform="translate(300, 304)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">LINEAGE</text>
    <text class="node-sub" x="60" y="44">graph</text>
  </g>

  <!-- Run (bottom-left) -->
  <g transform="translate(150, 396)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">RUN</text>
    <text class="node-sub" x="60" y="44">execution</text>
  </g>

  <!-- Observation (bottom-right) -->
  <g transform="translate(450, 396)">
    <rect class="node-shadow" x="6" y="6" width="120" height="56" />
    <rect class="node-fill" x="0" y="0" width="120" height="56" />
    <rect class="node-stroke" x="0" y="0" width="120" height="56" />
    <text class="node-text" x="60" y="26">OBSERVATION</text>
    <text class="node-sub" x="60" y="44">behavior</text>
  </g>

  <!-- Arrows -->
  <!-- Policy -> Card (evaluates) -->
  <path class="arrow" d="M 360 70 L 360 190" />
  <text class="arrow-label" x="368" y="132">evaluates</text>

  <!-- Spec <- Card (typed payload) -->
  <path class="arrow" d="M 296 224 L 204 224" />
  <text class="arrow-label" x="210" y="216">typed</text>

  <!-- Card -> Audit (decision record) -->
  <path class="arrow" d="M 424 224 L 516 224" />
  <text class="arrow-label" x="430" y="216">records</text>

  <!-- Card -> Lineage (references) -->
  <path class="arrow" d="M 360 258 L 360 302" />
  <text class="arrow-label" x="368" y="284">refs</text>

  <!-- Lineage -> Run -->
  <path class="arrow" d="M 320 362 L 232 394" />
  <text class="arrow-label" x="240" y="380">ties</text>

  <!-- Run -> Observation -->
  <path class="arrow" d="M 274 424 L 446 424" />
  <text class="arrow-label" x="320" y="416">emits</text>

  <!-- Lineage -> Observation -->
  <path class="arrow" d="M 400 362 L 508 394" />
</svg>
