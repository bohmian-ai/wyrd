@@ -0,0 +1,292 @@
+"""Send a bounded batch of real requests to the running support API, wait for
+every queued verdict, and check Wyrd retained what the app sent.
+
+    uv run python -m scripts.batch --requests 20 --concurrency 2
+
+The batch mixes four cases in fixed proportions:
+
+| Case       | Share | Request                         | Expected                          |
+| ---------- | ----- | ------------------------------- | --------------------------------- |
+| `shipping` | 80 %  | `POST /ask` about shipping      | 200, verify passed, one execution |
+| `refund`   | 10 %  | `POST /ask` about a refund      | 200, verify failed, one execution |
+| `openapi`  | 5 %   | `GET /openapi.json`             | 200, HTTP spans only, no Run      |
+| `unknown`  | 5 %   | `POST /ask` for order `Z-9`     | 404 before any Run or model call  |
+
+Rounding goes to `shipping`, so exactly ``--requests`` calls are sent, never
+retried. The app starts each call's trace and names it in the response's W3C
+``traceresponse`` header; every retained span, log, model call, and verdict is
+matched to the call it belongs to, so other traffic can never stand in for it.
+The report is JSON on stdout; any unexpected reply, missing verdict, or missing
+telemetry exits 1.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import random
+import sys
+import time
+from collections import Counter
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+import httpx
+from wyrd import verify
+from wyrd.bifrost import Bifrost
+from wyrd.client import WyrdClient
+
+SHARES = {"refund": 10, "openapi": 5, "unknown": 5}
+ORDER_IDS = ("A-1001", "A-1002", "A-1003")
+METRICS = ("support_desk.asks", "support_desk.ask.duration", "support_desk.asks.in_flight")
+
+
+def plan(requests: int) -> list[str]:
+    """The cases of one batch, in a fixed shuffled order."""
+    counts = {case: requests * share // 100 for case, share in SHARES.items()}
+    counts["shipping"] = requests - sum(counts.values())
+    cases = [case for case, n in counts.items() for _ in range(n)]
+    random.Random(requests).shuffle(cases)
+    return cases
+
+
+@dataclass
+class Call:
+    """One workload request and what it returned."""
+
+    case: str
+    status: int = 0
+    trace_id: str | None = None
+    span_id: str | None = None
+    request_id: str | None = None
+    verdict: str | None = None
+    execution_id: str | None = None
+    queued_verdict: str | None = None
+    problems: list[str] = field(default_factory=list)
+
+
+def request(case: str, index: int) -> tuple[str, str, dict[str, Any] | None]:
+    order = ORDER_IDS[index % len(ORDER_IDS)]
+    if case == "shipping":
+        return "POST", "/ask", {"question": "When will my order ship?", "order_id": order}
+    if case == "refund":
+        return "POST", "/ask", {"question": "Can I get a refund for it?", "order_id": order}
+    if case == "unknown":
+        return "POST", "/ask", {"question": "Where is it?", "order_id": "Z-9"}
+    return "GET", "/openapi.json", None
+
+
+async def send(http: httpx.AsyncClient, gate: asyncio.Semaphore, case: str, index: int) -> Call:
+    call = Call(case)
+    method, path, body = request(case, index)
+    async with gate:
+        try:
+            response = await http.request(method, path, json=body)
+        except httpx.HTTPError as error:
+            call.problems.append(f"{type(error).__name__}: {error}")
+            return call
+    call.status = response.status_code
+    # `traceresponse: 00-<trace id>-<server span id>-<flags>`
+    parts = response.headers.get("traceresponse", "").split("-")
+    if len(parts) == 4:
+        call.trace_id, call.span_id = parts[1], parts[2]
+    else:
+        call.problems.append("no traceresponse header")
+    want = 404 if case == "unknown" else 200
+    if call.status != want:
+        call.problems.append(f"HTTP {call.status}, want {want}: {response.text[:200]}")
+    elif path == "/ask" and want == 200:
+        reply = response.json()
+        call.request_id = reply["request_id"]
+        call.verdict = reply["verify"]["verdict"]
+        call.execution_id = reply["submit"]["execution_id"]
+        expected = "passed" if case == "shipping" else "failed"
+        if call.verdict != expected:
+            call.problems.append(f"immediate verdict {call.verdict}, want {expected}")
+    return call
+
+
+def settle(call: Call, timeout: float, client: WyrdClient | None) -> None:
+    """Wait for the call's queued verdict through the public execution API."""
+    if call.execution_id is None:
+        return
+    try:
+        result = verify.Execution.connect(call.execution_id, client).wait(timeout)
+    except Exception as error:  # report every failed wait, keep settling the rest
+        call.problems.append(f"queued execution: {error}")
+        return
+    call.queued_verdict = result.verdict
+    if result.verdict != "passed":
+        call.problems.append(f"queued verdict {result.verdict}, want passed")
+
+
+def counts(bifrost: Bifrost, sql: str, since_ns: int) -> dict[str, int]:
+    rows = bifrost.sql(sql, [since_ns]).to_arrow().to_pylist()
+    return {row["k"]: row["n"] for row in rows if row["k"] is not None}
+
+
+SPANS = """SELECT encode(trace_id, 'hex') AS k, count(*) AS n FROM bifrost.traces.spans
+WHERE start_time_unix_nano >= to_timestamp_nanos($1) GROUP BY 1"""
+# Root spans by span id: each call's HTTP server span must be one.
+ROOTS = """SELECT encode(span_id, 'hex') AS k, count(*) AS n FROM bifrost.traces.spans
+WHERE start_time_unix_nano >= to_timestamp_nanos($1) AND parent_span_id IS NULL GROUP BY 1"""
+LOGS = """SELECT encode(trace_id, 'hex') AS k, count(*) AS n FROM bifrost.logs.records
+WHERE time_unix_nano >= to_timestamp_nanos($1) GROUP BY 1"""
+POINTS = """SELECT metric_name AS k, count(*) AS n FROM bifrost.metrics.points
+WHERE time_unix_nano >= to_timestamp_nanos($1) GROUP BY 1"""
+# The judge's gateway calls carry the Run they judge.
+CALLS = """SELECT run_id AS k, count(*) AS n FROM bifrost.gateway.calls
+WHERE started_at >= to_timestamp_nanos($1) AND requested_model['model'] NOT LIKE '%gpt-6-luna'
+GROUP BY 1"""
+JUDGE = """SELECT run_id AS k, count(*) AS n FROM bifrost.gateway.calls
+WHERE started_at >= to_timestamp_nanos($1) AND requested_model['model'] LIKE '%gpt-6-luna'
+GROUP BY 1"""
+RESULTS = """SELECT run_id AS k, count(*) AS n FROM bifrost.verification.results
+WHERE started_at >= to_timestamp_nanos($1) GROUP BY 1"""
+
+
+def readback(since_ns: int, client: WyrdClient | None) -> dict[str, dict[str, int]]:
+    """What Wyrd retained since the batch started, keyed by trace, span, metric or Run ID.
+
+    Other traffic is retained too; only `missing` decides which rows belong to the batch.
+    """
+    bifrost = Bifrost(client=client)
+    queries = {"spans": SPANS, "roots": ROOTS, "logs": LOGS, "points": POINTS}
+    queries |= {"app_calls": CALLS, "judge_calls": JUDGE, "results": RESULTS}
+    return {name: counts(bifrost, sql, since_ns) for name, sql in queries.items()}
+
+
+def retained(calls: list[Call], evidence: dict[str, dict[str, int]]) -> dict[str, Any]:
+    """Totals of the batch's own evidence: rows of other traces and Runs are not counted."""
+    traces = [c.trace_id for c in calls if c.trace_id]
+    asks = [c.trace_id for c in calls if c.trace_id and c.case != "openapi"]
+    runs = [c.request_id for c in calls if c.request_id]
+    return {
+        "traces_with_spans": sum(t in evidence["spans"] for t in traces),
+        "spans": sum(evidence["spans"].get(t, 0) for t in traces),
+        "root_spans": sum(c.span_id in evidence["roots"] for c in calls if c.span_id),
+        "asks_with_logs": sum(t in evidence["logs"] for t in asks),
+        "logs": sum(evidence["logs"].get(t, 0) for t in asks),
+        # Points are observations of the batch's time window, never one per request.
+        "metric_points": evidence["points"],
+        "app_model_calls": sum(evidence["app_calls"].get(r, 0) for r in runs),
+        "judge_model_calls": sum(evidence["judge_calls"].get(r, 0) for r in runs),
+        "runs_with_two_verdicts": sum(evidence["results"].get(r, 0) >= 2 for r in runs),
+    }
+
+
+def missing(calls: list[Call], evidence: dict[str, dict[str, int]]) -> list[str]:
+    """Each expected observation of each call that has not been retained yet."""
+    gaps = []
+    for i, c in enumerate(calls):
+        name = f"{c.case} #{i} trace {c.trace_id}"
+        if c.trace_id is None:
+            continue  # its send already reported the missing traceresponse
+        if c.trace_id not in evidence["spans"]:
+            gaps.append(f"{name}: no spans")
+        elif c.span_id not in evidence["roots"]:
+            gaps.append(f"{name}: HTTP server span {c.span_id} is not a retained root")
+        if c.case != "openapi" and c.trace_id not in evidence["logs"]:
+            gaps.append(f"{name}: no log records")
+        if c.request_id is None:
+            continue
+        run = f"{c.case} #{i} Run {c.request_id}"
+        if evidence["app_calls"].get(c.request_id, 0) < 2:
+            gaps.append(f"{run}: {evidence['app_calls'].get(c.request_id, 0)} of 2 app model calls")
+        if evidence["judge_calls"].get(c.request_id, 0) < 1:
+            gaps.append(f"{run}: no judge model call")
+        if evidence["results"].get(c.request_id, 0) < 2:
+            gaps.append(f"{run}: {evidence['results'].get(c.request_id, 0)} of 2 verdicts")
+    absent = [m for m in METRICS if not evidence["points"].get(m)]
+    if any(c.request_id for c in calls) and absent:
+        gaps.append(f"no points for {', '.join(absent)}")
+    return gaps
+
+
+async def dispatch(base_url: str, cases: list[str], concurrency: int) -> list[Call]:
+    gate = asyncio.Semaphore(concurrency)
+    timeout = httpx.Timeout(120)
+    async with httpx.AsyncClient(base_url=base_url, timeout=timeout) as http:
+        return await asyncio.gather(*(send(http, gate, c, i) for i, c in enumerate(cases)))
+
+
+async def wait_all(calls: list[Call], concurrency: int, timeout: float, client: Any) -> None:
+    gate = asyncio.Semaphore(concurrency)
+
+    async def one(call: Call) -> None:
+        async with gate:
+            await asyncio.to_thread(settle, call, timeout, client)
+
+    await asyncio.gather(*(one(call) for call in calls))
+
+
+def run_batch(
+    base_url: str,
+    requests: int,
+    concurrency: int,
+    *,
+    timeout: float = 300,
+    client: WyrdClient | None = None,
+) -> dict[str, Any]:
+    """Send one batch and return its report; ``report["ok"]`` is the verdict."""
+    if requests < 1 or concurrency < 1:
+        raise ValueError("--requests and --concurrency must be at least 1")
+    since_ns = time.time_ns()
+    started = time.monotonic()
+    calls = asyncio.run(dispatch(base_url, plan(requests), concurrency))
+    asyncio.run(wait_all(calls, concurrency, timeout, client))
+    settled = time.monotonic()
+    deadline = settled + timeout
+    while True:
+        evidence = readback(since_ns, client)
+        gaps = missing(calls, evidence)
+        if not gaps or time.monotonic() >= deadline:
+            break
+        time.sleep(2)
+    totals = retained(calls, evidence)
+    problems = [f"{c.case} #{i}: {p}" for i, c in enumerate(calls) for p in c.problems]
+    runs = sum(c.request_id is not None for c in calls)
+    return {
+        "ok": not problems and not gaps,
+        "requested": requests,
+        "dispatched": len(calls),
+        "concurrency": concurrency,
+        "cases": dict(Counter(c.case for c in calls)),
+        "http_status": {str(k): v for k, v in Counter(c.status for c in calls).items()},
+        "runs": runs,
+        "immediate_verdicts": dict(Counter(c.verdict for c in calls if c.verdict)),
+        "queued_verdicts": dict(Counter(c.queued_verdict for c in calls if c.queued_verdict)),
+        "expected": {"app_model_calls": 2 * runs, "judge_model_calls": runs},
+        "retained": totals,
+        # Gateway attempts beyond the logical flow are retries, reported, never hidden.
+        "retries": {
+            "app_model_calls": max(0, totals["app_model_calls"] - 2 * runs),
+            "judge_model_calls": max(0, totals["judge_model_calls"] - runs),
+        },
+        "missing": gaps[:50],
+        "missing_count": len(gaps),
+        "problems": problems[:50],
+        "problem_count": len(problems),
+        "seconds": {
+            "requests": round(settled - started, 1),
+            "total": round(time.monotonic() - started, 1),
+        },
+        "calls": [asdict(c) for c in calls] if requests <= 50 else None,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    parser.add_argument("--base-url", default="http://127.0.0.1:8000")
+    parser.add_argument("--requests", type=int, default=3000)
+    parser.add_argument("--concurrency", type=int, default=8)
+    parser.add_argument("--timeout", type=float, default=300, help="seconds per wait phase")
+    args = parser.parse_args()
+    report = run_batch(args.base_url, args.requests, args.concurrency, timeout=args.timeout)
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if report["ok"] else 1)
+
+
+if __name__ == "__main__":
+    main()
