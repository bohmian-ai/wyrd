index 0000000..af0c455
--- /dev/null
+++ b/test/test_dev_workload.py
@@ -0,0 +1,166 @@
+"""The workload batch against the API served by uvicorn, as in development."""
+
+from __future__ import annotations
+
+import os
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Iterator
+
+import httpx
+import pytest
+from wyrd.bifrost import Bifrost
+from wyrd.testing import WyrdTestServer
+
+from scripts.batch import Call, missing, plan, readback, retained, run_batch
+from src.desk import ROOT
+
+
+def test_plan_keeps_the_proportions_and_the_total() -> None:
+    assert {case: plan(3000).count(case) for case in set(plan(3000))} == {
+        "shipping": 2400,
+        "refund": 300,
+        "openapi": 150,
+        "unknown": 150,
+    }
+    small = plan(20)
+    assert len(small) == 20
+    assert {case: small.count(case) for case in set(small)} == {
+        "shipping": 16,
+        "refund": 2,
+        "openapi": 1,
+        "unknown": 1,
+    }
+    assert plan(3) == ["shipping"] * 3
+
+
+@pytest.fixture
+def served(deployed: WyrdTestServer) -> Iterator[tuple[str, subprocess.Popen[bytes]]]:
+    """The API in its own process, with its own telemetry providers."""
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+    env = {**os.environ, "OTEL_METRIC_EXPORT_INTERVAL": "1000"}
+    command = [sys.executable, "-m", "uvicorn", "src.app:app", "--port", str(port)]
+    app = subprocess.Popen(command, cwd=ROOT, env=env)
+    url = f"http://127.0.0.1:{port}"
+    try:
+        deadline = time.monotonic() + 60
+        while True:
+            try:
+                httpx.get(f"{url}/docs").raise_for_status()
+                break
+            except httpx.HTTPError:
+                assert app.poll() is None and time.monotonic() < deadline, "the API did not start"
+                time.sleep(0.5)
+        yield url, app
+    finally:
+        if app.poll() is None:
+            app.kill()
+
+
+@pytest.fixture
+def publishing(deployed: WyrdTestServer) -> Iterator[None]:
+    """Publish Bifrost every second, as a deployed server does on its own."""
+    stop = threading.Event()
+
+    def publish() -> None:
+        while not stop.wait(1):
+            deployed.flush_bifrost()
+
+    worker = threading.Thread(target=publish, daemon=True)
+    worker.start()
+    yield
+    stop.set()
+    worker.join()
+
+
+def test_batch_reports_all_outcomes_and_retained_signals(
+    served: tuple[str, subprocess.Popen[bytes]], publishing: None
+) -> None:
+    url, app = served
+    since = time.time_ns()
+    # Other traffic on the same app while the batch runs: it is retained, never counted for the batch.
+    stray: list[tuple[str, str]] = []
+    done = threading.Event()
+
+    def unrelated() -> None:
+        while not done.is_set():
+            for method, body in (("GET", None), ("POST", {"question": "Where is it?", "order_id": "Z-9"})):
+                path = "/openapi.json" if body is None else "/ask"
+                response = httpx.request(method, f"{url}{path}", json=body)
+                stray.append((path, response.headers["traceresponse"].split("-")[1]))
+            done.wait(0.5)
+
+    traffic = threading.Thread(target=unrelated, daemon=True)
+    traffic.start()
+    try:
+        report = run_batch(url, 20, 2, timeout=120)
+    finally:
+        done.set()
+        traffic.join()
+
+    assert report["ok"], report
+    assert report["dispatched"] == 20
+    assert report["cases"] == {"shipping": 16, "refund": 2, "openapi": 1, "unknown": 1}
+    assert report["http_status"] == {"200": 19, "404": 1}
+    assert report["runs"] == 18
+    assert report["immediate_verdicts"] == {"passed": 16, "failed": 2}
+    assert report["queued_verdicts"] == {"passed": 18}
+    totals = report["retained"]
+    # Read while the API is still running: every signal was exported in batches.
+    assert app.poll() is None
+    assert totals["traces_with_spans"] == 20 and totals["root_spans"] == 20
+    assert totals["asks_with_logs"] == 19
+    assert totals["app_model_calls"] == 36 and totals["judge_model_calls"] == 18
+    assert {"support_desk.asks", "support_desk.ask.duration", "support_desk.asks.in_flight"} <= set(
+        totals["metric_points"]
+    )
+    unknown = next(c for c in report["calls"] if c["case"] == "unknown")
+    assert unknown["status"] == 404 and unknown["request_id"] is None
+    calls = [Call(**c) for c in report["calls"]]
+    assert all(c.trace_id and c.span_id for c in calls)
+
+    # Unrelated traffic was retained, yet one workload request's missing evidence is still named.
+    def landed(evidence: dict[str, dict[str, int]]) -> bool:
+        spans = all(trace in evidence["spans"] for _, trace in stray)
+        return spans and all(trace in evidence["logs"] for path, trace in stray if path == "/ask")
+
+    deadline = time.monotonic() + 60
+    while not landed(evidence := readback(since, None)):
+        assert time.monotonic() < deadline, "the unrelated traffic was not retained"
+        time.sleep(1)
+    assert stray
+    assert missing(calls, evidence) == []
+    shipping = next(i for i, c in enumerate(calls) if c.case == "shipping")
+    lost = calls[shipping]
+    for table in ("spans", "logs"):
+        del evidence[table][lost.trace_id]
+    del evidence["judge_calls"][lost.request_id]
+    assert missing(calls, evidence) == [
+        f"shipping #{shipping} trace {lost.trace_id}: no spans",
+        f"shipping #{shipping} trace {lost.trace_id}: no log records",
+        f"shipping #{shipping} Run {lost.request_id}: no judge model call",
+    ]
+    assert retained(calls, evidence)["traces_with_spans"] == 19
+
+    # A graceful stop drains what the API logged on its way out.
+    stopping = time.time_ns()
+    app.send_signal(signal.SIGTERM)
+    # uvicorn re-raises the signal once its lifespan shutdown completes.
+    assert app.wait(60) in (0, -signal.SIGTERM)
+    deadline = time.monotonic() + 60
+    while True:
+        rows = Bifrost().sql(
+            "SELECT count(*) AS n FROM bifrost.logs.records "
+            "WHERE time_unix_nano >= to_timestamp_nanos($1)",
+            [stopping],
+        )
+        if rows.to_arrow().to_pylist()[0]["n"] >= 1:
+            break
+        assert time.monotonic() < deadline, "the shutdown log was not drained"
+        time.sleep(1)
