{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    // card-types.ts and error-codes.ts are generated by `mise run codegen:regen`.
    "includes": ["wyrd/src/**", "wyrd/tests/**", "!wyrd/src/card-types.ts", "!wyrd/src/error-codes.ts"]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "assist": { "enabled": false },
  "overrides": [
    {
      "includes": ["wyrd/tests/**"],
      "linter": {
        "rules": {
          // Vitest reads a fixture's dependencies from its first parameter's destructuring pattern;
          // `({}, use)` is the documented form for a fixture that depends on nothing.
          "correctness": { "noEmptyPattern": "off" },
          // A Vitest fixture that only runs setup is typed `void` so its body can call `use()` with no value.
          "suspicious": { "noConfusingVoidType": "off" }
        }
      }
    }
  ]
}
