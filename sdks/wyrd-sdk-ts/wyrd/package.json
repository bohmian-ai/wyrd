{
  "name": "wyrd-ai",
  "version": "0.2.0",
  "description": "TypeScript SDK for Wyrd: verification and assurance for AI systems.",
  "keywords": [
    "wyrd",
    "ai",
    "verification",
    "evaluation",
    "llm",
    "agents",
    "observability",
    "assurance"
  ],
  "homepage": "https://github.com/bohmian-ai/wyrd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bohmian-ai/wyrd.git",
    "directory": "sdks/wyrd-sdk-ts/wyrd"
  },
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wyrd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    }
  },
  "napi": {
    "binaryName": "wyrd",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "optionalDependencies": {
    "wyrd-ai-darwin-arm64": "0.2.0",
    "wyrd-ai-linux-arm64-gnu": "0.2.0",
    "wyrd-ai-linux-x64-gnu": "0.2.0"
  },
  "dependencies": {
    "apache-arrow": "21.1.0"
  },
  "peerDependencies": {
    "@openai/agents-core": "^0.20.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@openai/agents-core": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/context-async-hooks": {
      "optional": true
    },
    "@opentelemetry/core": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  }
}
