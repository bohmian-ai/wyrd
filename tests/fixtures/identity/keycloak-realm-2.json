{
  "id": "wyrd-test-2",
  "realm": "wyrd-test-2",
  "enabled": true,
  "displayName": "Wyrd Test (second provider)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "groups": [
    {
      "id": "r2-grp-wyrd-admins",
      "name": "wyrd-admins",
      "path": "/wyrd-admins",
      "subGroups": []
    }
  ],
  "clients": [
    {
      "id": "r2-wyrd-human-client",
      "clientId": "wyrd-human",
      "name": "Wyrd Human Login",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*",
        "http://test-tenant-1.wyrd.test/auth/callback"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "id": "r2-wyrd-human-audience-mapper",
          "name": "wyrd-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wyrd-human",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "id": "r2-wyrd-human-groups-mapper",
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "id": "r2-wyrd-workload-client",
      "clientId": "wyrd-workload",
      "name": "Wyrd Workload (second provider)",
      "enabled": true,
      "publicClient": false,
      "secret": "wyrd-workload-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "id": "r2-wyrd-workload-aud-mapper",
          "name": "wyrd-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wyrd-workload",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "profile",
      "description": "OpenID Connect profile scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "email",
      "description": "OpenID Connect email scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "offline_access",
      "description": "OpenID Connect offline access scope",
      "protocol": "openid-connect",
      "attributes": {
        "consent.screen.text": "${offlineAccessScopeConsentText}",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email"
  ],
  "defaultOptionalClientScopes": [
    "offline_access"
  ]
}
